# F1 Flash-Next sidecar PREFILL delta (2026-10-21), to be added on top of
# harness/o4_recipe.env (O4 decode recipe). reports/2F1_prefill.md.
# Measured on the O4 f4 base (p7): 8K 2434 tok/s, 12288 2511, 32K 2342,
# 128K 1587 input tok/s; decode unchanged. Serve args that go with it:
#   --max-num-batched-tokens 12288 (the chunk; B70_EP_PREFILL_MAX_T must match)
#   --max-model-len 131072 (or larger; KV budget allows 2.69x 147K)
# Every flag is opt-in and default off.
B70_EP_PREFILL=1                 # T > 8 MoE calls take the two-card prefill path (b70_ep_xpu/prefill_ep.py)
B70_EP_PREFILL_MAX_T=12288       # exchange regions sized for the chunk (inbox 63 MB on card 1, psum 126 MB on card 0)
B70_EP_PREFILL_RET=bf16          # card 1 returns its partial sum as bf16 (gates and 32K coherence exact)
B70_EP_PREFILL_C0=auto:64        # card 0: fused DPAS kernel below B70_PREFILL_DQ_T, native bucketed op (tile 64) above
B70_EP_PREFILL_C1=native:32      # card 1: native bucketed dequant+bmm op, 32-expert tiles (b70_gguf_xpu/csrc/bucket_moe.cpp)
B70_EP_PREFILL_C1_MAXPAD=32768   # card 1 padded-row cap per chunk (1.19 GiB free beside 29.2 GiB of experts)
B70_PREFILL=1                    # X3: dense trunk + card-0 expert prefill dispatch (not the decode GEMV)
B70_PREFILL_WIDE_SO=/mnt/vm_8tb/b70/build/vllm-flashnext/f1/_C.f1bucket.so   # C13 wide dequant + prefill_moe_bucketed (sha 790230cb), additive to B70_GGUF_SO
B70_PREFILL_DQ_T=8192            # dequant+bmm expert path at T >= 8192 (X3)
B70_PREFILL_MAX_PAD_ROWS=65536   # card-0 padded-row cap (X3)
B70_PREFILL_BUCKET=1             # card-0 power-of-two row buckets (X3)
B70_PREFILL_EXPERT_TILE=64       # card-0 tile for the Python bucket path below the native threshold
B70_PREFILL_REDUCE=grouped       # X3 grouped Triton pad/combine
B70_PREFILL_DQ_OVERLAP=0         # X3: no side-stream dequant overlap (saves nothing, costs scratch)
B70_PREFILL_HC=triton            # X3 fused HC mix/combine for T > 8
B70_PREFILL_PLE_HASH=numpy       # X3 host PLE hash for T > 8 (host-stage path only; harmless with B70_PLE_DEVICE)
# B70_EP_SO must carry both O4's moe_ep.cpp state and F1's prefill_ep.cpp:
# built from the shared csrc tree by f1/build_ep.sh -> f1/b70_ep_C.f1c.so.
B70_EP_SO=/mnt/vm_8tb/b70/build/vllm-flashnext/f1/b70_ep_C.f1c.so   # overrides o4_recipe.env's o4c.so: same csrc tree (O4 moe_ep.cpp + F1 prefill_ep.cpp)
