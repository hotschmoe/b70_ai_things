# O4 Flash-Next sidecar no-MTP decode recipe (2026-10-21). Served as s4:
# C1 ITL p50 15.25 ms, C2 19.62 ms/stream (o4/serve-s4); in-process f13
# C1 step 15.24 ms. reports/2O4_flashnext_decode.md.
# Optional (f14, -0.02 ms in-process, same tokens): B70_DECODE_HC_FUSE=1 and
# B70_EP_SO=/mnt/vm_8tb/b70/build/vllm-flashnext/o4/b70_ep_C.o4d.so.
# B70_DECODE_HC_Q8=1 is a numerics change (Q8_0-rounded HC weights, as
# Strata STRATA_NIGHT_HC=q8); drop it for the bf16-exact path (+0.6 ms).
# Use with harness/o4_window.sh (in-process profiler) or
# harness/o4_serve.sh (HTTP server). Each flag is opt-in and default off
# in the fork/plugins; all of them are needed for the numbers above.
B70_MTP_RT=/mnt/vm_8tb/b70/build/strata-ab/mtp-bf16/rt   # X1 PLE ring (no MTP unless --speculative-config)
B70_PLE_DEVICE=1          # PLE hash/gather/history in the graph (pinned host-USM table), no host sync
B70_DECODE_HC=triton      # fused hyper-connection mix/combine (xpu/hc_decode.py), T <= 8
B70_DECODE_HC_GEMV=1      # split-K bf16 GEMV for the HC down|inject GEMM (plugins/b70_o4_xpu)
B70_DECODE_LEAN=1         # drop the dead per-layer residual mean
B70_GEMV_BF16=1           # GGUF linear shards written straight to one bf16 output (needs O4 GGUF lib)
B70_EP_SHARED_OVERLAP=1   # shared expert between moe_ep_begin/end for T > 8
B70_EP_FUSE_SHARED=1      # card-0 routed + gated shared expert in one b70_moe_layer2 call (T <= 8)
B70_EP_BF16_OUT=1         # EP card-0 + card-1 sum written as bf16 (needs b70_ep_C.o4c.so)
B70_DECODE_TOPK=1         # Triton softmax top-k for T <= 8 (xpu/topk_decode.py)
B70_LINEAR_CAT=1          # GDN b|a as one GEMM
B70_DENSE_GEMV=1          # small-M bf16 dense linears (router, b|a) via b70_o4.bf_gemv
B70_DECODE_HC_Q8=1        # HC GEMVs on int8 Q8_0 copies (b70_o4.w8_gemv); numerics change
B70_PLE_FUSED=1           # PLE tail (norms, gate, conv ring, adds) as 2 Triton kernels, T <= 8
B70_IQ3S_ROW=1            # IQ3_S dense shards on the row kernel (bitwise equal, ~2x faster)
B70_EP_SO=/mnt/vm_8tb/b70/build/vllm-flashnext/o4/b70_ep_C.o4c.so
B70_GGUF_SO=/mnt/vm_8tb/b70/build/vllm-flashnext/o4/_C.o4g.so
# Sidecar base (as H1e): B70_GGUF=1 B70_EP=1 B70_QSA=0 B70_EP_SPLIT=profile B70_EP_Q0=138
# B70_XPU_CG_RECLAIM=500, FULL_DECODE_ONLY capture 1,2,3,4,8, FLASH_ATTN,
# --no-enable-prefix-caching --mamba-cache-mode align (required by the ring).
# PYTHONPATH adds plugins/b70_o4_xpu. Do NOT also set B70_PLE_MLOCK or
# B70_PLE_FAST with B70_PLE_DEVICE (they serve the host-stage path).
