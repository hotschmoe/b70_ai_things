+    def get_top_tokens(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        """Greedy draft token (speculative_config use_local_argmax_reduction).
+
+        B70_MTP_DRAFT_VOCAB=<int32 id file> (Strata draft_vocab_en.bin)
+        evaluates only those head rows and maps the argmax back. Drafts
+        only: the target still verifies against its full-vocab head.
+        """
+        sub = getattr(self, "_b70_draft_head", None)
+        if sub is None:
+            sub = self._build_draft_head(hidden_states.device)
+        if sub is False:
+            return self.compute_logits(hidden_states).argmax(dim=-1)
+        packed, qtype, n, ids = sub
+        if packed is None:
+            logits = torch.nn.functional.linear(hidden_states, qtype)
+        else:
+            from vllm.models.qwen4_exp.gguf.ops_interface import linear as linear_op
+
+            logits = linear_op(hidden_states, packed, qtype, n)
+        return ids[logits.argmax(dim=-1)]
+
+    def _build_draft_head(self, device: torch.device):
+        path = os.environ.get("B70_MTP_DRAFT_VOCAB", "")
+        if not path:
+            self._b70_draft_head = False
+            return False
+        if torch.xpu.is_current_stream_capturing():
+            raise RuntimeError("b70 draft head must be built before graph capture")
+        import numpy as np
+
+        ids_np = np.fromfile(path, dtype=np.int32)
+        ids = torch.from_numpy(ids_np.astype(np.int64)).to(device)
+        head = self.lm_head
+        packed = getattr(head, "b70_packed", None)
+        if packed is not None:
+            rows = int(head.b70_num_rows)
+            sub = packed.reshape(rows, -1).index_select(0, ids).contiguous()
+            self._b70_draft_head = (sub, int(head.b70_qtype), int(ids.numel()), ids)
+        else:
+            w = head.weight.index_select(0, ids).contiguous()
+            self._b70_draft_head = (None, w, int(ids.numel()), ids)
+        logger.info(
+            "b70 MTP draft head: %d of %d vocab rows from %s (%s)",
+            ids.numel(), self.config.vocab_size, path,
+            "packed" if packed is not None else "dense",
+        )
+        return self._b70_draft_head
+
