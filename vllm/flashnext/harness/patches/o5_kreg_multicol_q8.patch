+// O5: Q8_0 through KREG. Lane g of a 256-value group owns Q8_0 block g
+// (34 bytes: fp16 d + 32 int8); the dot is the IQ4_XS form.
+inline B70W4X b70_load_q8_0(const uint8_t* b, int g) {
+    const uint8_t* blk = b + 34 * g;
+    B70W4X r{};
+    r.d = b70_fp16_to_fp32((uint16_t)b70_ld16(blk));
+    r.lo = b70_ld16_a2(blk + 2);
+    r.hi = b70_ld16_a2(blk + 18);
+    return r;
+}
+
 inline float b70_dot_iq4xs(const B70W4X& r, const B70Act& a) {
     return r.d * a.d0 * (float)b70_dp4a4(r.hi, a.u1, b70_dp4a4(r.lo, a.u0, 0));
 }
