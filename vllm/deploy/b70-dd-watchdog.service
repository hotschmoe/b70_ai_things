[Unit]
# RETIRED 2026-08-05 -- do NOT enable.
# Content-probe watchdog for the old DP=2 int4/NVFP4 daily driver. Soft "!!!!" self-heal is
# no longer part of the stack; bin/dd-watchdog defaults to exit 0 unless DD_WATCHDOG_FORCE=1.
# Kept as a unit file for history/forensics only.
Description=B70 daily-driver watchdog RETIRED (do not enable)
After=docker.service network-online.target mnt-vm_8tb.mount
Wants=network-online.target

[Service]
Type=simple
User=hotschmoe
Group=hotschmoe
WorkingDirectory=/mnt/vm_8tb/github/b70_ai_things
# Default binary exits 0 immediately (retired). Force only for forensics.
Environment=DD_WATCHDOG_FORCE=0
ExecStart=/usr/bin/python3 /mnt/vm_8tb/github/b70_ai_things/bin/dd-watchdog
# Do not auto-restart a retired no-op.
Restart=no

[Install]
WantedBy=multi-user.target
