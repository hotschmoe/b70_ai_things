+// Sampled device timing for the standard quantized MUL_MAT callbacks. A sample
+// adds two profiling barriers on the callback's existing in-order queue but no
+// host wait. Timestamps are read only at process exit after graceful teardown.
+// GGML_SYCL_QUANT_TIMING_SAMPLE=N samples each key about once every N calls;
+// zero or unset is fully disabled. This is evidence instrumentation, never a
+// throughput arm.
+struct sycl_quant_timing_token {
+    sycl_quant_actual_key key;
+    sycl::event start;
+};
+
+struct sycl_quant_timing_sample {
+    sycl_quant_actual_key key;
+    sycl::event start;
+    sycl::event end;
+};
+
+struct sycl_quant_timing_stats {
+    uint64_t calls_seen = 0;
+    uint64_t samples = 0;
+    uint64_t device_ns = 0;
+    uint64_t barrier_ns = 0;
+    uint64_t min_ns = UINT64_MAX;
+    uint64_t max_ns = 0;
+    uint64_t incomplete = 0;
+    uint64_t invalid = 0;
+};
+
+static std::map<sycl_quant_actual_key, uint64_t> g_quant_timing_seen;
+static std::vector<sycl_quant_timing_sample>     g_quant_timing_samples;
+static std::mutex                                g_quant_timing_mutex;
+static std::once_flag                            g_quant_timing_atexit_once;
+static uint64_t                                  g_quant_timing_reserved = 0;
+static uint64_t                                  g_quant_timing_dropped = 0;
+
+static uint64_t ggml_sycl_quant_timing_period() {
+    static const uint64_t period = [] {
+        const char * env = std::getenv("GGML_SYCL_QUANT_TIMING_SAMPLE");
+        return env != nullptr ? std::strtoull(env, nullptr, 10) : 0;
+    }();
+    return period;
+}
+
+static uint64_t ggml_sycl_quant_timing_skip() {
+    static const uint64_t skip = [] {
+        const char * env = std::getenv("GGML_SYCL_QUANT_TIMING_SKIP");
+        return env != nullptr ? std::strtoull(env, nullptr, 10) : 4;
+    }();
+    return skip;
+}
+
+static uint64_t ggml_sycl_quant_timing_max_samples() {
+    static const uint64_t max_samples = [] {
+        const char * env = std::getenv("GGML_SYCL_QUANT_TIMING_MAX");
+        return env != nullptr ? std::strtoull(env, nullptr, 10) : 65536;
+    }();
+    return max_samples;
+}
+
+static uint64_t ggml_sycl_quant_timing_phase(
+        const sycl_quant_actual_key & key, uint64_t period) {
+    uint64_t hash = (uint64_t) (key.device + 1) * 0x9e3779b185ebca87ULL;
+    hash ^= (uint64_t) key.type * 0xc2b2ae3d27d4eb4fULL;
+    hash ^= (uint64_t) key.algo * 0x165667b19e3779f9ULL;
+    hash ^= (uint64_t) key.width * 0x85ebca77c2b2ae63ULL;
+    hash ^= (uint64_t) key.k + ((uint64_t) key.rows << 17);
+    return period != 0 ? hash % period : 0;
+}
+
+static void ggml_sycl_quant_timing_dump() {
+    std::lock_guard<std::mutex> lock(g_quant_timing_mutex);
+    std::map<sycl_quant_actual_key, sycl_quant_timing_stats> stats;
+    for (const auto & entry : g_quant_timing_seen) {
+        stats[entry.first].calls_seen = entry.second;
+    }
+
+    for (const auto & sample : g_quant_timing_samples) {
+        auto & row = stats[sample.key];
+        try {
+            const auto start_status = sample.start.get_info<sycl::info::event::command_execution_status>();
+            const auto end_status   = sample.end.get_info<sycl::info::event::command_execution_status>();
+            if (start_status != sycl::info::event_command_status::complete ||
+                    end_status != sycl::info::event_command_status::complete) {
+                row.incomplete++;
+                continue;
+            }
+            const uint64_t start_begin = sample.start.get_profiling_info<sycl::info::event_profiling::command_start>();
+            const uint64_t start_end   = sample.start.get_profiling_info<sycl::info::event_profiling::command_end>();
+            const uint64_t end_begin   = sample.end.get_profiling_info<sycl::info::event_profiling::command_start>();
+            const uint64_t end_end     = sample.end.get_profiling_info<sycl::info::event_profiling::command_end>();
+            if (start_end < start_begin || end_end < end_begin || end_begin < start_end ||
+                    end_begin - start_end > 1000000000ULL ||
+                    start_end - start_begin > 1000000000ULL ||
+                    end_end - end_begin > 1000000000ULL) {
+                row.invalid++;
+                continue;
+            }
+            const uint64_t device_ns = end_begin - start_end;
+            row.samples++;
+            row.device_ns += device_ns;
+            row.barrier_ns += (start_end - start_begin) + (end_end - end_begin);
+            row.min_ns = std::min(row.min_ns, device_ns);
+            row.max_ns = std::max(row.max_ns, device_ns);
+        } catch (const sycl::exception &) {
+            row.invalid++;
+        }
+    }
+
+    fprintf(stderr,
+            "\n[QUANT-TIMING] version=1 scope=standard_mul_mat sample_period=%llu "
+            "skip=%llu max_samples=%llu reserved=%llu dropped=%llu\n",
+            (unsigned long long) ggml_sycl_quant_timing_period(),
+            (unsigned long long) ggml_sycl_quant_timing_skip(),
+            (unsigned long long) ggml_sycl_quant_timing_max_samples(),
+            (unsigned long long) g_quant_timing_reserved,
+            (unsigned long long) g_quant_timing_dropped);
+    uint64_t total_samples = 0;
+    uint64_t total_device_ns = 0;
+    for (const auto & entry : stats) {
+        const auto & key = entry.first;
+        const auto & row = entry.second;
+        total_samples += row.samples;
+        total_device_ns += row.device_ns;
+        const uint64_t mean_ns = row.samples != 0 ? row.device_ns / row.samples : 0;
+        const uint64_t min_ns = row.samples != 0 ? row.min_ns : 0;
+        fprintf(stderr,
+                "[QUANT-TIMING] kind=device algo=%s device=%d type=%s reordered=%d split=%d "
+                "width=%lld K=%lld rows=%lld calls_seen=%llu samples=%llu device_ns=%llu "
+                "mean_ns=%llu min_ns=%llu max_ns=%llu barrier_ns=%llu incomplete=%llu invalid=%llu\n",
+                ggml_sycl_quant_census_algo_name(key.algo), key.device, ggml_type_name(key.type),
+                key.reordered ? 1 : 0, key.split ? 1 : 0, (long long) key.width,
+                (long long) key.k, (long long) key.rows, (unsigned long long) row.calls_seen,
+                (unsigned long long) row.samples, (unsigned long long) row.device_ns,
+                (unsigned long long) mean_ns, (unsigned long long) min_ns,
+                (unsigned long long) row.max_ns, (unsigned long long) row.barrier_ns,
+                (unsigned long long) row.incomplete, (unsigned long long) row.invalid);
+    }
+    fprintf(stderr, "[QUANT-TIMING] end samples=%llu device_ns=%llu\n\n",
+            (unsigned long long) total_samples, (unsigned long long) total_device_ns);
+}
+
+static std::optional<sycl_quant_timing_token> ggml_sycl_quant_timing_begin(
+        const ggml_tensor * src0, bool split, ggml_sycl_op_mul_mat_t op,
+        int device, int64_t width, int64_t row_low, int64_t row_high,
+        const queue_ptr & stream) {
+    const uint64_t period = ggml_sycl_quant_timing_period();
+    if (period == 0 || !ggml_sycl_quant_census_is_quantized(src0)) {
+        return std::nullopt;
+    }
+
+    const sycl_quant_actual_key key {
+        device, src0->type, ggml_sycl_quant_census_classify(op),
+        ggml_sycl_quant_census_reordered(src0), split, width, src0->ne[0], row_high - row_low,
+    };
+    {
+        std::lock_guard<std::mutex> lock(g_quant_timing_mutex);
+        const uint64_t seen = ++g_quant_timing_seen[key];
+        const uint64_t skip = ggml_sycl_quant_timing_skip();
+        if (seen <= skip || (seen - skip - 1) % period != ggml_sycl_quant_timing_phase(key, period)) {
+            return std::nullopt;
+        }
+        if (g_quant_timing_reserved >= ggml_sycl_quant_timing_max_samples()) {
+            g_quant_timing_dropped++;
+            return std::nullopt;
+        }
+        g_quant_timing_reserved++;
+        std::call_once(g_quant_timing_atexit_once, [] { std::atexit(ggml_sycl_quant_timing_dump); });
+    }
+    return sycl_quant_timing_token { key, stream->ext_oneapi_submit_barrier() };
+}
+
+static void ggml_sycl_quant_timing_end(
+        const std::optional<sycl_quant_timing_token> & token, const queue_ptr & stream) {
+    if (!token.has_value()) {
+        return;
+    }
+    sycl_quant_timing_sample sample { token->key, token->start, stream->ext_oneapi_submit_barrier() };
+    std::lock_guard<std::mutex> lock(g_quant_timing_mutex);
+    g_quant_timing_samples.push_back(sample);
+}
+
 
