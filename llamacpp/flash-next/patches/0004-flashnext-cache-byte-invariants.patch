+// Diagnostic only: exact selected-weight checks before compute; default off.
+#pragma once
+#include "ggml-backend.h"
+#include "llama-impl.h"
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+static inline bool llama_moe_verify_enabled() {
+    static const bool enabled = []() {
+        const char * value = std::getenv("LLAMA_MOE_VERIFY_BYTES");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+static inline void llama_moe_verify_layout(const ggml_tensor * source, const ggml_tensor * destination) {
+    GGML_ASSERT(source->type == destination->type);
+    GGML_ASSERT(source->ne[0] == destination->ne[0] && source->ne[1] == destination->ne[1]);
+    GGML_ASSERT(source->nb[2] == destination->nb[2]);
+}
+
+struct llama_moe_verify_counters {
+    size_t calls[5] = {};
+    size_t bytes[5] = {};
+};
+inline llama_moe_verify_counters & llama_moe_verify_counts() {
+    static llama_moe_verify_counters counts;
+    return counts;
+}
+static inline int llama_moe_verify_stage(const char * stage) {
+    const char * names[] = {"slotmap", "selected-bank", "hit-bank", "hit-dst", "staged-selected"};
+    for (int i = 0; i < 5; ++i) { if (std::strcmp(stage, names[i]) == 0) { return i; } }
+    GGML_ABORT("MOE_VERIFY unknown stage");
+}
+static inline void llama_moe_verify_coverage() {
+    const auto & c = llama_moe_verify_counts();
+    LLAMA_LOG_INFO("MOE_VERIFY COVERAGE slotmap=%zu selected-bank=%zu hit-bank=%zu hit-dst=%zu staged-selected=%zu bytes=%zu\n",
+        c.calls[0], c.calls[1], c.calls[2], c.calls[3], c.calls[4],
+        c.bytes[0]+c.bytes[1]+c.bytes[2]+c.bytes[3]+c.bytes[4]);
+}
+
+// Caller synchronizes its backend before readback. Memory is bounded to 4 MiB.
+// expected must point at immutable model bytes, never another GPU readback.
+static inline size_t llama_moe_verify_range(const char * stage, const ggml_tensor * tensor,
+        size_t offset, const void * expected, size_t size, int64_t expert, int64_t slot) {
+    GGML_ASSERT(offset <= ggml_nbytes(tensor) && size <= ggml_nbytes(tensor) - offset);
+    std::vector<uint8_t> readback(std::min<size_t>(size, 4*1024*1024));
+    for (size_t done = 0; done < size;) {
+        const size_t count = std::min(readback.size(), size-done);
+        ggml_backend_tensor_get(tensor, readback.data(), offset+done, count);
+        const auto * want = static_cast<const uint8_t *>(expected)+done;
+        if (std::memcmp(readback.data(), want, count) != 0) {
+            size_t byte = 0;
+            while (byte < count && readback[byte] == want[byte]) { ++byte; }
+            GGML_ABORT("MOE_VERIFY FAIL stage=%s tensor=%s expert=%lld slot=%lld offset=%zu got=%u expected=%u gpu=%p host=%p",
+                stage, tensor->name, (long long) expert, (long long) slot, offset+done+byte,
+                unsigned(readback[byte]), unsigned(want[byte]), tensor->data, expected);
+        }
+        done += count;
+    }
+    const int index = llama_moe_verify_stage(stage);
+    ++llama_moe_verify_counts().calls[index];
+    llama_moe_verify_counts().bytes[index] += size;
+    return size;
+}
