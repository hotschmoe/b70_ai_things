+// Bounded SCALE0 row observer. Only the explicitly armed numeric lane calls this.
+#pragma once
+#include "ggml.h"
+#include <algorithm>
+#include <cmath>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+namespace flashnext_reset_capture {
+struct capture {
+    std::vector<float> before, after;
+    const char * dir = nullptr;
+    char label[GGML_MAX_NAME] = {};
+    bool active = false;
+};
+inline capture prepare(const ggml_tensor * dst) {
+    capture c;
+    static const bool enabled = [] {
+        const char * e = std::getenv("FLASHNEXT_RESET_DIAG");
+        const char * n = std::getenv("FLASHNEXT_RESET_DIAG_NUMERIC");
+        return e && n && std::strcmp(e,"1") == 0 && std::strcmp(n,"1") == 0;
+    }();
+    if (!enabled || std::strncmp(ggml_get_name(dst), "FNRESET_", 8) != 0) return c;
+    static const char * dir = std::getenv("FLASHNEXT_RESET_DIAG_DIR");
+    static std::mutex lock;
+    static char seen[18][GGML_MAX_NAME] = {};
+    static size_t used = 0, bytes = 0;
+    std::lock_guard<std::mutex> guard(lock);
+    for (size_t i = 0; i < used; ++i) if (std::strcmp(seen[i], ggml_get_name(dst)) == 0) return c;
+    const auto * src = dst->src[0];
+    const size_t size = ggml_nbytes(src);
+    float p[2]; std::memcpy(p, dst->op_params, sizeof(p));
+    const bool supported = src->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+        ggml_is_contiguous(src) && ggml_is_contiguous(dst) &&
+        p[0] == 0.0f && p[1] == 0.0f && size == ggml_nbytes(dst);
+    if (!dir || !*dir || !supported || size == 0 || size > 16u*1024u*1024u ||
+        used >= 18 || size*2 > 256u*1024u*1024u - bytes) {
+        std::fprintf(stderr,"FNRESET numeric_skip label=%s bytes=%zu supported=%d reason=directory_shape_zero_or_bound\n",ggml_get_name(dst),size,supported);
+        return c;
+    }
+    std::snprintf(seen[used++], GGML_MAX_NAME, "%s", ggml_get_name(dst));
+    bytes += size*2;
+    c.before.resize(size/sizeof(float)); c.after.resize(size/sizeof(float));
+    std::snprintf(c.label,sizeof(c.label),"%s",ggml_get_name(dst));
+    c.dir = dir; c.active = true;
+    return c;
+}
+inline void write_summary(const capture & c, const char * phase, const std::vector<float> & values) {
+    size_t nan=0, pi=0, ni=0, nonzero=0, pz=0, nz=0, examples=0;
+    float maxabs=0;
+    for (size_t i=0;i<values.size();++i) {
+        const float x=values[i];
+        if (std::isnan(x)) ++nan;
+        else if (std::isinf(x)) { if (std::signbit(x)) ++ni; else ++pi; }
+        else if (x == 0) { if (std::signbit(x)) ++nz; else ++pz; }
+        else { ++nonzero; maxabs=std::max(maxabs,std::fabs(x)); }
+        if ((x != 0 || !std::isfinite(x)) && examples++ < 8) {
+            uint32_t bits;std::memcpy(&bits,&x,sizeof(bits));
+            std::fprintf(stderr,"FNRESET value label=%s phase=%s index=%zu bits=%08" PRIx32 "\n",c.label,phase,i,bits);
+        }
+    }
+    char path[1024];
+    const int len=std::snprintf(path,sizeof(path),"%s/%s.%s.f32",c.dir,c.label,phase);
+    bool ok=false;
+    if (len > 0 && size_t(len)<sizeof(path)) {
+        // Never overwrite an earlier receipt; duplicates or stale capture directories are incomplete.
+        FILE * file=std::fopen(path,"wbx");
+        if (file) { const size_t wrote=std::fwrite(values.data(),sizeof(float),values.size(),file);
+            const int closed=std::fclose(file);ok=wrote==values.size() && closed==0; }
+    }
+    std::fprintf(stderr,"FNRESET summary label=%s phase=%s count=%zu nan=%zu posinf=%zu neginf=%zu finite_nonzero=%zu poszero=%zu negzero=%zu max_abs_finite=%.9g complete_file=%d file=%s\n",
+        c.label,phase,values.size(),nan,pi,ni,nonzero,pz,nz,double(maxabs),ok,path);
+}
+inline void finish(const capture & c) {
+    if (!c.active) return;
+    write_summary(c,"pre",c.before);write_summary(c,"post",c.after);
+}
+} // namespace flashnext_reset_capture
