+// Bounded observation only: existing eval callback can split/fence graphs.
+#pragma once
+#include "ggml.h"
+#include "ggml-backend.h"
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <cerrno>
+#include <vector>
+#include <string>
+#include <fcntl.h>
