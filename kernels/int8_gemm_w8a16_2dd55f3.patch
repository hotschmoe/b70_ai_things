+torch::Tensor int8_gemm_w8a16(
+    const torch::Tensor& A,
+    const torch::Tensor& B,
+    const torch::Tensor& B_scale,
+    const std::optional<torch::Tensor>& bias_) {
+  const at::DeviceGuard device_guard(A.device());
+  TORCH_CHECK(
+      B_scale.is_contiguous(),
+      "B_scale must be contiguous for int8 W8A16 matmul");
+  torch::Tensor result =
+      check_and_create_output_tensor(A, B, A.scalar_type());
+  const bool is_nt = B.strides()[B.dim() - 2] == 1;
+  oneDNN::dnnl_matmul_w8a16_int8(
+      result, A, B, B_scale, is_nt, bias_);
+  return result;
+}
