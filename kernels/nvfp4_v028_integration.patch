+torch::Tensor nvfp4_gemm_w4a16(
+    const torch::Tensor& A,
+    const torch::Tensor& B,
+    const std::optional<torch::Tensor>& bias,
+    const torch::Tensor& B_scale,
+    int64_t group_size) {
+  const at::DeviceGuard device_guard(A.device());
+  TORCH_CHECK(A.scalar_type() == torch::kBFloat16, "A must be bfloat16");
+  TORCH_CHECK(A.dim() == 2 || A.dim() == 3, "A must be 2D or 3D");
+  TORCH_CHECK(B.dim() == 2, "B must be a 2D packed NVFP4 tensor");
+  TORCH_CHECK(
+      B.stride(0) == 1,
+      "B must use packed NT layout with the K/2 dimension contiguous");
+  TORCH_CHECK(B_scale.is_contiguous(), "B_scale must be contiguous");
+  TORCH_CHECK(group_size > 0, "group_size must be positive");
+
+  torch::Tensor result =
+      check_and_create_output_tensor(A, B, A.scalar_type());
+  oneDNN::dnnl_matmul_w4a16_nvfp4(
+      result, A, B, bias, B_scale, group_size);
+  return result;
+}
+
+torch::Tensor nvfp4_gemm_w4a16_f8scale(
+    const torch::Tensor& A,
+    const torch::Tensor& B,
+    const std::optional<torch::Tensor>& bias,
+    const torch::Tensor& B_scale,
+    const torch::Tensor& B_global_scale,
+    int64_t group_size) {
+  const at::DeviceGuard device_guard(A.device());
+  TORCH_CHECK(A.scalar_type() == torch::kBFloat16, "A must be bfloat16");
+  TORCH_CHECK(A.dim() == 2 || A.dim() == 3, "A must be 2D or 3D");
+  TORCH_CHECK(B.dim() == 2, "B must be a 2D packed NVFP4 tensor");
+  TORCH_CHECK(
+      B.stride(0) == 1,
+      "B must use packed NT layout with the K/2 dimension contiguous");
+  TORCH_CHECK(B_scale.is_contiguous(), "B_scale must be contiguous");
+  TORCH_CHECK(
+      B_global_scale.is_contiguous(), "B_global_scale must be contiguous");
+  TORCH_CHECK(group_size > 0, "group_size must be positive");
+
+  torch::Tensor result =
+      check_and_create_output_tensor(A, B, A.scalar_type());
+  oneDNN::dnnl_matmul_w4a16_nvfp4_f8scale(
+      result, A, B, bias, B_scale, B_global_scale, group_size);
+  return result;
+}
