          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(tensorfold:prompt_tokens_total{instance=~\"$instance\"}[$__rate_interval])) - sum(rate(tensorfold:prompt_tokens_cached_total{instance=~\"$instance\"}[$__rate_interval]))) / clamp_min(sum(rate(tensorfold:request_prefill_seconds_sum{instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "uncached prompt tok/s while prefilling",
          "refId": "A",
          "range": true
