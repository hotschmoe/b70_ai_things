#!/usr/bin/env bash
# cpu-run -- serialize heavy host-CPU/RAM work against timed measurements across parallel agents.
#
# Why: gpu-run keeps GPU runs apart, but a parallel kernel build, CPU model run or large file copy
# still disturbs host-launch latency, NUMA placement and page cache under another agent's timed
# GPU measurement. One host-wide flock keeps the two apart; light editing and reading stay parallel.
#
# Two kinds of holder take the SAME exclusive lock:
#   heavy  (default): builds, CPU inference, quantization, large copies. Runs under
#                     nice -n 19 + ionice -c3. Keep MAX_JOBS<=4 (see AGENTS.md / cap-kernel-build RAM).
#   --quiet         : a timed measurement window that needs a quiet CPU. Runs at normal priority.
#                     Hold it only for the timed window, not for a whole long-lived serve.
#
# Usage:
#   cpu-run <cmd> [args...]            # heavy job, niced
#   cpu-run --quiet <cmd> [args...]    # timed window; e.g. cpu-run --quiet bin/gpu-run --card 0 bench.sh
#   cpu-run --status                   # current holder (or "free")
# Nest order for timed GPU work: cpu-run --quiet outside, gpu-run inside.
#
# Env (override as needed):
#   B70_CPU_LOCK          lock path         (default /mnt/vm_8tb/b70/cpu-heavy.lock)
#   B70_CPU_LOCK_TIMEOUT  max wait seconds  (default 600; 0 = wait forever)
#   B70_AGENT             label for logs    (default: $HOSTNAME)
set -uo pipefail

LOCK="${B70_CPU_LOCK:-/mnt/vm_8tb/b70/cpu-heavy.lock}"
TIMEOUT="${B70_CPU_LOCK_TIMEOUT:-600}"
AGENT="${B70_AGENT:-$(hostname)}"
OWNER="$LOCK.owner"

MODE=heavy
case "${1:-}" in
  --status|--who)
    if [ -s "$OWNER" ]; then echo "CPU lease: HELD  $(cat "$OWNER")"; else echo "CPU lease: free"; fi
    exit 0 ;;
  --quiet) MODE=quiet; shift ;;
  -h|--help|"") awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
esac
[ $# -gt 0 ] || { echo "cpu-run: no command given" >&2; exit 2; }

command -v flock >/dev/null 2>&1 || { echo "cpu-run: flock not found (install util-linux)" >&2; exit 127; }
lockdir="$(dirname "$LOCK")"
[ -d "$lockdir" ] || { echo "cpu-run: lock dir '$lockdir' does not exist (set B70_CPU_LOCK to a host path)." >&2; exit 1; }

# PRIORITY.hold (orchestrator 03:25): while this file exists, only agents whose B70_AGENT starts with one of the
# space-separated prefixes in it (default "A-S A-I") may take a new lease; others wait here (bounded by the lock timeout).
# A hold older than B70_HOLD_MAX_AGE seconds (default 3600) is ignored as stale.
HOLD="${B70_PRIORITY_HOLD:-/mnt/vm_8tb/b70/results/tf-flashnext/PRIORITY.hold}"
is_priority() {  # agent listed in an active PRIORITY.hold
  local allowed p
  [ -e "$HOLD" ] || return 1
  allowed="$(tr -s ' \n' ' ' < "$HOLD" 2>/dev/null)"; [ -n "${allowed// /}" ] || allowed="A-S A-I"
  for p in $allowed; do case "$AGENT" in "$p"*) return 0 ;; esac; done
  return 1
}
hold_wait() {  # $1 = tool name
  local waited=0 said=0 allowed p age
  while [ -e "$HOLD" ]; do
    age=$(( $(date +%s) - $(stat -c %Y "$HOLD" 2>/dev/null || date +%s) ))
    [ "$age" -gt "${B70_HOLD_MAX_AGE:-3600}" ] && { echo "$1: ignoring stale $HOLD (${age}s old)" >&2; return 0; }
    allowed="$(tr -s ' \n' ' ' < "$HOLD" 2>/dev/null)"; [ -n "${allowed// /}" ] || allowed="A-S A-I"
    for p in $allowed; do case "$AGENT" in "$p"*) return 0 ;; esac; done
    [ "$said" = 0 ] && { echo "$1: priority hold active ($HOLD: $allowed); $AGENT waits" >&2; said=1; }
    if [ "$TIMEOUT" != 0 ] && [ "$waited" -ge "$TIMEOUT" ]; then echo "$1: timed out after ${TIMEOUT}s behind priority hold" >&2; exit 124; fi
    sleep 5; waited=$((waited + 5))
  done
}
CMDLINE="$*"
exec 7>"$LOCK" || { echo "cpu-run: cannot open lock $LOCK" >&2; exit 1; }
# FIFO for every waiter (orchestrator 2026-11-22 09:25): each waiter writes a ticket ($LOCK.q/<ns>.<pid>, content =
# its B70_AGENT) and polls; it tries the lock only when it is the oldest live ELIGIBLE ticket. While a PRIORITY.hold is
# active, only tickets of listed agents are eligible (re-evaluated every poll, so a waiter that started before the hold
# becomes priority as soon as its agent is listed). Nobody blocks in flock, so no waiter can jump the queue.
QDIR="$LOCK.q"; mkdir -p "$QDIR" 2>/dev/null || true
agent_listed() {  # $1 = agent name; true if listed in an active (non-stale) PRIORITY.hold
  local allowed p age
  [ -e "$HOLD" ] || return 1
  age=$(( $(date +%s) - $(stat -c %Y "$HOLD" 2>/dev/null || date +%s) ))
  [ "$age" -gt "${B70_HOLD_MAX_AGE:-3600}" ] && return 1
  allowed="$(tr -s ' \n' ' ' < "$HOLD" 2>/dev/null)"; [ -n "${allowed// /}" ] || allowed="A-S A-I"
  for p in $allowed; do case "$1" in "$p"*) return 0 ;; esac; done
  return 1
}
hold_live() { [ -e "$HOLD" ] && [ $(( $(date +%s) - $(stat -c %Y "$HOLD" 2>/dev/null || date +%s) )) -le "${B70_HOLD_MAX_AGE:-3600}" ]; }
TICKET="$QDIR/$(date +%s%N).$$"; printf '%s\n' "$AGENT" > "$TICKET" 2>/dev/null || TICKET=""
trap '[ -n "$TICKET" ] && rm -f "$TICKET"' EXIT INT TERM
at_head() {
  local t p a held=0
  [ -n "$TICKET" ] || return 0
  hold_live && held=1
  for t in $(ls "$QDIR" 2>/dev/null | sort); do
    p="${t##*.}"
    if ! kill -0 "$p" 2>/dev/null; then rm -f "$QDIR/$t"; continue; fi
    if [ "$held" = 1 ]; then a="$(head -c 200 "$QDIR/$t" 2>/dev/null)"; agent_listed "$a" || continue; fi
    [ "$QDIR/$t" = "$TICKET" ] && return 0
    return 1
  done
  [ "$held" = 1 ] && return 1   # hold active and we are not eligible
  return 0
}
waited=0; said=0
until at_head && flock -n 7; do
  if [ "$said" = 0 ]; then echo "cpu-run: busy (held by: $(cat "$OWNER" 2>/dev/null || echo unknown)); queued, waiting up to ${TIMEOUT}s ..." >&2; said=1; fi
  if [ "$TIMEOUT" != 0 ] && [ "$waited" -ge "$TIMEOUT" ]; then echo "cpu-run: timed out after ${TIMEOUT}s" >&2; exit 124; fi
  sleep 2; waited=$((waited + 2))
done
[ -n "$TICKET" ] && rm -f "$TICKET"; TICKET=""
printf '%s pid=%s mode=%s since=%s cmd: %s\n' "$AGENT" "$$" "$MODE" "$(date '+%F %T')" "$CMDLINE" > "$OWNER" 2>/dev/null || true
trap ': > "$OWNER" 2>/dev/null || true' EXIT INT TERM

echo "cpu-run: [$AGENT] acquired ($MODE) -> $*" >&2
start=$(date +%s)
if [ "$MODE" = heavy ]; then
  if command -v ionice >/dev/null 2>&1; then nice -n 19 ionice -c3 "$@"; else nice -n 19 "$@"; fi
else
  "$@"
fi
rc=$?
echo "cpu-run: [$AGENT] done in $(( $(date +%s) - start ))s (exit $rc)" >&2
exit $rc
