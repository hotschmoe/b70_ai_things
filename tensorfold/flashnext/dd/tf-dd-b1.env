# Variant b1: descriptor windows (the gated int-rf2 path), largest context estimated to fit.
# The desc KV pool is preallocated for abi.max_rows=16 streams x context (13 layers x 1344 B/row/card,
# about 280 KB per context token per card). int-rf2 at 16384 used 29.58 GiB/GPU; 20480 is the estimate
# with about 1.3 GB/card left. If load fails, set TF_CONTEXT=16384 (the exact gated value).
# NOTE: real DD prompts reach 57-90K tokens (Strata server.log); b1 refuses them.
source /mnt/vm_8tb/github/b70_ai_things/tensorfold/flashnext/dd/tf-dd-common.env
TF_VARIANT=b1-desc
TF_CONTEXT=20480
TF_MAX_TOKENS=12288
TF_THINKING_BUDGET=8192
