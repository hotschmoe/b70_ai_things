# Variant b2: XPU_FN_KV=int8 paged KV (legacy windows; descriptor windows are off in this mode).
# Page pool = 4 x context tokens shared by all streams, 7,696 B/token/card -> about 4.03 GB/card at 131072.
# 200000 (about 6.2 GB/card) does not fit next to the 24.2 GB weights. Not gated as a serve on this build.
source /mnt/vm_8tb/github/b70_ai_things/tensorfold/flashnext/dd/tf-dd-common.env
TF_VARIANT=b2-kv8
TF_CONTEXT=131072
TF_MAX_TOKENS=32768
TF_THINKING_BUDGET=16384
export XPU_FN_KV=int8
