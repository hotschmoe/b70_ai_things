[Unit]
Description=hotschmoe-dd: TensorFold Flash-Next 372bf1b2 IQ3_XXS TP2 (backend 127.0.0.1:18124)
After=network-online.target
Wants=hotschmoe-dd-frontdoor.service
Conflicts=hotschmoe-dd.service

[Service]
Type=simple
WorkingDirectory=/mnt/vm_8tb/github/b70_ai_things
Environment=PATH=/home/hotschmoe/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=B70_GPU_LOCK_TIMEOUT=0
Environment=B70_AGENT=hotschmoe-dd-tf
# Variant: tf-dd-b2.env (int8 paged KV, 131072) or tf-dd-b1.env (desc windows, 20480).
Environment=TF_DD_CONFIG=/mnt/vm_8tb/github/b70_ai_things/tensorfold/flashnext/dd/tf-dd-b2.env
# tcp: TF owns 127.0.0.1:18124. unix: TF on a Unix socket behind hotschmoe-dd-tf-clamp.service.
Environment=TF_LISTEN=tcp
ExecStartPre=/mnt/vm_8tb/github/b70_ai_things/bin/gpu-run /mnt/vm_8tb/github/b70_ai_things/bin/xpu-health
# gpu-run holds BOTH card leases (no --card) for the life of the server.
ExecStart=/mnt/vm_8tb/github/b70_ai_things/bin/gpu-run /bin/bash /mnt/vm_8tb/github/b70_ai_things/tensorfold/flashnext/dd/dd_launch_tf.sh
ExecStopPost=-/bin/bash /mnt/vm_8tb/github/b70_ai_things/tensorfold/flashnext/dd/dd_poststop_tf.sh
# control-group: SIGTERM reaches the server directly (gpu-run does not forward it).
KillMode=control-group
KillSignal=SIGTERM
TimeoutStartSec=900
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=1800
StartLimitBurst=4
StandardOutput=append:/mnt/vm_8tb/b70/logs/hotschmoe-dd/tf-server.log
StandardError=append:/mnt/vm_8tb/b70/logs/hotschmoe-dd/tf-server.log

[Install]
WantedBy=default.target
