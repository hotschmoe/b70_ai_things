[Unit]
Description=hotschmoe-dd passive metrics record (per-request metrics only; never prompt/response text)
After=hotschmoe-dd-frontdoor.service

[Service]
Type=simple
WorkingDirectory=/mnt/vm_8tb/github/b70_ai_things
ExecStart=/usr/bin/python3 /mnt/vm_8tb/github/b70_ai_things/tensorfold/flashnext/dd/soak_monitor.py --backend strata
Restart=on-failure
RestartSec=60
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
CPUQuota=5%
MemoryMax=256M
StandardOutput=append:/mnt/vm_8tb/b70/logs/hotschmoe-dd/soak.log
StandardError=append:/mnt/vm_8tb/b70/logs/hotschmoe-dd/soak.log

[Install]
WantedBy=default.target
