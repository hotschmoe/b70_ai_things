# Variant prod: the hotschmoe-dd production candidate on b70/dd-serve (owner: worker INT).
# Parity target: strata/flash-next/dd/hotschmoe-dd-0216.json (4 slots, 200000 context, int8 KV with RAM backing,
# MTP, vision, reasoning on, effort medium, 16384 thinking budget).
# Frozen build: tensorfold/flashnext/dd/build_dd.sh <commit> builds a detached worktree under
# /mnt/vm_8tb/b70/build/tensorfold-dd/<commit8>; then set TF_COMMIT, TF_BIN and TF_BIN_SHA256 below.
# Item flags are added here as KV / SAMP / VIS / API land on b70/dd-serve (see SERVE-READINESS.md).
source /mnt/vm_8tb/github/b70_ai_things/tensorfold/flashnext/dd/tf-dd-common.env
TF_VARIANT=prod
TF_COMMIT=@FREEZE_COMMIT@
TF_BIN=/mnt/vm_8tb/b70/build/tensorfold-dd/@FREEZE_COMMIT8@/zig-out/xpu/bin/tensorfold-native
TF_BIN_SHA256=@FREEZE_SHA@
TF_ALIASES="qwen3.8-flash-next-ISTA-GSQ-RCO-IQ3_XXS-tensorfold qwen3.8-flash-next-ISTA-GSQ-RCO-IQ3_XXS-strata-0216"
TF_PARALLEL=4
TF_CONTEXT=200000
TF_MAX_TOKENS=32768
TF_REASONING_EFFORT=medium
TF_THINKING_BUDGET=16384
# KV (worker KV): paged int8 KV with descriptor windows + RAM parking. Flags pending.
export XPU_FN_KV=int8
# SAMP (b70/fn-samp 28030ff0, merged 19:22): sampling by request. TF_TEMPERATURE empty -> generation_config.json
# (T 1.0, top_p 0.95, top_k 20, Strata's thinking set); --instruct-sampling card = Strata's thinking-off card
# (T 0.7, top_p 0.8, top_k 20, presence 1.5). No clamp proxy.
TF_TEMPERATURE=
TF_SAMP_ARGS="--instruct-sampling card"
# VIS (b70/dd-vis a2e63f48): Strata's strata-vision CPU sidecar + mmproj, 8 threads, 300 tokens an image.
TF_VIS_ARGS="--vision"
export TF_VISION_EXE=/mnt/vm_8tb/b70/build/strata-ab/build-vision-cpu/bin/strata-vision
export TF_VISION_MMPROJ=/mnt/vm_8tb/github/b70_ai_things/models/files/qwen3.8-flash-next/ista-gsq-rco-iq3-xxs/mmproj-Qwen3.8-Flash-Next-BF16.gguf
export TF_VISION_MODEL=$FN_GGUF
export TF_VISION_LIB=/mnt/vm_8tb/b70/build/tensorfold/vision-lib
export TF_VISION_THREADS=8 TF_VISION_MAX_TOKENS=300
# dd-vis 097ff79c: JPEG EXIF rotation + WebP decode (locally built libjpeg-turbo 3.1.4.1 / libwebp 1.6.0). Encoder peak
# RSS ~1 GiB per image: the unit has no MemoryMax (keep it so, or leave >= 4 GiB headroom).
export TENSORFOLD_LIBTURBOJPEG=/mnt/vm_8tb/b70/build/tensorfold/vision-lib/libturbojpeg.so.0
export TENSORFOLD_LIBWEBP=/mnt/vm_8tb/b70/build/tensorfold/vision-lib/libwebpdecoder.so.3
# API (b70/dd-api 32b27d57): fit max_tokens to the window; tool_choice required/named + response_format via prompt fallback.
export TF_FIT_MAX_TOKENS=1 TF_STRUCTURED_FALLBACK=1
# Window identity gate (gpu_window_checks.py identity).
WIN_EXPECT_CAPS=vision=true,greedy_only=false,penalties=true
TF_PROMPT_CACHE_GIB=0
TF_EXTRA_ARGS="$TF_SAMP_ARGS $TF_VIS_ARGS"
