+bool Verifier::init_capture_streams(std::string& err) {
+    if(cs_ || sh_cs_ || copy_) {err="verify: capture streams already initialized";return false;}
+    if(device_<0) device_=dpct::get_current_device_id();
+    auto& device=dpct::get_device(device_);
+    const auto& owner=device.in_order_queue();
+    // Fail before stream/model allocation on an explicit foreign stream.
+    if(!verifier_stream_contract(ext_stream_,owner,err)) return false;
+    copy_=device.create_queue(true);
+    cs_=ext_stream_ ? ext_stream_:device.create_queue(true);
+    sh_cs_=device.create_queue(true);
+    if(!copy_ || !cs_ || !sh_cs_ || !verifier_stream_contract(copy_,owner,err) ||
+       !verifier_stream_contract(cs_,owner,err) || !verifier_stream_contract(sh_cs_,owner,err)) {
+        if(err.empty()) err="verify: capture stream create failed";return false;
+    }
+    return true;
+}
