+// Verifier capture streams belong to init's device/context, not construction's.
+#pragma once
+#include <sycl/sycl.hpp>
+#include <string>
+namespace strata::core {
+inline bool verifier_stream_contract(const sycl::queue* provided,const sycl::queue& owner,std::string& error) {
+    if(!provided) return true;
+    if(provided->get_context()!=owner.get_context() || provided->get_device()!=owner.get_device() ||
+       !provided->has_property<sycl::property::queue::in_order>()) {
+        error="verify: supplied stream differs from owning init device/context or is unordered";return false;
+    }
+    return true;
+}
