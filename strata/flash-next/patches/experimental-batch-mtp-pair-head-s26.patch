+    MtpDrafter& a = *d_[0];
+    MtpDrafter& b = *d_[1];
+    const int64_t N = a.g_->n_embd, HCN = a.g_->hc * N;
+    if (DPCT_CHECK_ERROR(dpct::experimental::begin_recording(cs_)) != 0) { err = "mtp pair: begin capture"; return false; }
