+void Gemm::f16_grouped(const uint16_t* const* X, const uint16_t* const* W,
+                       float* const* Y, const int64_t* rows, int count, int64_t N, int64_t K) {
+    if (count < 1 || count > 8 || N < 1 || K < 1 || N > INT_MAX || K > INT_MAX)
+        throw std::invalid_argument("prefill grouped f16: invalid shape");
+    auto* desc = (dpct::blas::descriptor_ptr)handle_;
+    auto& q = desc->get_queue();
+    if (!q.is_in_order()) throw std::invalid_argument("prefill grouped f16: in-order queue required");
+    struct Info {
+        std::array<oneapi::mkl::transpose, 8> ta, tb;
+        std::array<int64_t, 8> m, n, k, lda, ldb, ldc, size;
+        std::array<float, 8> alpha, beta;
+        std::array<const sycl::half*, 8> a, b;
+        std::array<float*, 8> c;
+    };
+    auto info = std::make_shared<Info>();
+    for (int i = 0; i < count; ++i) {
+        if (!X[i] || !W[i] || !Y[i] || rows[i] < 1 || rows[i] > INT_MAX)
+            throw std::invalid_argument("prefill grouped f16: invalid group");
+        info->ta[i] = oneapi::mkl::transpose::trans;
+        info->tb[i] = oneapi::mkl::transpose::nontrans;
+        info->m[i] = N; info->n[i] = rows[i]; info->k[i] = K;
+        info->lda[i] = K; info->ldb[i] = K; info->ldc[i] = N;
+        info->alpha[i] = 1.0f; info->beta[i] = 0.0f; info->size[i] = 1;
+        info->a[i] = reinterpret_cast<const sycl::half*>(W[i]);
+        info->b[i] = reinterpret_cast<const sycl::half*>(X[i]);
+        info->c[i] = Y[i];
+    }
+    try {
+        auto e = oneapi::mkl::blas::column_major::gemm_batch(
+            q, info->ta.data(), info->tb.data(), info->m.data(), info->n.data(),
+            info->k.data(), info->alpha.data(), info->a.data(), info->lda.data(),
+            info->b.data(), info->ldb.data(), info->beta.data(), info->c.data(),
+            info->ldc.data(), count, info->size.data()
+#ifdef __INTEL_MKL__
+            , dpct::blas::deduce_compute_mode(dpct::compute_type::f32, desc->get_math_mode(), false)
+#endif
+        );
+        // Follow the bundled DPCT gemm_batch metadata lifetime pattern. No normal wait.
+        q.submit([&](sycl::handler& h) {
+            h.depends_on(e);
+            h.host_task([info] {});
+        });
+    } catch (...) {
+        // On failed submission only, retain pointer/shape metadata through retirement.
+        auto error = std::current_exception();
+        try { q.wait_and_throw(); } catch (...) {}
+        std::rethrow_exception(error);
+    }
+}
