+// Default-off bounded batch observation identity. No model state owns this ledger.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <stdexcept>
+namespace strata::core::batch_fidelity {
+constexpr int REQUESTS=6, ROWS=6, LAYERS=48, D=10240, VOCAB=248320;
+constexpr size_t BYTE_LIMIT=64*1024*1024;
+struct identity { uint64_t rid=0,generation=0,slotgen=0;int slot=-1;int64_t prompt=0,pos=0;int token=0;int row=0,batchrows=1;uint64_t enginegen=0,event=0; };
+struct graph_layout {
+ // n,admission,ar_off,hbase,then6 graph-consumed slot rows. Admission always consumes main row0.
+ std::array<uint64_t,10> words{};
+ static graph_layout make(const int* slots,int n,bool admission,int ar_off=0,int hbase=0){
+  if(n<1||n>ROWS || hbase!=0 || (ar_off!=0&&ar_off!=1) || (admission&&n!=1))throw std::invalid_argument("batch graph layout geometry");
+  graph_layout d;d.words.fill(~uint64_t(0));d.words[0]=uint64_t(n);d.words[1]=admission;d.words[2]=uint64_t(ar_off);d.words[3]=uint64_t(hbase);
+  unsigned mask=0;for(int t=0;t<n;++t){int slot=admission?ROWS:(slots?slots[t]:-1);if(!admission&&(slot<0||slot>=ROWS||(mask&(1u<<slot))))throw std::invalid_argument("batch graph duplicate/invalid actual row");if(!admission)mask|=1u<<slot;d.words[4+t]=uint64_t(slot);}return d;
+ }
+ bool operator==(const graph_layout& other)const{return words==other.words;}
+};
+struct entry {identity id;bool admission=false,later=false;};
+struct ledger {
+ std::array<entry,REQUESTS> requests{};unsigned count=0;
+ entry* find(uint64_t rid){for(unsigned i=0;i<count;++i)if(requests[i].id.rid==rid)return &requests[i];return nullptr;}
+ identity begin(uint64_t rid,uint64_t slotgen,int slot,int64_t prompt,uint64_t enginegen=1){
+  if(!enginegen || !rid || !slotgen || slot<0 || slot>=ROWS || prompt<1)throw std::invalid_argument("batch observer admission identity");
+  if(auto* e=find(rid)){if(enginegen!=e->id.enginegen || slotgen<e->id.slotgen || (slot!=e->id.slot && slotgen==e->id.slotgen))throw std::invalid_argument("batch observer stale migration");e->id.slot=slot;e->id.slotgen=slotgen;return e->id;}
+  if(count>=REQUESTS)return {};auto& e=requests[count++];e.id={rid,count,slotgen,slot,prompt,0,0};e.id.enginegen=enginegen;return e.id;
+ }
+ bool select(const identity& id,bool admission){auto* e=find(id.rid);if(!e)return false;
+  if(id.enginegen!=e->id.enginegen || id.generation!=e->id.generation || id.slotgen!=e->id.slotgen || id.slot!=e->id.slot || !id.slotgen || id.slot<0 || id.slot>=ROWS)throw std::invalid_argument("batch observer stale identity");
+  if(admission)return !e->admission;return e->admission && !e->later;
+ }
+ void complete(const identity& id,bool admission){auto* e=find(id.rid);if(!e || !select(id,admission))throw std::invalid_argument("batch observer invalid completion");
+  if(admission)e->admission=true;else e->later=true;
+ }
+};
+}
