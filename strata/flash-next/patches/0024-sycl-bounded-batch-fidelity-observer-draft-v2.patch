+namespace strata::core::batch_fidelity {
+struct config {bool enabled=false;const char* arm=nullptr;const char* dir=nullptr;
+ config(){const char* p=std::getenv("STRATA_BATCH_FIDELITY_DIAG");enabled=p&&!std::strcmp(p,"1");if(enabled){arm=std::getenv("STRATA_BATCH_FIDELITY_ARM");dir=std::getenv("STRATA_BATCH_FIDELITY_DIR");}}};
+inline const config& settings(){static config c;return c;}
+inline uint64_t engine_generation(){static const uint64_t generation=[](){timespec now{};if(clock_gettime(CLOCK_MONOTONIC,&now))throw std::runtime_error("batch observer engine clock");const uint64_t value=(uint64_t(now.tv_sec)*1000000000ull+uint64_t(now.tv_nsec))^(uint64_t(uint32_t(getpid()))<<32);if(!value)throw std::runtime_error("batch observer engine generation zero");return value;}();return generation;}
+inline bool armed(){if(!settings().enabled)return false;struct stat a,d;return settings().arm&&settings().dir&&!stat(settings().arm,&a)&&S_ISREG(a.st_mode)&&!stat(settings().dir,&d)&&S_ISDIR(d.st_mode);}
+inline ledger& records(){static ledger l;return l;}
+inline identity& admitting(){static identity id;return id;}
+inline std::mutex& log_lock(){static std::mutex m;return m;}
+inline identity begin(uint64_t rid,uint64_t slotgen,int slot,int64_t prompt){if(!armed()||!rid||!slotgen||slot<0)return {};auto id=records().begin(rid,slotgen,slot,prompt,engine_generation());admitting()=id;
+ if(id.rid)std::fprintf(stderr,"SBF request pid=%ld rid=%llu enginegen=%llu requestgen=%llu slot=%d slotgen=%llu prompt=%lld engine_generation=native_pid observed_only=1\n",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.enginegen,(unsigned long long)id.generation,id.slot,(unsigned long long)id.slotgen,(long long)prompt);return id;}
+inline identity mapped(uint64_t rid,uint64_t slotgen,int slot,int64_t pos,int token,uint64_t event=1){if(!settings().enabled)return {};auto* e=records().find(rid);identity id=e?e->id:identity{};id.rid=rid;id.slot=slot;id.slotgen=slotgen;id.pos=pos;id.token=token;id.enginegen=engine_generation();id.event=event;return id;}
+inline void span(const identity& id,int stage,int lb,int le,int64_t a,int64_t b,const char* phase){if(!settings().enabled||!id.rid)return;
+ const std::lock_guard<std::mutex> lock(log_lock());static unsigned events=0;if(++events>8192){if(events==8193)std::fprintf(stderr,"SBF bound span_events=8192 exceeded=1\n");return;}std::fprintf(stderr,"SBF span pid=%ld rid=%llu enginegen=%llu requestgen=%llu slot=%d slotgen=%llu stage=%d lb=%d le=%d begin=%lld end=%lld phase=%s completed=1 observed_only=1\n",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.enginegen,(unsigned long long)id.generation,id.slot,(unsigned long long)id.slotgen,stage,lb,le,(long long)a,(long long)b,phase);}
+inline bool store(const identity& id,int stage,int lb,int le,int layer,const char* phase,const std::vector<float>& raw,std::string& err,uint64_t epoch=0,int graph=-1){
+ static size_t total=0;static unsigned serial=0;const std::lock_guard<std::mutex> lock(log_lock());const size_t bytes=raw.size()*4;
+ if(!id.rid||!bytes||bytes>size_t(VOCAB)*4||total>BYTE_LIMIT-bytes){err="batch observer byte or identity bound";return false;}
+ const uint16_t endian=1;if(!*reinterpret_cast<const unsigned char*>(&endian)){err="batch observer requires little endian host";return false;}
+ char leaf[256];std::snprintf(leaf,sizeof leaf,"sbf-%ld-r%llu-e%llu-g%llu-sg%llu-s%d-%s-l%d-i%u.f32",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.enginegen,(unsigned long long)id.generation,(unsigned long long)id.slotgen,stage,phase,layer,++serial);
+ std::string path=std::string(settings().dir)+"/"+leaf;int fd=::open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);if(fd<0){err="batch observer open";return false;}
+ size_t done=0;const char* p=reinterpret_cast<const char*>(raw.data());while(done<bytes){ssize_t n=::write(fd,p+done,bytes-done);if(n>0)done+=size_t(n);else if(n<0&&errno==EINTR)continue;else break;}
+ const bool closed=::close(fd)==0;if(done!=bytes||!closed){::unlink(path.c_str());err="batch observer write";return false;}total+=bytes;
+ std::fprintf(stderr,"SBF vector pid=%ld rid=%llu enginegen=%llu requestgen=%llu slot=%d slotgen=%llu stage=%d lb=%d le=%d phase=%s layer=%d epoch=%llu graph=%d event=%llu pos=%lld token=%d row=%d batchrows=%d floats=%zu bytes=%zu file=%s canonical=le_f32 observed_only=1\n",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.enginegen,(unsigned long long)id.generation,id.slot,(unsigned long long)id.slotgen,stage,lb,le,phase,layer,(unsigned long long)epoch,graph,(unsigned long long)id.event,(long long)id.pos,id.token,id.row,id.batchrows,raw.size(),bytes,path.c_str());return true;
+}
+class snapshot {
+ static constexpr int GRAPH_LIMIT=16,EPOCHS=ROWS*(LAYERS+1),FRAME_WORDS=64;
+ using frame=std::array<uint64_t,FRAME_WORDS>;
+ struct graph_roster {graph_layout layout;std::array<bool,LAYERS+1> copied{};bool sealed=false,stamped=false;};
+ sycl::queue q_;int stage_,lb_,le_;bool head_;size_t stride_,raw_bytes_,bytes_;uint8_t* data_=nullptr;
+ std::array<graph_roster,GRAPH_LIMIT> graphs_{};int graph_count_=0,building_=-1,armed_graph_=-1;
+ bool failed_=false;uint64_t sequence_=0,published_=0;frame input_{},zero_frame_{};graph_layout zero_layout_{};std::array<uint64_t,EPOCHS> zero_epochs_{};
+ std::array<identity,ROWS> armed_ids_{};std::array<bool,ROWS> armed_selected_{};int armed_n_=0;bool armed_admission_=false;
+ size_t input_offset()const{return raw_bytes_;}size_t output_offset()const{return input_offset()+sizeof(frame);}
+ size_t layout_offset()const{return output_offset()+sizeof(frame);}size_t constant_offset(int i)const{return layout_offset()+sizeof(graph_layout)+size_t(i)*sizeof(graph_layout);}
+ size_t epochs_offset()const{return constant_offset(GRAPH_LIMIT);}
+ void affinity(const sycl::queue& q)const{if(q.get_context()!=q_.get_context()||q.get_device()!=q_.get_device())throw std::invalid_argument("batch observer queue/device/context changed");}
+ int graph_index(const graph_layout& layout)const{for(int i=0;i<graph_count_;++i)if(graphs_[i].layout==layout)return i;return -1;}
+ frame describe(const identity* ids,const bool* selected,int n,bool admission,uint64_t epoch,int graph)const{
+  if(!ids||!selected||n<1||n>ROWS||graph<0||graph>=graph_count_||!graphs_[graph].sealed)throw std::invalid_argument("batch observer frame graph/row descriptor");
+  frame f{};f[0]=epoch;f[1]=uint64_t(graph);f[2]=uint64_t(stage_);f[3]=uint64_t(lb_);f[4]=uint64_t(le_);f[5]=uint64_t(n);f[6]=admission;f[9]=D;f[10]=VOCAB;f[11]=LAYERS;
+  unsigned mask=0,chosen=0;for(int t=0;t<n;++t){const auto& id=ids[t];if(t && id.event!=ids[0].event)throw std::invalid_argument("batch observer mixed native batch events");if(id.slot<0||id.slot>=ROWS||(mask&(1u<<id.slot))||id.pos<0||id.token<0||id.token>=VOCAB||id.enginegen!=engine_generation())throw std::invalid_argument("batch observer actual row/engine/position invalid");mask|=1u<<id.slot;
+   if(selected[t]){if(!id.rid||!records().select(id,admission)||(admission?(n!=1||id.pos!=id.prompt-1||id.event!=0):(n<2||id.pos<id.prompt||id.event==0)))throw std::invalid_argument("batch observer stale/current request boundary invalid");chosen|=1u<<t;}
+   const size_t k=12+size_t(t)*8;f[k]=id.rid;f[k+1]=id.enginegen;f[k+2]=id.generation;f[k+3]=id.slotgen;f[k+4]=uint64_t(id.slot);f[k+5]=uint64_t(id.pos);f[k+6]=uint64_t(id.token);f[k+7]=id.event;
+   if(!admission&&graphs_[graph].layout.words[4+t]!=uint64_t(id.slot))throw std::invalid_argument("batch observer actual graph row layout changed");
+  }if(!chosen)throw std::invalid_argument("batch observer no selected request");f[7]=mask;f[8]=chosen;
+  if(graphs_[graph].layout.words[0]!=uint64_t(n)||graphs_[graph].layout.words[1]!=uint64_t(admission))throw std::invalid_argument("batch observer graph phase/rows mismatch");return f;
+ }
+public:
+ snapshot(const sycl::queue& q,int stage,int lb,int le,bool head):q_(q),stage_(stage),lb_(lb),le_(le),head_(head),stride_(size_t(le-lb)*D+(head?VOCAB:0)),raw_bytes_(ROWS*stride_*4),bytes_(raw_bytes_+2*sizeof(frame)+(GRAPH_LIMIT+1)*sizeof(graph_layout)+EPOCHS*8){
+  if(lb<0||le>LAYERS||lb>=le||head!=(le==LAYERS))throw std::invalid_argument("batch observer stage/head geometry");if(!armed())return;
+  if(!q_.has_property<sycl::property::queue::in_order>())throw std::invalid_argument("batch observer requires in-order owning queue");
+  data_=sycl::malloc_device<uint8_t>(bytes_,q_);if(!data_)throw std::bad_alloc();
+  std::fprintf(stderr,"SBF allocation stage=%d lb=%d le=%d pointer=%p bytes=%zu rows=6 head=%d owner_queue=verifier_cs\n",stage,lb,le,(void*)data_,bytes_,head);
+ }
+ ~snapshot(){try{release();}catch(...){}}
+ void release(){if(!data_)return;q_.wait_and_throw();std::fprintf(stderr,"SBF release_begin stage=%d pointer=%p bytes=%zu\n",stage_,(void*)data_,bytes_);sycl::free(data_,q_);data_=nullptr;std::fprintf(stderr,"SBF release_returned stage=%d\n",stage_);}
+ void begin_roster(const graph_layout& layout,sycl::queue& q){affinity(q);if(!data_||building_>=0)throw std::invalid_argument("batch observer graph construction lifecycle");int i=graph_index(layout);
+  if(i>=0&&graphs_[i].sealed)throw std::invalid_argument("batch observer immutable graph roster already sealed");if(i<0){if(graph_count_>=GRAPH_LIMIT)throw std::invalid_argument("batch observer graph roster bound");i=graph_count_++;graphs_[i].layout=layout;}
+  graphs_[i].copied.fill(false);graphs_[i].stamped=false;building_=i;
+  // Persistent host descriptor lives in this owner; upload completes before recording starts.
+  q.memcpy(data_+constant_offset(i),&graphs_[i].layout,sizeof(graph_layout)).wait_and_throw();
+ }
+ void seal_roster(const graph_layout& layout){int i=graph_index(layout);if(i!=building_||i<0||!graphs_[i].stamped)throw std::invalid_argument("batch observer graph seal/stamp mismatch");for(int l=0;l<=LAYERS;++l)if(graphs_[i].copied[size_t(l)]!=(l>=lb_&&l<le_ || (l==LAYERS&&head_)))throw std::invalid_argument("batch observer partial/foreign producer roster");graphs_[i].sealed=true;building_=-1;}
+ void layer(int layer,const float* rows,int n,sycl::queue& q){affinity(q);if(!rows||building_<0||layer<lb_||layer>=le_||n!=int(graphs_[building_].layout.words[0])||graphs_[building_].copied[size_t(layer)])throw std::invalid_argument("batch observer duplicate/missing layer descriptor");
+  for(int t=0;t<n;++t){q.memcpy(data_+(size_t(t)*stride_+size_t(layer-lb_)*D)*4,rows+size_t(t)*D,D*4);q.memcpy(data_+epochs_offset()+(size_t(t)*(LAYERS+1)+size_t(layer))*8,data_+input_offset(),8);}graphs_[building_].copied[size_t(layer)]=true;
+ }
+ void logits(const float* rows,int n,sycl::queue& q){affinity(q);if(!rows||!head_||building_<0||n!=int(graphs_[building_].layout.words[0])||graphs_[building_].copied[LAYERS])throw std::invalid_argument("batch observer duplicate/foreign head descriptor");
+  for(int t=0;t<n;++t){q.memcpy(data_+(size_t(t)*stride_+size_t(le_-lb_)*D)*4,rows+size_t(t)*VOCAB,VOCAB*4);q.memcpy(data_+epochs_offset()+(size_t(t)*(LAYERS+1)+LAYERS)*8,data_+input_offset(),8);}graphs_[building_].copied[LAYERS]=true;
+ }
+ void stamp(sycl::queue& q){affinity(q);if(building_<0||graphs_[building_].stamped)throw std::invalid_argument("batch observer stamp outside/duplicate graph construction");for(int l=0;l<=LAYERS;++l)if(graphs_[building_].copied[size_t(l)]!=(l>=lb_&&l<le_ || (l==LAYERS&&head_)))throw std::invalid_argument("batch observer stamp before exact stage producers");
+  q.memcpy(data_+output_offset(),data_+input_offset(),sizeof(frame));q.memcpy(data_+layout_offset(),data_+constant_offset(building_),sizeof(graph_layout));graphs_[building_].stamped=true;
+ }
+ void arm(const graph_layout& layout,const identity* ids,const bool* selected,int n,bool admission,sycl::queue& q){affinity(q);if(building_>=0||(armed_graph_>=0&&published_!=input_[0]))throw std::invalid_argument("batch observer previous frame still unretired");int graph=graph_index(layout);if(graph<0||!graphs_[graph].sealed)throw std::invalid_argument("batch observer unknown/unsealed graph");
+  const uint64_t epoch=(uint64_t(uint32_t(getpid()))<<32)|++sequence_;input_=describe(ids,selected,n,admission,epoch,graph);armed_graph_=graph;failed_=false;armed_n_=n;armed_admission_=admission;
+  for(int t=0;t<n;++t){armed_ids_[size_t(t)]=ids[t];armed_selected_[size_t(t)]=selected[t];}
+  // All host sources below are persistent members. Re-arm requires a previously completed dump/queue drain.
+  q.memcpy(data_+input_offset(),input_.data(),sizeof(frame));q.memcpy(data_+output_offset(),zero_frame_.data(),sizeof(frame));q.memcpy(data_+layout_offset(),&zero_layout_,sizeof(graph_layout));q.memcpy(data_+epochs_offset(),zero_epochs_.data(),sizeof(zero_epochs_));
+ }
+ bool dump(const identity* ids,const bool* selected,int n,bool admission,std::string& err){
+  if(failed_||armed_graph_<0||published_==input_[0]){err="batch observer failed/unarmed/duplicate frame";return false;}
+  bool completed=false;struct failure_guard{bool& failed;bool& completed;~failure_guard(){if(!completed)failed=true;}}guard{failed_,completed};
+  try{if(describe(ids,selected,n,admission,input_[0],armed_graph_)!=input_){err="batch observer changed RID/enginegen/slotgen/row/position frame";return false;}}catch(const std::exception& e){err=e.what();return false;}
+  frame output{};graph_layout actual;std::array<uint64_t,EPOCHS> epochs{};q_.memcpy(output.data(),data_+output_offset(),sizeof(frame));q_.memcpy(&actual,data_+layout_offset(),sizeof(actual));q_.memcpy(epochs.data(),data_+epochs_offset(),sizeof(epochs)).wait_and_throw();
+  if(output!=input_ || !(actual==graphs_[armed_graph_].layout)){err="batch observer missing/stale/wrong-layout graph replay marker";return false;}
+  for(int t=0;t<ROWS;++t)for(int l=0;l<=LAYERS;++l){const bool expected=t<n&&(l>=lb_&&l<le_ || (l==LAYERS&&head_));if(epochs[size_t(t)*(LAYERS+1)+size_t(l)]!=(expected?input_[0]:0)){err="batch observer partial/foreign producer row/layer/head epoch";return false;}}
+  std::fprintf(stderr,"SBF replay pid=%ld enginegen=%llu stage=%d lb=%d le=%d epoch=%llu graph=%d event=%llu rows=%d admission=%d active_mask=%llu selected_mask=%llu full_roster=1 input_output_verified=1 stage_context_verified=1 geometry=48x4x2560x248320\n",long(getpid()),(unsigned long long)engine_generation(),stage_,lb_,le_,(unsigned long long)input_[0],armed_graph_,(unsigned long long)armed_ids_[0].event,n,admission,(unsigned long long)input_[7],(unsigned long long)input_[8]);
+  for(int t=0;t<n;++t){const auto& id=ids[t];std::fprintf(stderr,"SBF row pid=%ld enginegen=%llu stage=%d lb=%d le=%d epoch=%llu graph=%d event=%llu admission=%d rid=%llu requestgen=%llu slot=%d slotgen=%llu pos=%lld token=%d row=%d batchrows=%d selected=%d\n",long(getpid()),(unsigned long long)id.enginegen,stage_,lb_,le_,(unsigned long long)input_[0],armed_graph_,(unsigned long long)id.event,admission,(unsigned long long)id.rid,(unsigned long long)id.generation,id.slot,(unsigned long long)id.slotgen,(long long)id.pos,id.token,t,n,selected[t]);}
+  for(int t=0;t<n;++t)if(selected[t]){for(int l=lb_;l<le_;++l){std::vector<float> raw(D);q_.memcpy(raw.data(),data_+(size_t(t)*stride_+size_t(l-lb_)*D)*4,D*4).wait_and_throw();if(!store(ids[t],stage_,lb_,le_,l,admission?"admission_residual":"batch_step_residual",raw,err,input_[0],armed_graph_))return false;}
+   if(head_){std::vector<float> raw(VOCAB);q_.memcpy(raw.data(),data_+(size_t(t)*stride_+size_t(le_-lb_)*D)*4,VOCAB*4).wait_and_throw();if(!store(ids[t],stage_,lb_,le_,-1,admission?"admission_logits_before_sampler":"batch_step_logits_before_sampler",raw,err,input_[0],armed_graph_))return false;}}
+  published_=input_[0];completed=true;return true;
+ }
+ // A cancelled/unpublished frame retires only after the owning queue drains; no vectors or ledger completion.
+ void discard(){q_.wait_and_throw();armed_graph_=-1;failed_=false;input_.fill(0);}
+};
+}
