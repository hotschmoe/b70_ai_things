+  for(std::size_t i=0;i<r.ids.size();++i)std::fprintf(meta,"%s%lld",i?",":"",(long long)r.ids[i]);std::fprintf(meta,"],\"fields\":[");bool ok=true;int count=0;const char*names[]={"input","attention","ffn"};
