+// Immutable stage/device mirror owner. Graphs retain shared ownership through VerifyHits.
+#pragma once
+#include <sycl/sycl.hpp>
+#include <cstdint>
+#include <vector>
+#include <string>
+#include <mutex>
+namespace strata::core {
+struct StageExpertMirror {
+    explicit StageExpertMirror(const sycl::queue& queue):q(queue) {}
+    StageExpertMirror(const StageExpertMirror&)=delete;
+    StageExpertMirror& operator=(const StageExpertMirror&)=delete;
+    ~StageExpertMirror() {
+        // Explicit normal shutdown calls release() and propagates failures.
+        // Destruction is a failure-path fallback and must not throw.
+        try { release(); } catch (...) {}
+    }
+    void release() {
+        // Called only after all graph references retire. The retained queue owns
+        // the original context regardless of the current device at teardown.
+        q.wait_and_throw();
+        if (table) { sycl::free(table,q); table=nullptr; }
+        if (host) { sycl::free(host,q); host=nullptr; }
+    }
+    sycl::queue q;
+    uint8_t* host=nullptr;
+    unsigned long long* table=nullptr;
+    uint64_t bytes=0;
+    int64_t lb=0,le=0,n_layers=0,n_expert=0;
+    const int32_t* residency=nullptr;
+    mutable std::mutex association_mu;
+    std::vector<uint64_t> source_fnv64; // full [layer,expert] original blob checksums;0 absent
+    bool bind(const int32_t* res,int64_t layers,int64_t experts,const sycl::queue& queue,std::string& err) {
+        const std::lock_guard<std::mutex> lock(association_mu);
+        if (!res || layers!=n_layers || experts!=n_expert || queue.get_context()!=q.get_context() ||
+            queue.get_device()!=q.get_device() || (residency && residency!=res)) {
+            err="stage mirror: residency/device/context association mismatch"; return false;
+        }
+        residency=res; return true;
+    }
+    bool matches(const int32_t* res,int64_t layers,int64_t experts,const sycl::queue& queue) const {
+        const std::lock_guard<std::mutex> lock(association_mu);
+        return residency && residency==res && layers==n_layers && experts==n_expert &&
+            queue.get_context()==q.get_context() && queue.get_device()==q.get_device();
+    }
+    const unsigned long long* layer_table(int64_t layer) const {
+        return table && layer>=lb && layer<le ? table+size_t(layer)*size_t(n_expert):nullptr;
+    }
+};
