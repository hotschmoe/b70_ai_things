+// CPU-testable process-wide host budget: one snapshot, all stages share remaining().
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <limits>
+#include <cstdlib>
+#include <cerrno>
+#include <string>
+namespace strata::core {
+inline bool stage_mirror_mib(const char* value,uint64_t fallback,uint64_t& out,std::string& err) {
+    if (!value) { out=fallback; return true; }
+    if (!*value) { err="stage mirror: empty MiB budget"; return false; }
+    for (const char* p=value;*p;++p) if (*p<'0' || *p>'9') { err="stage mirror: invalid MiB budget"; return false; }
+    errno=0; char* end=nullptr; const unsigned long long n=std::strtoull(value,&end,10);
+    if (errno || *end || n>(std::numeric_limits<uint64_t>::max()>>20)) { err="stage mirror: MiB budget overflow"; return false; }
+    out=uint64_t(n)<<20; return true;
+}
+struct StageMirrorBudget {
+    uint64_t cap=0,used=0;
+    static bool make(uint64_t available,uint64_t requested,const uint64_t* reserves,size_t n,
+                     uint64_t metadata,StageMirrorBudget& out) {
+        uint64_t keep=metadata;
+        for (size_t i=0;i<n;++i) {
+            if (reserves[i]>std::numeric_limits<uint64_t>::max()-keep) return false;
+            keep+=reserves[i];
+        }
+        const uint64_t room=available>keep?available-keep:0;
+        out.cap=requested<room?requested:room; out.used=0; return true;
+    }
+    uint64_t remaining() const { return cap-used; }
+    bool commit(uint64_t bytes) { if (bytes>remaining()) return false; used+=bytes; return true; }
+};
+}
