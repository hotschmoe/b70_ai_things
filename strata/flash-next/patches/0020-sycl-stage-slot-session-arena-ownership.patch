+// Stage-owned batch session allocation; no inference math or cache policy.
+#pragma once
+#include "strata/core/session.hpp"
+#include "strata/core/on_device.hpp"
+#include <dpct/dpct.hpp>
+#include <sycl/sycl.hpp>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+namespace strata::core {
+class SlotSessionArena final : public SessionState {
+public:
+    explicit SlotSessionArena(int device):device_(device),queue_(owner_queue(device)) {}
+    SlotSessionArena(const SlotSessionArena&)=delete;
+    SlotSessionArena& operator=(const SlotSessionArena&)=delete;
+    ~SlotSessionArena() noexcept {
+        try { release(); } catch(const std::exception& e) {
+            std::fprintf(stderr,"strata slot owner: device %d release failed: %s\n",device_,e.what());
+            std::fflush(stderr);std::_Exit(1);
+        }
+    }
+    bool initialize(const ModelGeometry& geometry,int64_t cells,int64_t experts,int64_t lo,int64_t hi,
+                    uint64_t bytes,std::string& error) {
+        if(base_ || qsa_states){error="slot owner already initialized";return false;}
+        if(qsa_kv_elastic()){error="slot owner does not own elastic KV registry allocations";return false;}
+        geometry_=geometry;
+        const OnDevice owner(device_);
+        try {
+            base_=sycl::malloc_device(bytes,queue_);bytes_=bytes;
+            if(!base_){bytes_=0;error="slot arena malloc_device returned null";return false;}
+            if(session_init(geometry_,cells,experts,base_,*this,lo,hi)==0) {
+                error="slot session_init returned zero";release();return false;
+            }
+            return true;
+        } catch(const std::exception& e){error=e.what();release();return false;}
+    }
+    void release() {
+        if(!base_ && !qsa_states)return;
+        const OnDevice owner(device_);queue_.wait_and_throw();
+        for(int64_t j=0;qsa_states && j<qsa_alloc;++j)
+            qsa_state_release_owned_host(qsa_states[qsa_ord0+j],(void*)&queue_);
+        delete[] qsa_states;qsa_states=nullptr;
+        if(base_){sycl::free(base_,queue_);base_=nullptr;}
+        bytes_=0;
+    }
+    void* base()const{return base_;}
+    uint64_t allocation_bytes()const{return bytes_;}
+    int device()const{return device_;}
+private:
+    static sycl::queue owner_queue(int device){const OnDevice owner(device);return dpct::get_in_order_queue();}
+    int device_;sycl::queue queue_;ModelGeometry geometry_{};void* base_=nullptr;uint64_t bytes_=0;
+};
