+#pragma once
+// Prototype only: read-only original publisher tensor views, not an admitted MTP graph.
+#include "strata/artifact/gguf_reader.hpp"
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+namespace strata::core::original_mtp53 {
+inline bool enabled() noexcept { const char* s=std::getenv("STRATA_ORIGINAL_MTP53"); return s && std::strcmp(s,"1")==0; }
+struct Spec { const char* name; uint32_t type; std::vector<uint64_t> shape; uint64_t bytes; };
+inline const std::vector<Spec>& specs() {
+    static const std::vector<Spec> values={
+        {"output.weight", 14u, {2560ull, 248320ull}, 521472000ull},
+        {"token_embd.weight", 12u, {2560ull, 248320ull}, 357580800ull},
+        {"blk.48.attn_k.weight", 12u, {2560ull, 512ull}, 737280ull},
+        {"blk.48.attn_k_norm.weight", 0u, {256ull}, 1024ull},
+        {"blk.48.attn_output.weight", 12u, {6144ull, 2560ull}, 8847360ull},
+        {"blk.48.attn_q.weight", 12u, {2560ull, 12288ull}, 17694720ull},
+        {"blk.48.attn_q_norm.weight", 0u, {256ull}, 1024ull},
+        {"blk.48.attn_v.weight", 14u, {2560ull, 512ull}, 1075200ull},
+        {"blk.48.ffn_down_exps.weight", 8u, {640ull, 2560ull, 512ull}, 891289600ull},
+        {"blk.48.ffn_down_shexp.weight", 8u, {640ull, 2560ull}, 1740800ull},
+        {"blk.48.ffn_gate_exps.weight", 12u, {2560ull, 640ull, 512ull}, 471859200ull},
+        {"blk.48.ffn_gate_inp.weight", 0u, {2560ull, 512ull}, 5242880ull},
+        {"blk.48.ffn_gate_inp_shexp.weight", 0u, {2560ull}, 10240ull},
+        {"blk.48.ffn_gate_shexp.weight", 12u, {2560ull, 640ull}, 921600ull},
+        {"blk.48.ffn_up_exps.weight", 12u, {2560ull, 640ull, 512ull}, 471859200ull},
+        {"blk.48.ffn_up_shexp.weight", 12u, {2560ull, 640ull}, 921600ull},
+        {"blk.48.hc_attn_down.weight", 12u, {10240ull, 320ull}, 1843200ull},
+        {"blk.48.hc_attn_inject.weight", 12u, {10240ull, 4ull}, 23040ull},
+        {"blk.48.hc_attn_norm.weight", 0u, {10240ull}, 40960ull},
+        {"blk.48.hc_attn_up.weight", 6u, {320ull, 10240ull}, 2252800ull},
+        {"blk.48.hc_ffn_down.weight", 14u, {10240ull, 320ull}, 2688000ull},
+        {"blk.48.hc_ffn_inject.weight", 12u, {10240ull, 4ull}, 23040ull},
+        {"blk.48.hc_ffn_norm.weight", 0u, {10240ull}, 40960ull},
+        {"blk.48.hc_ffn_up.weight", 6u, {320ull, 10240ull}, 2252800ull},
+        {"blk.48.indexer.k_norm.weight", 0u, {128ull}, 512ull},
+        {"blk.48.indexer.k_proj.weight", 30u, {2560ull, 128ull}, 655360ull},
+        {"blk.48.indexer.q_norm.weight", 0u, {128ull}, 512ull},
+        {"blk.48.indexer.q_proj.weight", 30u, {2560ull, 512ull}, 2621440ull},
+        {"blk.48.nextn.eh_proj.weight", 12u, {5120ull, 2560ull}, 7372800ull},
+        {"blk.48.nextn.enorm.weight", 0u, {2560ull}, 10240ull},
+        {"blk.48.nextn.hc_head_down.weight", 12u, {10240ull, 320ull}, 1843200ull},
+        {"blk.48.nextn.hc_head_norm.weight", 0u, {10240ull}, 40960ull},
+        {"blk.48.nextn.hc_head_up.weight", 6u, {320ull, 10240ull}, 2252800ull},
+        {"blk.48.nextn.hnorm.weight", 0u, {10240ull}, 40960ull},
+    };
+    return values;
+}
+struct View { const void* readonly_gguf_bytes; uint32_t type; std::vector<uint64_t> shape; uint64_t bytes; };
+class TensorViews {
+    std::unique_ptr<strata::GgufFile> file_;
+public:
+    // Root must freshly verify the locked whole-file SHA before this call. This method
+    // checks the original schema/bounds; it does not claim cryptographic payload identity.
+    // GGUF uses PROT_READ mapping. There is no conversion, device upload, head borrowing,
+    // +1 norm adjustment, query, graph capture, or model-state modification here.
+    bool load(const std::string& path, std::string& err) try {
+        if (!enabled()) { err="original MTP53 is default OFF"; return false; }
+        if (file_) { err="original MTP53 already loaded"; return false; }
+        auto next=std::make_unique<strata::GgufFile>(path);
+        strata::Qwen4ExpGuard guard; guard.block_count=49;guard.experts=512;guard.experts_used=10;
+        err=strata::check_architecture(*next,guard); if (!err.empty()) return false;
+        const auto* count=next->get("qwen4exp.nextn_predict_layers");
+        if (!count || count->u!=1 || next->tensors().size()!=34 || next->file_size()!=2786204800ull) {
+            err="original publisher MTP53 requires exact one-layer/34-tensor self-contained schema";return false;
+        }
+        std::set<std::string> seen;
+        for (const auto& t:next->tensors()) if (!seen.insert(t.name).second) { err="duplicate MTP53 tensor";return false; }
+        for (const auto& want:specs()) {
+            const auto* t=next->find(want.name);
+            if (!t || t->type!=want.type || t->shape!=want.shape || strata::tensor_payload_bytes(*t)!=want.bytes ||
+                t->offset>next->file_size()-next->data_start() || want.bytes>next->file_size()-next->data_start()-t->offset) {
+                err=std::string("original MTP53 exact tensor mismatch: ")+want.name;return false;
+            }
+        }
+        file_=std::move(next);return true;
+    } catch(const std::exception& e) { err=e.what();return false; }
+    View at(const std::string& name) const {
+        if (!enabled() || !file_) throw std::runtime_error("original MTP53 not enabled/loaded");
+        const auto* t=file_->find(name);if (!t) throw std::runtime_error("original MTP53 unknown tensor");
+        return {file_->tensor_data(*t),t->type,t->shape,strata::tensor_payload_bytes(*t)};
+    }
+    static constexpr uint64_t conservative_weight_reserve_bytes=2775258112ull;
+    // Caller owns any USM uploads/copies until all dependent operations retire.
+    // This object must outlive users of returned read-only host views.
+};
+}
diff --git a/sycl/include/strata/kernels/original_mtp53_typed_primitives.hpp b/sycl/include/strata/kernels/original_mtp53_typed_primitives.hpp
new file mode 100644
--- /dev/null
+++ b/sycl/include/strata/kernels/original_mtp53_typed_primitives.hpp
@@ -0,0 +1,66 @@
+#pragma once
+// Source-only building blocks, NOT a complete/original-parity MTP implementation.
+#include "strata/core/original_mtp53_tensor_views.hpp"
+#include "strata/kernels/native_mmvq.hpp"
+#include "strata/kernels/iq_kernels.hpp"
+#include "strata/kernels/bf16_gemv.hpp"
+#include "strata/sycl_queue.hpp"
+#include <sycl/sycl.hpp>
+#include <stdexcept>
+namespace strata::kernels::original_mtp53 {
+inline void require_on() {
+    if (!strata::core::original_mtp53::enabled()) throw std::runtime_error("original MTP53 is default OFF");
+}
+// Caller-owned, disjoint USM pointers in the stream's context; raw GGUF mapped
+// pointers must first be copied/uploaded to legal USM. No allocations/waits/queries.
+// scratch_q8_1 must hold native_q8_1_bytes(n_in,ncols). No weight requantization.
+inline void quant_linear(int type,const void* weights,const float* x,void* scratch_q8_1,
+                         float* y,int n_in,int n_out,int ncols,void* stream) {
+    require_on();
+    if (!weights || !x || !scratch_q8_1 || !y || !stream || ncols<1 || ncols>8 || n_in<=0 || n_out<=0 ||
+        (type!=6 && type!=8 && type!=12 && type!=14) || native_mmvq_weight_bytes(type,n_in,n_out)==0)
+        throw std::invalid_argument("original MTP53 quant-linear geometry/type");
+    native_quantize_q8_1(x,scratch_q8_1,n_in,ncols,stream);
+    native_mmvq(type,weights,scratch_q8_1,y,n_in,n_out,ncols,stream);
+}
+inline void own_embedding(const void* q4k_table,const int32_t* token_ids,float* output,int ncols,void* stream) {
+    require_on();if (!q4k_table || !token_ids || !output || !stream || ncols<1 || ncols>8)
+        throw std::invalid_argument("original MTP53 own embedding arguments");
+    // Original self-contained table; never set/use the global main NativeEmbed.
+    iq_embed_rows(12,q4k_table,1440,token_ids,ncols,2560,output,stream);
+}
+inline void own_head(const void* q6k_head,const float* x,void* scratch,float* logits,int ncols,void* stream) {
+    quant_linear(14,q6k_head,x,scratch,logits,2560,248320,ncols,stream);
+}
+inline void bf16_linear(const uint16_t* raw_weights,const float* x,float* y,int n_out,int ncols,void* stream) {
+    require_on();if (!raw_weights || !x || !y || !stream || (n_out!=128 && n_out!=512) || ncols<1 || ncols>8)
+        throw std::invalid_argument("original MTP53 BF16 indexer arguments");
+    bf16_gemv_fp32_mmvf_multi(x,2560,raw_weights,y,n_out,2560,n_out,ncols,stream);
+}
+// Missing type in native_mmvq: original F32 router [2560,512] and shared gate [2560].
+// This new bounded primitive keeps F32 weights; declared serial FMA order is a
+// diagnostic contract, not claimed equivalent to another backend's reduction.
+class F32Linear53;
+inline void f32_linear(const float* raw_weights,const float* x,float* y,int n_out,int ncols,void* stream) {
+    require_on();if (!raw_weights || !x || !y || !stream || (n_out!=1 && n_out!=512) || ncols<1 || ncols>8)
+        throw std::invalid_argument("original MTP53 F32 router arguments");
+    auto& q=strata::q_of(stream);
+    q.parallel_for<F32Linear53>(sycl::range<1>(static_cast<size_t>(n_out)*ncols),[=](sycl::id<1> id) {
+        const size_t index=id[0],row=index%n_out,col=index/n_out;float sum=0.0f;
+        for (int i=0;i<2560;++i) sum=sycl::fma(raw_weights[row*2560+i],x[col*2560+i],sum);
+        y[index]=sum;
+    });
+}
+// Exact original expert types/shapes; caller selects one expert's raw block views.
+// gate/up each640 rows x2560 Q4_K (921600B); down2560 rows x640 Q8_0 (1740800B).
+inline void one_expert(const void* gate_q4k,const void* up_q4k,const void* down_q8,
+                       const float* x,void* xq,float* gate,float* up,void* uq,float* out,void* stream) {
+    require_on();if (!gate_q4k || !up_q4k || !down_q8 || !x || !xq || !gate || !up || !uq || !out || !stream)
+        throw std::invalid_argument("original MTP53 expert pointers");
+    native_quantize_q8_1(x,xq,2560,1,stream);
+    native_mmvq(12,gate_q4k,xq,gate,2560,640,1,stream);
+    native_mmvq(12,up_q4k,xq,up,2560,640,1,stream);
+    native_swiglu_quantize_q8_1(gate,up,uq,640,1,stream);
+    native_mmvq(8,down_q8,uq,out,640,2560,1,stream);
+}
+}
diff --git a/sycl/include/strata/kernels/original_mtp53_eh_hc_front.hpp b/sycl/include/strata/kernels/original_mtp53_eh_hc_front.hpp
new file mode 100644
--- /dev/null
+++ b/sycl/include/strata/kernels/original_mtp53_eh_hc_front.hpp
@@ -0,0 +1,75 @@
+#pragma once
+// Original qwen4exp MTP input/EH and attention-HC read segment, T=1.
+// Implements graph_mtp/build_hc_mix order, not the historical split-FC substitute.
+#include "strata/kernels/original_mtp53_typed_primitives.hpp"
+#include "strata/kernels/native_qsa.hpp"
+#include "strata/kernels/elementwise.hpp"
+namespace strata::kernels::original_mtp53 {
+struct EhHcWeights {
+    const void* own_embedding_q4k;       // token_embd.weight [2560,248320]
+    const float* enorm;                 // blk.48.nextn.enorm.weight [2560]
+    const float* hnorm;                 // blk.48.nextn.hnorm.weight [10240], per stream
+    const void* eh_proj_q4k;            // blk.48.nextn.eh_proj.weight [5120,2560]
+    const float* hc_norm;               // blk.48.hc_attn_norm.weight [10240]
+    const void* hc_down_q4k;            // blk.48.hc_attn_down.weight [10240,320]
+    const void* hc_up_q5_0;             // blk.48.hc_attn_up.weight [320,10240]
+    const void* hc_inject_q4k;          // blk.48.hc_attn_inject.weight [10240,4]
+};
+struct EhHcScratch {
+    float* embedding;                  // 2560
+    float* e_norm;                     // 2560
+    float* h_norm;                     // 10240
+    float* concat_eh;                  // 4 rows of5120, E FIRST then H per stream
+    float* residual;                   // 10240; tentative EH result
+    float* hc_normalized;              // 10240
+    float* low;                        // 320; scaled then SiLU
+    float* gate;                       // 10240
+    float* weighted_streams;           // 10240; materialized product before mean
+    float* mixed;                      // 2560
+    float* injection;                  // 4, raw HC write gate, not sigmoid yet
+    void* q8_1;                        // >= max(native_q8_1_bytes(5120,4),(...10240,1))
+};
+class ConcatEH53;
+class GateProducts53;
+class MeanStreams53;
+// All inputs/weights/scratch must be legal USM in stream context, properly aligned
+// and pairwise disjoint. token_id is one validated device ID in[0,248320).
+// hidden is immutable [stream][channel]; this segment never modifies cache/state.
+// F32 norm weights already carry the GGUF converter's(1+w): do NOT add1.
+inline void eh_hc_front(const int32_t* token_id,const float* hidden,const EhHcWeights& w,
+                        const EhHcScratch& s,void* stream) {
+    require_on();
+    if (!token_id || !hidden || !stream || !w.own_embedding_q4k || !w.enorm || !w.hnorm || !w.eh_proj_q4k ||
+        !w.hc_norm || !w.hc_down_q4k || !w.hc_up_q5_0 || !w.hc_inject_q4k ||
+        !s.embedding || !s.e_norm || !s.h_norm || !s.concat_eh || !s.residual || !s.hc_normalized ||
+        !s.low || !s.gate || !s.weighted_streams || !s.mixed || !s.injection || !s.q8_1)
+        throw std::invalid_argument("original MTP53 EH/HC arguments");
+    auto& q=strata::q_of(stream);
+    own_embedding(w.own_embedding_q4k,token_id,s.embedding,1,stream);
+    // Original build_norm h reshaped[N,HC,T]: one RMS perN, gamma slice stream.
+    native_qsa_rms_norm_weighted(s.embedding,w.enorm,s.e_norm,2560,1,1e-6f,stream);
+    native_qsa_rms_norm_grouped(hidden,w.hnorm,s.h_norm,2560,4,4,1e-6f,stream);
+    const float* e=s.e_norm;const float* h=s.h_norm;float* concat=s.concat_eh;
+    q.parallel_for<ConcatEH53>(sycl::range<1>(20480),[=](sycl::id<1> id){
+        const size_t at=id[0],stream_id=at/5120,channel=at%5120;
+        concat[at]=channel<2560?e[channel]:h[stream_id*2560+channel-2560];
+    });
+    // ONE combined original Q4_K matrix; never split into FC_embedding/FC_hidden.
+    quant_linear(12,w.eh_proj_q4k,s.concat_eh,s.q8_1,s.residual,5120,2560,4,stream);
+    native_qsa_rms_norm_grouped(s.residual,w.hc_norm,s.hc_normalized,2560,4,4,1e-6f,stream);
+    quant_linear(12,w.hc_down_q4k,s.hc_normalized,s.q8_1,s.low,10240,320,1,stream);
+    scale_inplace(s.low,320,0.25f,stream);silu_inplace(s.low,320,stream);
+    quant_linear(6,w.hc_up_q5_0,s.low,s.q8_1,s.gate,320,10240,1,stream);
+    const float* xn=s.hc_normalized;const float* gate=s.gate;float* products=s.weighted_streams;
+    // Materialize sigmoid product as the original unfused ggml_mul graph does.
+    // Numeric backend exp/reduction parity remains an actual fixture question.
+    q.parallel_for<GateProducts53>(sycl::range<1>(10240),[=](sycl::id<1> id){
+        const size_t at=id[0];const float sigmoid=1.0f/(1.0f+sycl::exp(-gate[at]));products[at]=xn[at]*sigmoid;
+    });
+    const float* product=s.weighted_streams;float* mixed=s.mixed;
+    q.parallel_for<MeanStreams53>(sycl::range<1>(2560),[=](sycl::id<1> id){
+        const size_t d=id[0];float sum=product[d];sum=sum+product[2560+d];sum=sum+product[5120+d];sum=sum+product[7680+d];mixed[d]=sum*0.25f;
+    });
+    quant_linear(12,w.hc_inject_q4k,s.hc_normalized,s.q8_1,s.injection,10240,4,1,stream);
+}
+}
diff --git a/sycl/include/strata/kernels/original_mtp53_qsa_state.hpp b/sycl/include/strata/kernels/original_mtp53_qsa_state.hpp
new file mode 100644
--- /dev/null
+++ b/sycl/include/strata/kernels/original_mtp53_qsa_state.hpp
@@ -0,0 +1,106 @@
+#pragma once
+// Isolated draft-owned T1 compress4 QSA state/attention segment. No main state/globals.
+#include "strata/kernels/original_mtp53_eh_hc_front.hpp"
+#include "strata/kernels/native_qsa_indexer.hpp"
+#include "strata/kernels/native_rope.hpp"
+#include "strata/kernels/qsa_decode_attn.hpp"
+#include "strata/kernels/qsa_select.hpp"
+#include <algorithm>
+namespace strata::kernels::original_mtp53 {
+struct DraftBank {
+    uint16_t* key;uint16_t* value; // [page][2KVheads][4cells][256], max_cells*512 each
+    float* tail;float* dead;float* pooled;int32_t* block_pos; // 384,128,(max_cells/4+2)*128,1
+};
+struct QsaWeights {
+    const void* query_q4k;const void* key_q4k;const void* value_q6k;const void* output_q4k;
+    const float* query_norm;const float* key_norm;
+    const uint16_t* index_query_bf16;const uint16_t* index_key_bf16;
+    const float* index_query_norm;const float* index_key_norm;
+};
+struct QsaScratch {
+    float* query_full;float* query;float* key;float* value; //12288,6144,512,512
+    float* index_raw;uint16_t* index_half;float* index_expanded;float* index_query; //128,128,128,512
+    float* scores;int32_t* selected;float* attention_scratch;float* attention;float* gated;float* output;
+    void* q8_1; // native_q8_1_bytes(6144,1); output projection is largest input
+};
+class StoreRawHalf53;class LoadRawHalf53;class SelectOriginalBlocks53;
+// Full-bank copying is a deliberately simple diagnostic transaction, NOT a latency optimization.
+inline void copy_bank(const DraftBank& from,const DraftBank& to,int max_cells,sycl::queue& q){
+    require_on();q.memcpy(to.key,from.key,size_t(max_cells)*512*2);q.memcpy(to.value,from.value,size_t(max_cells)*512*2);
+    q.memcpy(to.tail,from.tail,384*4);q.memcpy(to.dead,from.dead,128*4);q.memcpy(to.pooled,from.pooled,size_t(max_cells/4+2)*128*4);q.memcpy(to.block_pos,from.block_pos,4);
+}
+// Original selection budget is512 COMPLETED blocks (=2048cells), plus incomplete tail.
+// This preserves compress4 rather than substituting current state's constant2051-cell budget.
+// Ties use lowest block ID, explicit diagnostic tie contract; original backend parity must be tested.
+inline void select_original_blocks(const float* scores,const int32_t* step,int32_t* ids,int max_blocks,void* stream){
+    require_on();if(!stream)throw std::invalid_argument("draft53 explicit stream required");auto& q=strata::q_of(stream);
+    q.single_task<SelectOriginalBlocks53>([=]{
+        int chosen[512];float values[512];int have=0;const int n_bid=step[kStepNBid],n_kv=step[kStepNKv];
+        for(int block=0;block<n_bid && block<max_blocks;++block){
+            const float score=scores[block];int at=have;
+            while(at>0 && (score>values[at-1] || (score==values[at-1] && block<chosen[at-1])))--at;
+            if(at<512){const int last=have<512?have:511;for(int j=last;j>at;--j){chosen[j]=chosen[j-1];values[j]=values[j-1];}chosen[at]=block;values[at]=score;if(have<512)++have;}
+        }
+        // Attention selection rows are emitted in cache order; output order does not change softmax set.
+        for(int i=1;i<have;++i){int value=chosen[i],j=i;while(j>0 && chosen[j-1]>value){chosen[j]=chosen[j-1];--j;}chosen[j]=value;}
+        int out=0;for(int i=0;i<have;++i)for(int member=0;member<4;++member)ids[out++]=chosen[i]*4+member;
+        for(int cell=n_bid*4;cell<n_kv;++cell)ids[out++]=cell;
+        // step's width is prepared explicitly to this SAME cardinality.
+    });
+}
+class DraftQsaTransaction {
+    DraftBank committed_,working_;int max_cells_;int cells_=0;bool pending_=false;
+    // Persistent caller-owned USM-host staging survives graph capture/replay. Never stack-copy sources.
+    int32_t* host_step_;int32_t* host_position_;int32_t* step_;int32_t* positions_;const int32_t* own_pages_;
+public:
+    DraftQsaTransaction(DraftBank committed,DraftBank working,int max_cells,int32_t* host_step,int32_t* host_positions,
+                        int32_t* step,int32_t* positions,const int32_t* own_pages):committed_(committed),working_(working),max_cells_(max_cells),host_step_(host_step),host_position_(host_positions),step_(step),positions_(positions),own_pages_(own_pages){
+        require_on();if(max_cells<4 || max_cells>4096 || max_cells%4 || !host_step || !host_positions || !step || !positions || !own_pages)throw std::invalid_argument("draft53 bounded own state/staging required");
+        struct Span{uintptr_t first,last;};std::vector<Span> spans;
+        auto add=[&](const void* p,size_t bytes){const auto start=reinterpret_cast<uintptr_t>(p);if(!p || start%4 || bytes>UINTPTR_MAX-start)throw std::invalid_argument("draft53 aligned bank span");Span next{start,start+bytes};for(const auto& old:spans)if(next.first<old.last && old.first<next.last)throw std::invalid_argument("draft53 state banks alias");spans.push_back(next);};
+        for(const auto& bank:{committed,working}){add(bank.key,size_t(max_cells)*512*2);add(bank.value,size_t(max_cells)*512*2);add(bank.tail,384*4);add(bank.dead,128*4);add(bank.pooled,size_t(max_cells/4+2)*128*4);add(bank.block_pos,4);}
+    }
+    // Caller zero-initializes BOTH banks and owns a complete identity page table independently of main.
+    // Prepare only after previous draft and actual main verifier decisions are terminal; no fake callback.
+    void prepare(void* stream){
