diff --git a/sycl/include/strata/core/original_mtp53_owned_runtime.hpp b/sycl/include/strata/core/original_mtp53_owned_runtime.hpp
new file mode 100644
--- /dev/null
+++ b/sycl/include/strata/core/original_mtp53_owned_runtime.hpp
