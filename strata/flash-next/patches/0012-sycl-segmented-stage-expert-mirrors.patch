+// CPU-testable expert-preserving segment plan. No allocation or source conversion.
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <utility>
+#include <vector>
+#include <string>
+#include <limits>
+namespace strata::core {
+struct StageMirrorLocation { size_t segment=0; uint64_t offset=0; };
+struct StageMirrorSegmentPlan {
+    std::vector<uint64_t> sizes;
+    std::vector<StageMirrorLocation> locations;
+    uint64_t bytes=0;
+    static bool make(const std::vector<uint64_t>& padded,uint64_t limit,
+                     StageMirrorSegmentPlan& out,std::string& error) {
+        if (!limit || limit>(uint64_t(1)<<30) || limit%256) {
+            error="stage mirror: segment limit must be aligned and at most1GiB";return false;
+        }
+        StageMirrorSegmentPlan plan;
+        for(uint64_t n:padded) {
+            if(!n || n%256 || n>limit || n>std::numeric_limits<uint64_t>::max()-plan.bytes) {
+                error="stage mirror: invalid padded expert extent or segment/total overflow";return false;
+            }
+            if(plan.sizes.empty() || n>limit-plan.sizes.back()) plan.sizes.push_back(0);
+            plan.locations.push_back({plan.sizes.size()-1,plan.sizes.back()});
+            plan.sizes.back()+=n;plan.bytes+=n;
+        }
+        out=std::move(plan);return true;
+    }
+};
+}
