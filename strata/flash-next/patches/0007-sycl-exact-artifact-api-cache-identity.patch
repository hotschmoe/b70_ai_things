+// CPU-testable disk-session math contract for the SYCL source route.
+#pragma once
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <initializer_list>
+namespace strata::core {
+inline bool sycl_api_state_identity(std::string& out,std::string& error) {
+    out="sycl-state-contract-v7";
+    const char* digest=std::getenv("STRATA_ARTIFACT_IDENTITY_SHA256");
+    if (digest) {
+        if (std::strlen(digest)!=64) { error="session identity: artifact digest length"; return false; }
+        for (const char* p=digest;*p;++p) if (!(*p>='0' && *p<='9') && !(*p>='a' && *p<='f')) {
+            error="session identity: artifact digest encoding"; return false;
+        }
+        out+="|artifact=";out+=digest;
+    }
+    const char* native=std::getenv("STRATA_SYCL_NATIVE_HC");
+    if (native && std::strcmp(native,"1")==0 && !digest) {
+        error="session identity: native HC disk sessions require artifact identity manifest"; return false;
+    }
+    for (const char* name : {"STRATA_SYCL_NATIVE_HC","STRATA_HC_Q8","STRATA_HC_Q8_INJECT","STRATA_GR_V3",
+        "STRATA_QFUSE","STRATA_GR_UNFUSED","STRATA_PF_HCDOWN","STRATA_HCD_EXACT","STRATA_HC_UPMIX",
+        "STRATA_STAGE_MIRRORS","SYCL_PROGRAM_COMPILE_OPTIONS"}) {
+        const char* value=std::getenv(name);
+        const std::string text=value?value:"<unset>";
+        out+="|";out+=name;out+="=";out+=std::to_string(text.size());out+=":";out+=text;
+    }
+    return true;
+}
+}
