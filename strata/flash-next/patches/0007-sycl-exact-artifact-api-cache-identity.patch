@@ -0,0 +1,111 @@
+"""Optional strict GGUF/API identity. No generic tokenizer/template fallback in this mode."""
+from pathlib import Path
+import hashlib
+import json
+import sys
+import platform
+from importlib.metadata import version as package_version
+
+PRIMARY="hotschmoe-dd"
+SOURCE_REPO="unsloth/Qwen3.8-Flash-Next-GGUF"
+SOURCE_REVISION="766911a6b7369840a91dbcd95f9f997acaab6cd6"
+TOKENIZER_GGUF_SHA256="4448186216b3af4cc558bbce2c3213f01608f8f8b2e5267a9767971dd3ec8082"
+FILES=("vocab.json","merges.txt","token_type.json","tokenizer.json","chat_template.jinja")
+ENV_PREFIXES=("STRATA_","SYCL_","ONEAPI_")
+IDENTITY_ENV="STRATA_ARTIFACT_IDENTITY_SHA256"
+PYTHON_SOURCES=("serve/server.py","serve/frontend.py","serve/artifact_identity.py","tools/strata_tokenizer.py","tools/gguf_reader.py")
+
+
+def python_contract():
+    return {"python":platform.python_version(),**{name:package_version(name) for name in ("regex","jinja2","markupsafe")}}
+
+
+def source_contract():
+    root=Path(__file__).resolve().parents[1]
+    return {name:sha256_file(root/name) for name in PYTHON_SOURCES}
+
+
+def sha256_file(path):
+    h=hashlib.sha256()
+    with Path(path).open("rb") as source:
+        for block in iter(lambda:source.read(1024*1024),b""): h.update(block)
+    return h.hexdigest()
+
+
+def runtime_environment(env):
+    return {k:str(v) for k,v in sorted(env.items()) if k.startswith(ENV_PREFIXES) and k!=IDENTITY_ENV}
+
+
+def load_identity(cfg,tpath):
+    name=cfg.get("artifact_identity_manifest")
+    if not name: return None
+    path=Path(name)
+    if not path.is_absolute(): path=Path(cfg.get("cwd") or ".")/path
+    raw=path.read_bytes(); manifest=json.loads(raw)
+    if manifest.get("schema")!=1 or manifest.get("primary_model_name")!=PRIMARY:
+        raise ValueError("artifact identity: unsupported schema or primary model name")
+    alias=manifest.get("research_alias")
+    if not isinstance(alias,str) or not alias.strip() or alias==PRIMARY:
+        raise ValueError("artifact identity: detailed research alias missing")
+    if cfg.get("model_name",PRIMARY)!=PRIMARY:
+        raise ValueError("artifact identity: model_name must be hotschmoe-dd")
+    supplied=cfg.get("aliases",[alias])
+    if isinstance(supplied,str): supplied=[x.strip() for x in supplied.split(",") if x.strip()]
+    if supplied!=[alias]: raise ValueError("artifact identity: aliases differ from exact artifact contract")
+    cfg["model_name"]=PRIMARY;cfg["aliases"]=[alias]
+    expected=manifest.get("tokenizer_files")
+    if not isinstance(expected,dict) or set(expected)!=set(FILES):
+        raise ValueError("artifact identity: all five tokenizer/template file hashes are required")
+    for file in FILES:
+        if sha256_file(Path(tpath)/file)!=expected[file]:
+            raise ValueError("artifact identity: changed tokenizer/template file "+file)
+    model=manifest["model"]
+    if (model.get("repo")!=SOURCE_REPO or model.get("revision")!=SOURCE_REVISION or
+        model.get("artifact")!="UD-Q4_K_XL" or model.get("tokenizer_gguf_sha256")!=TOKENIZER_GGUF_SHA256):
+        raise ValueError("artifact identity: selected pinned GGUF identity differs")
+    source=Path(model["tokenizer_gguf"])
+    if not source.is_absolute(): source=Path(cfg.get("cwd") or ".")/source
+    if sha256_file(source)!=model["tokenizer_gguf_sha256"]:
+        raise ValueError("artifact identity: tokenizer GGUF source differs")
+    # Validate actual consumed export arrays against original GGUF metadata, not
+    # just an internally consistent collection of hashes in a manifest.
+    sys.path.insert(0,str(Path(__file__).resolve().parents[1]/"tools"))
+    from gguf_reader import GGUFFile
+    md=GGUFFile(source).metadata
+    if md.get("tokenizer.ggml.model")!="gpt2" or md.get("tokenizer.ggml.pre")!="qwen35":
+        raise ValueError("artifact identity: unsupported tokenizer model/pre")
+    vocab=json.loads((Path(tpath)/"vocab.json").read_text(encoding="utf-8"))
+    tokens=md["tokenizer.ggml.tokens"]
+    if len(vocab)!=len(tokens) or any(vocab.get(token)!=i for i,token in enumerate(tokens)):
+        raise ValueError("artifact identity: token IDs differ from GGUF")
+    if (Path(tpath)/"merges.txt").read_text(encoding="utf-8").split("\n")!=md["tokenizer.ggml.merges"]:
+        raise ValueError("artifact identity: merge order differs from GGUF")
+    types=json.loads((Path(tpath)/"token_type.json").read_text(encoding="utf-8"))
+    if types!=md["tokenizer.ggml.token_type"]: raise ValueError("artifact identity: token types differ from GGUF")
+    settings=json.loads((Path(tpath)/"tokenizer.json").read_text(encoding="utf-8"))
+    special={k:int(v) for k,v in md.items() if k.startswith("tokenizer.ggml.") and k.endswith("_token_id")}
+    if settings.get("pre")!=md["tokenizer.ggml.pre"] or settings.get("special_ids")!=special:
+        raise ValueError("artifact identity: exported pre/special IDs differ from GGUF")
+    if md.get("tokenizer.ggml.add_bos_token",False) or settings.get("add_bos_token") is not False:
+        raise ValueError("artifact identity: BOS insertion is unsupported")
+    original=md.get("tokenizer.chat_template")
+    if not isinstance(original,str) or (Path(tpath)/"chat_template.jinja").read_bytes()!=original.encode("utf-8"):
+        raise ValueError("artifact identity: chat template differs from GGUF")
+    return {"manifest":manifest,"sha256":hashlib.sha256(raw).hexdigest(),"tokenizer_path":str(tpath),
+            "metadata":{"artifact_identity_sha256":hashlib.sha256(raw).hexdigest(),
+                        "source_revision":model["revision"],"scheme":model["artifact"],
+                        "tokenizer_gguf_sha256":model["tokenizer_gguf_sha256"],
+                        "chat_template_sha256":expected["chat_template.jinja"]}}
+
+
+def validate_runtime(identity,exe,args,env):
+    if identity is None: return
+    runtime=identity["manifest"]["runtime"]
+    if sha256_file(exe)!=runtime["exe_sha256"]: raise ValueError("artifact identity: engine executable differs")
+    if list(args)!=runtime["args"]: raise ValueError("artifact identity: engine arguments differ")
+    if runtime_environment(env)!=runtime["env"]: raise ValueError("artifact identity: engine environment differs")
+    if python_contract()!=runtime["python_versions"]: raise ValueError("artifact identity: Python/tokenizer/template dependency versions differ")
+    if source_contract()!=runtime["python_sources"]: raise ValueError("artifact identity: API/tokenizer/renderer source differs")
+    for name in FILES:
+        if sha256_file(Path(identity["tokenizer_path"])/name)!=identity["manifest"]["tokenizer_files"][name]:
+            raise ValueError("artifact identity: tokenizer/template changed before engine reload")
