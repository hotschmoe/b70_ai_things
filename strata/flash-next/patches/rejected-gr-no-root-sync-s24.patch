+// S23 probe, opt-in: STRATA_GR_NO_ROOT_SYNC=1 launches the SAME up kernel (gr_up_multi_kernel<C>, the measured default
+// cols-16 path, and its large-GRF form) without the use_root_sync launch property.  No kernel of this port uses a
+// root-group barrier (no root_group / nd_range_barrier / get_root_group anywhere under sycl/src), so the property only
+// asks the runtime for a cooperative launch; this variant measures what that costs.  Every default launch is
+// unchanged.  fused_gr_set_fast(1) selects it as well: fused_gr_bench's "fast" leg, timed and compared bit for bit
+// against the "old" (default) leg.  Not combined with STRATA_GR_UP_ILP (S15 rejected ILP): that launch is as before.
+std::atomic<int> g_up_no_root_bench{0};
+inline bool gr_no_root_sync() {
+    static const bool v = [] { const char* e = std::getenv("STRATA_GR_NO_ROOT_SYNC"); return e && e[0] == '1'; }();
+    return v || g_up_no_root_bench.load(std::memory_order_relaxed) != 0;
+}
