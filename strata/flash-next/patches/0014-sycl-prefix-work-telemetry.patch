--- /dev/null
+++ b/sycl/include/strata/program/prefix_diagnostic.hpp
@@ -0,0 +1,38 @@
+// Host-only prefix work ledger. Default off; no extra state copies, waits or math.
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <sys/stat.h>
+#include <unistd.h>
+namespace strata::program {
+struct PrefixDiagnostic {
+    bool active=false,ram_restore=false;
+    uint64_t ordinal=0,token_hash=0;
+    int64_t prompt=0,resume=0,read_from=0,prompt_rows=0,decode_rows=0,stages=0;
+    static bool enabled(){static const bool on=[] {const char* p=std::getenv("STRATA_PREFIX_DIAG");return p&&std::strcmp(p,"1")==0;}();return on;}
+    void begin(const std::vector<int64_t>& ids,int64_t stage_count){
+        if(!enabled())return;
+        static const char* arm=std::getenv("STRATA_PREFIX_DIAG_ARM");struct stat info;
+        if(!arm||::stat(arm,&info)||!S_ISREG(info.st_mode))return;
+        static uint64_t sequence=0;if(sequence>=64)return;
+        active=true;ordinal=++sequence;prompt=int64_t(ids.size());stages=stage_count;token_hash=14695981039346656037ull;
+        for(int64_t t:ids)for(unsigned b=0;b<4;++b){token_hash^=(uint32_t(t)>>(b*8))&255;token_hash*=1099511628211ull;}
+    }
+    void selection(int64_t chosen,int64_t actual_from,bool from_live,int slot,size_t bytes,size_t entries,size_t evictions,size_t checkpoints){
+        if(!active)return;resume=chosen;read_from=actual_from;
+        const char* route=actual_from==0?"cold_or_reread":ram_restore?"ram_snapshot":slot>=0?"inactive_slot":from_live?"live":"checkpoint";
+        std::fprintf(stderr,"PREFIX_DIAG {\"event\":\"selection\",\"pid\":%d,\"request\":%llu,\"prompt_tokens\":%lld,\"token_fnv_le32\":\"%016llx\",\"candidate_resume\":%lld,\"actual_reused\":%lld,\"reread\":%s,\"route\":\"%s\",\"stages\":%lld,\"parked_bytes\":%zu,\"parked_entries\":%zu,\"evictions\":%zu,\"checkpoints\":%zu}\n",int(::getpid()),(unsigned long long)ordinal,(long long)prompt,(unsigned long long)token_hash,(long long)resume,(long long)read_from,resume>0&&read_from==0?"true":"false",route,(long long)stages,bytes,entries,evictions,checkpoints);
+    }
+    void evaluated(int64_t lo,int64_t hi,const char* route){
+        if(!active)return;const int64_t a=lo<0?0:lo,b=hi<prompt?hi:prompt;const int64_t n=b>a?b-a:0;prompt_rows+=n;decode_rows+=(hi-lo)-n;
+        std::fprintf(stderr,"PREFIX_DIAG {\"event\":\"evaluated_span\",\"pid\":%d,\"request\":%llu,\"lo\":%lld,\"hi\":%lld,\"prompt_rows\":%lld,\"route\":\"%s\",\"stages\":%lld}\n",int(::getpid()),(unsigned long long)ordinal,(long long)lo,(long long)hi,(long long)n,route,(long long)stages);
+    }
+    void finish(bool cancelled,const char* reason,int64_t generated,size_t bytes,size_t entries,size_t evictions){
+        if(!active)return;
+        std::fprintf(stderr,"PREFIX_DIAG {\"event\":\"finish\",\"pid\":%d,\"request\":%llu,\"candidate_resume\":%lld,\"actual_reused\":%lld,\"evaluated_prompt_rows\":%lld,\"evaluated_decode_rows\":%lld,\"stage_prompt_rows\":%lld,\"prompt_tokens\":%lld,\"generated\":%lld,\"cancelled\":%s,\"finish\":\"%s\",\"parked_bytes\":%zu,\"parked_entries\":%zu,\"evictions\":%zu,\"coverage\":\"serial_no_mtp_whole_request_after_existing_commit_wait\"}\n",int(::getpid()),(unsigned long long)ordinal,(long long)resume,(long long)read_from,(long long)prompt_rows,(long long)decode_rows,(long long)(prompt_rows*stages),(long long)prompt,(long long)generated,cancelled?"true":"false",reason,bytes,entries,evictions);
+    }
+};
+}
