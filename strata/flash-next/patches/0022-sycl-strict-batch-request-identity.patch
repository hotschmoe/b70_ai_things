+# Host-only request/slot wire identity; no sampling/state/scheduler policy.
+import threading
+class RequestField:
+    def __init__(self,name,default):self.name=name;self.default=default
+    def __get__(self,engine,kind=None):
+        if engine is None:return self
+        if engine.batch:
+            tl=engine.__dict__.setdefault('_tl',threading.local())
+            return getattr(tl,self.name,self.default)
+        return engine.__dict__.get('_request_'+self.name,self.default)
+    def __set__(self,engine,value):
+        engine.__dict__['_request_'+self.name]=value
+        if engine.batch:setattr(engine.__dict__.setdefault('_tl',threading.local()),self.name,value)
+def tags(line,rid,generation=None):
+    values=dict(token.split('=',1) for token in line.split() if '=' in token)
+    if not {'rid','slotgen'}<=values.keys():raise ValueError('missing native request identity')
+    if not values['rid'].isdigit() or not values['slotgen'].isdigit():raise ValueError('invalid native request identity')
+    actual=(int(values['rid']),int(values['slotgen']))
+    if actual[0]!=rid or generation is not None and actual[1]!=generation:raise ValueError('stale/wrong native request-slot generation')
+    return actual
+def strict_request(sampling,embeddings):
+    sampling=sampling or {}
+    if embeddings:raise ValueError('strict batch supports text only')
+    for key,default in [('temperature',0),('repetition_penalty',1),('frequency_penalty',0),('presence_penalty',0)]:
+        if sampling.get(key,default)!=default:raise ValueError('strict batch unsupported '+key)
+    if sampling.get('experimental_speed_projection',True) is not True:raise ValueError('strict batch control-vector changes unsupported')
+    if sampling.get('logprobs') or sampling.get('top_logprobs'):raise ValueError('strict batch logprobs unsupported')
