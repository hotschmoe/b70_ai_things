+// Default-off bounded batch observation identity. No model state owns this ledger.
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstddef>
+#include <stdexcept>
+namespace strata::core::batch_fidelity {
+constexpr int REQUESTS=6, ROWS=6, LAYERS=48, D=10240, VOCAB=248320;
+constexpr size_t BYTE_LIMIT=64*1024*1024;
+struct identity { uint64_t rid=0,generation=0,slotgen=0;int slot=-1;int64_t prompt=0,pos=0;int token=0;int row=0,batchrows=1; };
+struct entry {identity id;bool admission=false,later=false;};
+struct ledger {
+ std::array<entry,REQUESTS> requests{};unsigned count=0;
+ entry* find(uint64_t rid){for(unsigned i=0;i<count;++i)if(requests[i].id.rid==rid)return &requests[i];return nullptr;}
+ identity begin(uint64_t rid,uint64_t slotgen,int slot,int64_t prompt){
+  if(!rid || !slotgen || slot<0 || slot>=ROWS || prompt<1)throw std::invalid_argument("batch observer admission identity");
+  if(auto* e=find(rid)){e->id.slot=slot;e->id.slotgen=slotgen;return e->id;}
+  if(count>=REQUESTS)return {};auto& e=requests[count++];e.id={rid,count,slotgen,slot,prompt,0,0};return e.id;
+ }
+ bool select(const identity& id,bool admission){auto* e=find(id.rid);if(!e)return false;
+  if(id.generation!=e->id.generation || id.slotgen!=e->id.slotgen || id.slot!=e->id.slot || !id.slotgen || id.slot<0 || id.slot>=ROWS)throw std::invalid_argument("batch observer stale identity");
+  if(admission)return !e->admission;return e->admission && !e->later;
+ }
+ void complete(const identity& id,bool admission){auto* e=find(id.rid);if(!e || !select(id,admission))throw std::invalid_argument("batch observer invalid completion");
+  if(admission)e->admission=true;else e->later=true;
+ }
+};
+}
