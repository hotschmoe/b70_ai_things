+inline const config& settings(){static config c;return c;}
+inline bool armed(){if(!settings().enabled)return false;struct stat a,d;return settings().arm&&settings().dir&&!stat(settings().arm,&a)&&S_ISREG(a.st_mode)&&!stat(settings().dir,&d)&&S_ISDIR(d.st_mode);}
+inline ledger& records(){static ledger l;return l;}
+inline identity& admitting(){static identity id;return id;}
+inline std::mutex& log_lock(){static std::mutex m;return m;}
+inline identity begin(uint64_t rid,uint64_t slotgen,int slot,int64_t prompt){if(!armed()||!rid||!slotgen||slot<0)return {};auto id=records().begin(rid,slotgen,slot,prompt);admitting()=id;
+ if(id.rid)std::fprintf(stderr,"SBF request pid=%ld rid=%llu requestgen=%llu slot=%d slotgen=%llu prompt=%lld engine_generation=native_pid observed_only=1\n",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.generation,id.slot,(unsigned long long)id.slotgen,(long long)prompt);return id;}
+inline identity mapped(uint64_t rid,uint64_t slotgen,int slot,int64_t pos,int token){if(!settings().enabled)return {};auto* e=records().find(rid);if(!e)return {};auto id=e->id;id.slot=slot;id.slotgen=slotgen;id.pos=pos;id.token=token;return id;}
+inline void span(const identity& id,int stage,int lb,int le,int64_t a,int64_t b,const char* phase){if(!settings().enabled||!id.rid)return;
+ const std::lock_guard<std::mutex> lock(log_lock());static unsigned events=0;if(++events>8192){if(events==8193)std::fprintf(stderr,"SBF bound span_events=8192 exceeded=1\n");return;}std::fprintf(stderr,"SBF span pid=%ld rid=%llu requestgen=%llu slot=%d slotgen=%llu stage=%d lb=%d le=%d begin=%lld end=%lld phase=%s completed=1 observed_only=1\n",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.generation,id.slot,(unsigned long long)id.slotgen,stage,lb,le,(long long)a,(long long)b,phase);}
+inline bool store(const identity& id,int stage,int lb,int le,int layer,const char* phase,const std::vector<float>& raw,std::string& err){
+ static size_t total=0;static unsigned serial=0;const std::lock_guard<std::mutex> lock(log_lock());const size_t bytes=raw.size()*4;
+ if(!id.rid||!bytes||bytes>size_t(VOCAB)*4||total>BYTE_LIMIT-bytes){err="batch observer byte or identity bound";return false;}
+ const uint16_t endian=1;if(!*reinterpret_cast<const unsigned char*>(&endian)){err="batch observer requires little endian host";return false;}
+ char leaf[256];std::snprintf(leaf,sizeof leaf,"sbf-%ld-r%llu-g%llu-sg%llu-s%d-%s-l%d-i%u.f32",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.generation,(unsigned long long)id.slotgen,stage,phase,layer,++serial);
+ std::string path=std::string(settings().dir)+"/"+leaf;int fd=::open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);if(fd<0){err="batch observer open";return false;}
+ size_t done=0;const char* p=reinterpret_cast<const char*>(raw.data());while(done<bytes){ssize_t n=::write(fd,p+done,bytes-done);if(n>0)done+=size_t(n);else if(n<0&&errno==EINTR)continue;else break;}
+ const bool closed=::close(fd)==0;if(done!=bytes||!closed){::unlink(path.c_str());err="batch observer write";return false;}total+=bytes;
+ std::fprintf(stderr,"SBF vector pid=%ld rid=%llu requestgen=%llu slot=%d slotgen=%llu stage=%d lb=%d le=%d phase=%s layer=%d pos=%lld token=%d row=%d batchrows=%d floats=%zu bytes=%zu file=%s canonical=le_f32 observed_only=1\n",long(getpid()),(unsigned long long)id.rid,(unsigned long long)id.generation,id.slot,(unsigned long long)id.slotgen,stage,lb,le,phase,layer,(long long)id.pos,id.token,id.row,id.batchrows,raw.size(),bytes,path.c_str());return true;
+}
+class snapshot {
+ sycl::queue q_;int stage_,lb_,le_;bool head_;size_t stride_;float* data_=nullptr;
+public:
+ snapshot(const sycl::queue& q,int stage,int lb,int le,bool head):q_(q),stage_(stage),lb_(lb),le_(le),head_(head),stride_(size_t(le-lb)*D+(head?VOCAB:0)){
+  if(lb<0||le>LAYERS||lb>=le)throw std::invalid_argument("batch observer stage geometry");data_=sycl::malloc_device<float>(ROWS*stride_,q_);if(!data_)throw std::bad_alloc();
+  std::fprintf(stderr,"SBF allocation stage=%d lb=%d le=%d bytes=%zu rows=6 head=%d\n",stage,lb,le,ROWS*stride_*4,head);
+ }
+ ~snapshot(){try{release();}catch(...){}}
+ void release(){q_.wait_and_throw();if(data_){sycl::free(data_,q_);data_=nullptr;}}
+ void layer(int layer,const float* rows,int n,sycl::queue& q){if(layer<lb_||layer>=le_||n<1||n>ROWS||q.get_context()!=q_.get_context()||q.get_device()!=q_.get_device())throw std::invalid_argument("batch observer layer affinity");for(int t=0;t<n;++t)q.memcpy(data_+size_t(t)*stride_+size_t(layer-lb_)*D,rows+size_t(t)*D,D*4);}
+ void logits(const float* rows,int n,sycl::queue& q){if(!head_)return;if(n<1||n>ROWS||q.get_context()!=q_.get_context()||q.get_device()!=q_.get_device())throw std::invalid_argument("batch observer head affinity");for(int t=0;t<n;++t)q.memcpy(data_+size_t(t)*stride_+size_t(le_-lb_)*D,rows+size_t(t)*VOCAB,VOCAB*4);}
+ bool dump(const identity* ids,const bool* selected,int n,bool admission,std::string& err){for(int t=0;t<n;++t)if(selected[t]){
+  for(int l=lb_;l<le_;++l){std::vector<float> raw(D);q_.memcpy(raw.data(),data_+size_t(t)*stride_+size_t(l-lb_)*D,D*4).wait_and_throw();if(!store(ids[t],stage_,lb_,le_,l,admission?"admission_residual":"batch_step_residual",raw,err))return false;}
+  if(head_){std::vector<float> raw(VOCAB);q_.memcpy(raw.data(),data_+size_t(t)*stride_+size_t(le_-lb_)*D,VOCAB*4).wait_and_throw();if(!store(ids[t],stage_,lb_,le_,-1,admission?"admission_logits_before_sampler":"batch_step_logits_before_sampler",raw,err))return false;}
+ }return true;}
+};
+}
