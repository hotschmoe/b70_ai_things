+namespace {
+class NativeHcWrite;
+bool native_hc_write(const ModelGeometry& g,const BlockBuffers& bb,const float* inject,void* stream,std::string& err) {
+    if (!native_hc_policy(err)) return false;
+    if (g.n_embd!=2560 || g.hc!=4 || !bb.R || !bb.block_out || !inject) {
+        err="native HC: residual write descriptor rejected"; return false;
+    }
+    auto& q=*strata::q_of(stream);
+    if (!q.has_property<sycl::property::queue::in_order>()) { err="native HC: residual write needs in-order queue"; return false; }
+    float* R=bb.R; const float* bo=bb.block_out;
+    q.parallel_for<NativeHcWrite>(sycl::range<1>(10240),[=](sycl::id<1> index) {
+        const size_t i=index[0],c=i/2560,d=i%2560;
+        const float w=2.0f/(1.0f+sycl::exp(-inject[c]/4.0f));
+        R[i]=sycl::fma(bo[d],w,R[i]);
+    });
+    return true;
+}
+bool native_hc_read(const WeightRef* wn,const WeightRef* wd,const WeightRef* wu,const WeightRef* wi,
+                    const ModelGeometry& g,const BlockBuffers& bb,float* injection,void* stream,std::string& err) {
+    if (!native_hc_policy(err)) return false;
+#ifdef STRATA_SYCL_Q8_HC_BUILT
+    using namespace strata::kernels;
+    if (!wn || !wd || !wu || wn->hc_source_type!=0 || wd->hc_source_type!=8 || wu->hc_source_type!=8 ||
+        (wi && wi->hc_source_type!=0)) { err="native HC: missing exact source view"; return false; }
+    HcNativeArgs a; a.n_embd=int(g.n_embd); a.hc=int(g.hc); a.lr=int(g.hc_lr); a.eps=RMS_EPS;
+    a.w.norm=wn->hc_source_f32; a.w.norm_floats=wn->hc_source_bytes/4;
+    a.w.down=wd->hc_source_q8; a.w.down_bytes=wd->hc_source_bytes;
+    a.w.up=wu->hc_source_q8; a.w.up_bytes=wu->hc_source_bytes;
+    if (wi) { a.w.inject=wi->hc_source_f32; a.w.inject_floats=wi->hc_source_bytes/4;
+        a.inject_out=injection; a.inject_out_floats=size_t(g.hc); }
+    const size_t D=size_t(g.hc*g.n_embd);
+    a.R=bb.R; a.R_floats=D; a.xn=bb.gr.xn; a.xn_floats=D;
+    a.lo=bb.gr.lo; a.lo_floats=size_t(g.hc_lr); a.gate=bb.gr.gated; a.gate_floats=D;
+    a.rs=bb.gr_rs; a.rs_floats=size_t(g.hc); a.mixed=bb.mixed; a.mixed_floats=size_t(g.n_embd);
+    if (!hc_native_read_f32(a,stream)) { err="native HC: composed read rejected"; return false; }
+    return true;
+#else
+    err="native HC: kernel build disabled"; return false;
+#endif
+}
