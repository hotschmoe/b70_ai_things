+// STRATA_BATCH_MTP_ASYNC=1: draft()'s greedy branch (min_p <= 0, not coupled) split at its launch, so the caller can
+// launch every slot drafter's round on its own queue before it reads any back.  Same T, graphs, max_cells bound,
+// staging and launches as draft(); draft_finish then does the spin, the queue wait, the PLE prefetch order, the zero
+// fill and n_drafts of that branch.
+bool MtpDrafter::draft_submit(int T, const int32_t* tokens, int64_t p, int a, std::string& err) {
+    const OnDevice on_device(device_);
+    if (pending_) { err = "mtp: a submitted draft is still pending"; return false; }
+    if (T < 1 || T > max_t_ || a < 0 || a >= T) { err = "mtp: draft arguments out of range"; return false; }
+    if (chain_live_) { err = "mtp: a pipelined chain is still in flight"; return false; }
+    if (coupled_active_) { err = "mtp: draft_submit is greedy only (coupled draft sampling is on)"; return false; }
+    if (!mtp_catchup_all()) T = a + 1;
+    if (!capture_round(T, false, err)) return false;
+    const int max_steps = (int) std::min<int64_t>(std::min(max_t_ - 1, max_drafts_), st_.max_cells - (p + a));
+    for (int j = 1; j < max_steps; ++j)
+        if (!capture_step(j, false, err)) return false;
+    pend_t0_ = Clock::now();
+    const int64_t NH = g_->n_head;
+    auto put = [&](int row, int64_t cell) {
+        h_step_[row * 4 + 0] = (int32_t) cell;
+        h_step_[row * 4 + 1] = (int32_t) (cell + 1);
+        h_step_[row * 4 + 2] = (int32_t) ((cell + 1) / 4);
+        h_step_[row * 4 + 3] = (int32_t) (cell + 1);
+        for (int64_t h = 0; h < NH; ++h) h_pos_[row * NH + h] = (int32_t) cell;
+    };
+    for (int t = 0; t < T; ++t) {
+        h_tok_[t] = tokens[t];
+        put(t, p + t);
+    }
+    put(2 * max_t_ - 1, coupled_draft_cell(p, a, 0));
+    for (int j = 1; j < max_steps; ++j)
+        put(max_t_ + j - 1, coupled_draft_cell(p, a, j));
+    for (int j = 0; j < max_steps; ++j) ((volatile int32_t*) h_out_)[j] = -1;
+    h_row_[0] = a;
+    h_row_[1] = 0;
+    if (h_force_ != nullptr) for (int j = 0; j < 16; ++j) h_force_[j] = -1;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    pending_ = false;   // published only once every launch is queued
+    pend_steps_ = 0;
+    pend_tok_ = tokens[a];
+    if (!stage_source_R(T, err)) return false;
+    if (max_steps > 0) {
+        // a failed launch never leaves a half-submitted round pending: drain what was queued and report the error,
+        // so no caller reads results of a round that was not fully launched
+        bool ok = DPCT_CHECK_ERROR((cs_)->ext_oneapi_graph(*round_exec_[T])) == 0;
+        if (!ok) err = "mtp draft (submit): round launch failed";
+        for (int j = 1; ok && j < max_steps; ++j)
+            if (DPCT_CHECK_ERROR((cs_)->ext_oneapi_graph(*step_exec_[j])) != 0) {
+                err = "mtp draft (submit): step launch failed";
+                ok = false;
+            }
+        if (!ok) {
+            (void)DPCT_CHECK_ERROR(cs_->wait());
+            return false;
+        }
+        (void)DPCT_CHECK_ERROR(((cs_)->ext_oneapi_empty()));
+    }
+    pend_steps_ = max_steps;
+    pending_ = true;
+    return true;
+}
+
+bool MtpDrafter::draft_finish(int32_t* drafts, std::string& err, int* n_drafts) {
+    const OnDevice on_device(device_);
+    if (!pending_) { err = "mtp: no submitted draft to finish"; return false; }
+    pending_ = false;
+    const int max_steps = pend_steps_;
+    SessionState* const pss = ple_ss_ ? ple_ss_ : ss_;
+    const bool do_ple = pss != nullptr && pss->ple.ready() && pss->ple.table != nullptr;
+    int32_t ple_prev[2] = {do_ple ? pss->ple_prev[0] : 0, do_ple ? pss->ple_prev[1] : 0};
+    auto prefetch_ple = [&](int32_t tok) {
+        if (!do_ple || tok < 0) return;
+        uint32_t rows16[strata::kernels::PLE_N_HEADS];
+        strata::kernels::ngram_rows(&tok, ple_prev, 1, pss->ple.consts, rows16);
+        ple_prev[0] = ple_prev[1];
+        ple_prev[1] = tok;
+        pss->ple.table->prefetch_rows(rows16);
+    };
+    int n = 0;
+    if (max_steps > 0) {
+        prefetch_ple(pend_tok_);
+        for (int j = 0; j + 1 < max_steps; ++j) {
+            uint32_t spins = 0;
+            while (((volatile int32_t*) h_out_)[j] < 0) {
+#if defined(_WIN32) || defined(__x86_64__)
+                _mm_pause();
+#endif
+                if ((++spins & 1023u) == 0 && ((cs_)->ext_oneapi_empty() ? 0 : 1) != 1) break;
+            }
+            drafts[j] = ((volatile int32_t*) h_out_)[j];
+            prefetch_ple(drafts[j]);
+        }
+        if (DPCT_CHECK_ERROR(cs_->wait()) != 0) {
+            err = "mtp draft (finish): the drafter's queue failed";
+            return false;
+        }
+        const int last = max_steps - 1;
+        drafts[last] = ((volatile int32_t*) h_out_)[last];
+        prefetch_ple(drafts[last]);
+        n = max_steps;
+    } else if (DPCT_CHECK_ERROR(cs_->wait()) != 0) {   // no round (the ring's end): still drain a queued residual copy
+        err = "mtp draft (finish): the drafter's queue failed";
+        return false;
+    }
+    for (int j = n; j < max_t_ - 1; ++j) drafts[j] = 0;
+    if (n_drafts) *n_drafts = n;
+    ms_draft += ms_since(pend_t0_);
+    ++rounds;
+    return true;
+}
