+// Default-off native Strata observer. No graph switches or model corrections.
+#pragma once
+#include "strata/core/fidelity_observer_contract.hpp"
+#include <sycl/sycl.hpp>
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <string>
+#include <vector>
+#include <stdexcept>
+#include <memory>
+#include <limits>
+#include <mutex>
+namespace strata::core::fidelity_diag {
+struct config {
+    bool enabled=false,activations=false;const char* arm=nullptr;const char* dir=nullptr;
+    config(){const char* p=std::getenv("STRATA_FIDELITY_DIAG");enabled=p && !std::strcmp(p,"1");
+        if(enabled){p=std::getenv("STRATA_FIDELITY_DIAG_ACTIVATIONS");activations=p && !std::strcmp(p,"1");
+            arm=std::getenv("STRATA_FIDELITY_DIAG_ARM");dir=std::getenv("STRATA_FIDELITY_DIAG_DIR");}}
+};
+inline const config& settings(){static const config c;return c;}
+struct request {bool active=false;unsigned ordinal=0;int64_t tokens=0,resume=-1;unsigned serial=0;
+    std::vector<int64_t> ids;};
+inline request& current(){static request r;return r;}
+inline std::mutex& output_mutex(){static std::mutex value;return value;}
+inline std::atomic<size_t>& reserved(){static std::atomic<size_t> value{0};return value;}
+inline void skipped(const char* phase,const char* why,int layer=-1){if(!settings().enabled)return;
+    std::fprintf(stderr,"SFD skip pid=%ld request=%u phase=%s layer=%d reason=%s observed_only=1\n",
+        long(getpid()),current().ordinal,phase,layer,why);}
+inline void begin(const std::vector<int64_t>& ids,bool supported){
+    if(!settings().enabled)return;auto& r=current();r.active=false;
+    struct stat a,d;if(!settings().arm || !settings().dir || stat(settings().arm,&a) || !S_ISREG(a.st_mode) ||
+        stat(settings().dir,&d) || !S_ISDIR(d.st_mode))return;
+    ++r.ordinal;r.serial=0;r.resume=-1;r.tokens=int64_t(ids.size());
+    if(!supported || r.ordinal>REQUESTS || ids.empty() || ids.size()>8192){skipped("request","unsupported_mode_or_request_bound");return;}
+    r.active=true;r.ids=ids;
+    std::fprintf(stderr,"SFD request pid=%ld request=%u tokens=%zu ids=",long(getpid()),r.ordinal,ids.size());
+    for(size_t i=0;i<ids.size();++i)std::fprintf(stderr,"%s%lld",i?",":"",(long long)ids[i]);
+    std::fprintf(stderr," shape=4x2560 first_logits248320 states_GDN_PLE_QSA=unobserved raw_F16_state=skipped_metadata_only\n");
+}
+inline void resumed(int64_t count){if(!settings().enabled || !current().active)return;current().resume=count;
+    std::fprintf(stderr,"SFD resume pid=%ld request=%u reused=%lld evaluated_prompt_pending=1\n",long(getpid()),current().ordinal,(long long)count);}
+inline bool quota(size_t bytes){size_t old=reserved().load();while(bytes<=TOTAL_LIMIT-old)if(reserved().compare_exchange_weak(old,old+bytes))return true;return false;}
+inline bool store(const char* phase,int stage,int lb,int le,int layer,int64_t pos,int token,
+                  const std::vector<uint8_t>& raw,std::string& error){
+    const std::lock_guard<std::mutex> lock(output_mutex());
+    auto& r=current();if(!r.active)return true;
+    if(raw.empty() || raw.size()%4 || raw.size()>size_t(VOCAB)*4 || !quota(raw.size())){skipped(phase,"byte_bound",layer);return true;}
+    char leaf[192];std::snprintf(leaf,sizeof leaf,"sfd-%ld-r%u-s%d-%s-l%d-p%lld-i%u.f32",long(getpid()),r.ordinal,stage,phase,layer,(long long)pos,++r.serial);
