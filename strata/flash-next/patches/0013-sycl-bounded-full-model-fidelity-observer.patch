+    const int fd=::open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);
+    if(fd<0){error="fidelity diagnostic output open failed";return false;}
+    const uint16_t endian=1;const auto* test=reinterpret_cast<const uint8_t*>(&endian);const uint8_t* bytes=raw.data();std::vector<uint8_t> le_bytes;
+    if(!test[0]){le_bytes=raw;for(size_t i=0;i<le_bytes.size();i+=4){std::swap(le_bytes[i],le_bytes[i+3]);std::swap(le_bytes[i+1],le_bytes[i+2]);}bytes=le_bytes.data();}
+    size_t done=0;bool ok=true;while(done<raw.size()){ssize_t n=::write(fd,bytes+done,raw.size()-done);if(n>0)done+=size_t(n);else if(n<0 && errno==EINTR)continue;else{ok=false;break;}}
+    if(::close(fd))ok=false;if(!ok){::unlink(path.c_str());error="fidelity diagnostic output write failed";return false;}
+    std::fprintf(stderr,"SFD vector pid=%ld request=%u stage=%d lb=%d le=%d phase=%s layer=%d pos=%lld token=%d bytes=%zu file=%s canonical=le_f32 reused=%lld observed_only=1\n",
+        long(getpid()),r.ordinal,stage,lb,le,phase,layer,(long long)pos,token,raw.size(),path.c_str(),(long long)r.resume);
+    return true;
+}
+class snapshot {
+public:
+    snapshot(const sycl::queue& queue,int stage,int lb,int le,bool logits):q_(queue),stage_(stage),lb_(lb),le_(le),logits_(logits){
+        if(lb<0 || le>LAYERS || lb>=le)throw std::invalid_argument("fidelity snapshot stage range");
+        residual_floats_=settings().activations?size_t(le-lb)*D:0;
+        floats_=residual_floats_+(logits?VOCAB:0);
+        if(floats_){data_=sycl::malloc_device<float>(floats_,q_);if(!data_)throw std::bad_alloc();}
+        std::fprintf(stderr,"SFD allocation stage=%d lb=%d le=%d bytes=%zu residuals%d logits%d\n",stage,lb,le,floats_*4,settings().activations,logits);
+    }
+    ~snapshot(){try{release();}catch(...) {}}
+    void release(){q_.wait_and_throw();if(data_){sycl::free(data_,q_);data_=nullptr;}}
+    void layer(int l,const float* R,sycl::queue& queue){
+        if(!residual_floats_)return;size_t off=0;if(!slot_offset(lb_,le_,l,off) || !R)throw std::invalid_argument("fidelity layer descriptor");
+        if(queue.get_context()!=q_.get_context() || queue.get_device()!=q_.get_device())throw std::invalid_argument("fidelity snapshot queue affinity");
