+// Bounded canonical F32 diagnostic contracts, CPU-testable; no inference math.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+namespace strata::core::fidelity_diag {
+constexpr int N=2560,HC=4,D=10240,LAYERS=48,VOCAB=248320;
+constexpr unsigned REQUESTS=6,CHUNKS=2;
+constexpr size_t TOTAL_LIMIT=64u<<20,ROW_BYTES=D*4;
+inline bool geometry(int n,int hc,int layers,int vocab) {
+    return n==N && hc==HC && layers==LAYERS && (vocab==0 || vocab==VOCAB);
+}
+inline bool slot_offset(int lb,int le,int layer,size_t& offset) {
+    if(lb<0 || le>LAYERS || lb>=le || layer<lb || layer>=le)return false;
+    offset=size_t(layer-lb)*D;return true;
+}
+inline bool first_row(int rows,int row,int64_t position,int64_t prompt_tokens) {
+    return rows==1 && row==0 && position>=0 && position==prompt_tokens-1;
+}
