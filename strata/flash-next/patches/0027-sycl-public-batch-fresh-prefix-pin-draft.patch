new file mode 100644
--- /dev/null
+++ b/sycl/include/strata/core/batch_public_prefix.hpp
@@ -0,0 +1,12 @@
+// 0027 public fresh/pin policy. Device/reset implementation remains in the owning driver.
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+namespace strata::core::batch_public {
+inline bool enabled(){static const bool value=[](){const char*p=std::getenv("STRATA_BATCH_PUBLIC_PREFIX");if(!p||!*p||!std::strcmp(p,"0"))return false;if(std::strcmp(p,"1"))throw std::invalid_argument("STRATA_BATCH_PUBLIC_PREFIX=0|1");return true;}();return value;}
+inline int64_t ceiling(bool fresh,bool pin_present,int64_t pin,int64_t prompt){if(prompt<1||pin<0||pin>=prompt)throw std::invalid_argument("public prefix boundary must be0..prompt-1");return fresh?0:(pin_present?pin:prompt-1);}
+inline bool permits(int64_t length,int64_t ceiling){return length>0&&length<=ceiling;}
+struct request {bool fresh=false,pin_present=false;int64_t pin=0,prompt=0;int64_t prefix_limit()const{return ceiling(fresh,pin_present,pin,prompt);}};
+}
