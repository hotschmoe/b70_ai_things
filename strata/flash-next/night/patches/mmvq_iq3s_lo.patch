+    }
+    ls = 1 + 2 * ((b->scales[ib >> 1] >> (4 * (ib & 1))) & 0x0F);
+    dw = (float) b->d;
+}
+template <int NC, bool SLM_GRID>
+void night_iq3s_lo_kernel(const uint8_t* __restrict__ w, std::size_t rb, const Q81Block* __restrict__ x, float* __restrict__ y,
+                          int n_in, int n_out, uint32_t* __restrict__ slm) {
+    auto it = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    const uint32_t* T = kNightIq3sGrid;
+    if constexpr (SLM_GRID) {
+        const int lid = int(it.get_local_id(1)) * 32 + int(it.get_local_id(2));
+        for (int i = lid; i < 512; i += 128) slm[i] = kNightIq3sGrid[i];
+        it.barrier(sycl::access::fence_space::local_space);
+        T = slm;
+    }
+    const int row = int(it.get_group(2)) * 4 + int(it.get_local_id(1));
+    if (row >= n_out) return;
+    const int lane = int(it.get_local_id(2));
+    const int nb = n_in / 256, xbs = n_in / 32;
+    const NightIQ3SBlock* br = reinterpret_cast<const NightIQ3SBlock*>(w + std::size_t(row) * rb);
+    float s[NC];
+#pragma unroll
+    for (int c = 0; c < NC; ++c) s[c] = 0.0f;
+    for (int k = lane; k < nb * 8; k += 32) {
+        const int kbx = k >> 3, ib = k & 7;
+        int g[8]; int ls; float dw;
+        night_iq3s_lo_decode<SLM_GRID>(br + kbx, ib, T, g, ls, dw);
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            const Q81Block* xb = x + std::size_t(c) * xbs + kbx * 8 + ib;
+            const int* q8 = reinterpret_cast<const int*>(xb->qs);
+            int sumi = 0;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) sumi = strata::dp4a(g[j], q8[j], sumi);
+            sumi *= ls;
+            const float d = dw * (float) xb->ds[0];
+            const float t = d * sumi;   // its own statement (no fma contraction): the serving apply() returns d * sumi
+            s[c] += t;
+        }
+    }
+    const sycl::sub_group sg = it.get_sub_group();
