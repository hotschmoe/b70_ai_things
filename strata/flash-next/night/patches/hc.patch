diff --git a/sycl/src/kernels/cuda/fused_gr_night.inc b/sycl/src/kernels/cuda/fused_gr_night.inc
new file mode 100644
index 00000000..e9c556e1
--- /dev/null
+++ b/sycl/src/kernels/cuda/fused_gr_night.inc
@@ -0,0 +1,1001 @@
+// sycl/src/kernels/cuda/fused_gr_night.inc - night-lab HC read (STRATA_NIGHT_HC), included inside fused_gr.dp.cpp's
+// anonymous namespace.  Two kernels instead of four (norm, sliced down, reduce, up):
+//
+//   night_down: (row group, 640-column chunk) work-groups.  Each stages its chunk of R' * w_norm (UNSCALED) for the
+//               T rows in SLM, sums that chunk's squares, and runs RPW down rows per 16-lane sub-group with the
+//               weights loaded before the staging (BF16, or the Q8_0 copy of STRATA_HC_Q8=1).  The activations are
+//               read from SLM once per RPW rows.  The partial dots go to global memory; the LAST work-group of a row
+//               group to finish (atomic counter, no waiting: forward progress is never needed) sums the 16 chunk
+//               partials per stream, applies rs per stream (w . xn = sum_c rs[c] * (w[:, c] . (R'[c] * g[c]))), and
+//               writes lo = silu(. / hc) (or inject_out), and rs.  The counter is reset by that group (graph-safe).
+//   night_up:   the default up kernel's arithmetic per row (dot8 over lane chunks, warp_sum, the same epilogue), with
+//               lo from night_down instead of a partial-sum prologue, and RB rows per sub-group sharing every
+//               register load of lo.  Q8: the same rows from the Q8_0 copy.
+//
+// The down sums run in another order than the default read (rs applied after the dots, chunks of 640): FP32
+// rounding-level differences, the same reordering as upstream's opt-in STRATA_GR_V3 / S23 Q8 reads.  The Q8 path
+// also changes the weights (Q8_0 of the BF16 values, ggml reference rounding).
+namespace night_hc {
+constexpr int KC = 640, NKC = D / KC, CPS = N / KC;   // 16 chunks of 640 columns, 4 per stream
+constexpr int SG = 16, DTH = 256, DSG = DTH / SG;     // down: 16-lane sub-groups, 16 per work-group
+constexpr int STEPS = KC / (SG * 8);                  // 5 steps of 128 columns (8 per lane)
+static_assert(N % KC == 0 && KC % (SG * 8) == 0, "chunks never straddle streams");
+constexpr int Q8B = 34;
+constexpr int TM = kFusedGrMaxT;
+
+// Compact kernel arguments (the GrMulti by-value argument is ~1.6 KB of cross-thread data = 25 GRF in every thread,
+// which made these kernels spill): the callers lay the window's rows out at fixed strides (verify / mtp / the final
+// mixer: R + t*D, bo + t*N, inj_prev / rs / inject_out + t*HC, lo + t*LR, mixed + t*N), so one base pointer each.
+struct NA {
+    const float* R; float* R_out; const float* bo; const float* ip; const float* wn;
+    const uint16_t* wd; const uint16_t* wu; const uint16_t* wi; const uint8_t* qd; const uint8_t* qu;
+    float* lo; float* rs; float* inj; float* mixed; float eps; int apply;
+};
+/// the compact form of m, or false when the rows are not at the fixed strides (the caller keeps the default read)
+inline bool na_of(const GrMulti& m, NA& o) {
+    const FusedGrArgs& a = m.a[0];
+    o = NA{a.R, a.R_out, a.bo_prev, a.inj_prev, a.w_norm, a.w_down, a.w_up, a.w_inject, a.q8_down, a.q8_up,
+           a.lo, a.rs, a.inject_out, a.mixed, a.eps, a.apply ? 1 : 0};
+    if (a.R_out != a.R) return false;
+    for (int t = 1; t < m.T; ++t) {
+        const FusedGrArgs& b = m.a[t];
+        if (b.R != a.R + (size_t) t * D || b.R_out != b.R || b.apply != a.apply || b.eps != a.eps ||
+            b.lo != a.lo + (size_t) t * LR || b.rs != a.rs + (size_t) t * HC || b.mixed != a.mixed + (size_t) t * N)
+            return false;
+        if (a.apply && (b.bo_prev != a.bo_prev + (size_t) t * N || b.inj_prev != a.inj_prev + (size_t) t * HC)) return false;
+        if (a.w_inject && b.inject_out != a.inject_out + (size_t) t * HC) return false;
+    }
+    return true;
+}
+
+struct Scratch {
+    float* part = nullptr;     // [TM][NKC][PR]
+    float* ssg = nullptr;      // [NRG_MAX + 1][NKC][TM]
+    unsigned* cnt = nullptr;   // [NRG_MAX + 1]
+};
+constexpr int NRG_MAX = LR / (DSG * 1);   // RPW >= 1
+
+__dpct_inline__ uint32_t ld16(const uint8_t* p) { return *(const uint16_t*) p; }
+__dpct_inline__ float half_to_f(uint32_t h) {
+    return (float) sycl::bit_cast<sycl::half>((uint16_t) h);
+}
+// 8 Q8_0 values (two packed int8 words) times d against 8 floats: d * q is exact in FP32
+__dpct_inline__ float dot8q(uint32_t q0, uint32_t q1, float d, sycl::float4 x0, sycl::float4 x1) {
+    float acc = 0.0f;
+    acc = sycl::fma(d * (float) (int8_t) (q0 & 255u), x0.x(), acc);
+    acc = sycl::fma(d * (float) (int8_t) ((q0 >> 8) & 255u), x0.y(), acc);
+    acc = sycl::fma(d * (float) (int8_t) ((q0 >> 16) & 255u), x0.z(), acc);
+    acc = sycl::fma(d * (float) (int8_t) (q0 >> 24), x0.w(), acc);
+    acc = sycl::fma(d * (float) (int8_t) (q1 & 255u), x1.x(), acc);
+    acc = sycl::fma(d * (float) (int8_t) ((q1 >> 8) & 255u), x1.y(), acc);
+    acc = sycl::fma(d * (float) (int8_t) ((q1 >> 16) & 255u), x1.z(), acc);
+    acc = sycl::fma(d * (float) (int8_t) (q1 >> 24), x1.w(), acc);
+    return acc;
+}
+__dpct_inline__ float bfx(uint32_t w, bool hi) { return sycl::bit_cast<float>(hi ? (w & 0xffff0000u) : (w << 16)); }
+__dpct_inline__ float dot8b(const sycl::uint4 w, sycl::float4 x0, sycl::float4 x1) {   // dot8's order
+    float acc = 0.0f;
+    acc = sycl::fma(bfx(w.x(), false), x0.x(), acc); acc = sycl::fma(bfx(w.x(), true), x0.y(), acc);
+    acc = sycl::fma(bfx(w.y(), false), x0.z(), acc); acc = sycl::fma(bfx(w.y(), true), x0.w(), acc);
+    acc = sycl::fma(bfx(w.z(), false), x1.x(), acc); acc = sycl::fma(bfx(w.z(), true), x1.y(), acc);
+    acc = sycl::fma(bfx(w.w(), false), x1.z(), acc); acc = sycl::fma(bfx(w.w(), true), x1.w(), acc);
+    return acc;
+}
+
+// WT: 0 = BF16 weights, 1 = Q8_0 weights (down rows; the inject rows are always the BF16 ones)
+template <int WT, int T, int RPW>
+__dpct_inline__ void night_down_kernel(NA m, Scratch sc, float* xs, float* red, int* flag) {
+    constexpr int RPG = DSG * RPW;           // rows per row group
+    constexpr int NRG = LR / RPG;            // row groups (+1: the inject rows)
+    static_assert(LR % RPG == 0, "whole row groups");
+    auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    auto sgp = item.get_sub_group();
+    const int t = (int) item.get_local_id(2), lane = t & (SG - 1), sg = t / SG;
+    const int g = (int) item.get_group(2), rg = g / NKC, kc = g - rg * NKC, c = kc / CPS;
+    const bool inj = rg == NRG;
+    const bool has_inj = m.wi != nullptr;
+    const int nrows = inj ? ((has_inj && sg < HC) ? 1 : 0) : RPW;
+    const int row0 = inj ? sg : rg * RPG + sg * RPW;
+    const int col_l = kc * KC + 8 * lane;    // this lane's first column; + 128 s per step
+    // 1. the weights first (in flight while the activations are staged)
+    constexpr int RW = WT == 0 ? RPW : 1, RQ = WT == 1 ? RPW : 1;   // BF16 rows held (Q8: the inject row only)
+    sycl::uint4 wv[RW][STEPS];
+    uint32_t q0[RQ][STEPS], q1[RQ][STEPS];
+    float dq[RQ][STEPS];
+#pragma unroll
+    for (int r = 0; r < RPW; ++r) {
+        if (r >= nrows) break;
+        if (WT == 0 || inj) {
+            const sycl::uint4* w4 = reinterpret_cast<const sycl::uint4*>(
+                (inj ? m.wi : m.wd) + (size_t) (row0 + r) * D + col_l);
+#pragma unroll
+            for (int s = 0; s < STEPS; ++s) wv[WT == 0 ? r : 0][s] = w4[16 * s];   // + 128 columns = 16 uint4
+        } else {
+            const uint8_t* row = m.qd + (size_t) (row0 + r) * (D / 32) * Q8B;
+#pragma unroll
+            for (int s = 0; s < STEPS; ++s) {
+                const int col = col_l + 128 * s;
+                const uint8_t* blk = row + (col >> 5) * Q8B;
+                const uint8_t* p = blk + 2 + (col & 31);
+                dq[WT == 1 ? r : 0][s] = half_to_f(ld16(blk));
+                q0[WT == 1 ? r : 0][s] = ld16(p) | ld16(p + 2) << 16;
+                q1[WT == 1 ? r : 0][s] = ld16(p + 4) | ld16(p + 6) << 16;
+            }
+        }
+    }
+    // 2. the chunk of R' * w_norm for the T rows, and its sums of squares
+    float ssp[T];
+#pragma unroll
+    for (int k = 0; k < T; ++k) {
+        ssp[k] = 0.0f;
+        const float gw = m.apply ? 2.0f * sigmoidf_(m.ip[k * HC + c] / (float) HC) : 0.0f;
+        for (int i = t; i < KC / 4; i += DTH) {
+            const int col = kc * KC + 4 * i;
+            sycl::float4 r = *reinterpret_cast<const sycl::float4*>(m.R + (size_t) k * D + col);
+            if (m.apply) {
+                const sycl::float4 b = *reinterpret_cast<const sycl::float4*>(m.bo + (size_t) k * N + (col - c * N));
+                r.x() = sycl::fma(b.x(), gw, r.x()); r.y() = sycl::fma(b.y(), gw, r.y());
+                r.z() = sycl::fma(b.z(), gw, r.z()); r.w() = sycl::fma(b.w(), gw, r.w());
+            }
+            const sycl::float4 gn = *reinterpret_cast<const sycl::float4*>(m.wn + col);
+            ssp[k] += r.x() * r.x() + r.y() * r.y() + r.z() * r.z() + r.w() * r.w();
+            *reinterpret_cast<sycl::float4*>(xs + k * KC + 4 * i) =
+                sycl::float4(r.x() * gn.x(), r.y() * gn.y(), r.z() * gn.z(), r.w() * gn.w());
+        }
+    }
+#pragma unroll
+    for (int k = 0; k < T; ++k) {
+        float v = ssp[k];
+        v += sycl::permute_group_by_xor(sgp, v, 8); v += sycl::permute_group_by_xor(sgp, v, 4);
+        v += sycl::permute_group_by_xor(sgp, v, 2); v += sycl::permute_group_by_xor(sgp, v, 1);
+        if (lane == 0) red[sg * TM + k] = v;
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+    if (t < T) {
+        float s = 0.0f;
+#pragma unroll
+        for (int w = 0; w < DSG; ++w) s += red[w * TM + t];
+        sc.ssg[((size_t) rg * NKC + kc) * TM + t] = s;
+    }
+    // 3. the rows' partial dots over the chunk (unscaled)
+    if (nrows > 0) {
+        float acc[RPW][T];
+#pragma unroll
+        for (int r = 0; r < RPW; ++r)
+#pragma unroll
+            for (int k = 0; k < T; ++k) acc[r][k] = 0.0f;
+#pragma unroll
+        for (int s = 0; s < STEPS; ++s) {
+#pragma unroll
+            for (int k = 0; k < T; ++k) {
+                const sycl::float4* x4 = reinterpret_cast<const sycl::float4*>(xs + k * KC + 128 * s + 8 * lane);
+                const sycl::float4 x0 = x4[0], x1 = x4[1];
+#pragma unroll
+                for (int r = 0; r < RPW; ++r) {
+                    if (r >= nrows) break;
+                    if (WT == 0 || inj) acc[r][k] += dot8b(wv[WT == 0 ? r : 0][s], x0, x1);
+                    else acc[r][k] += dot8q(q0[WT == 1 ? r : 0][s], q1[WT == 1 ? r : 0][s], dq[WT == 1 ? r : 0][s], x0, x1);
+                }
+            }
+        }
+#pragma unroll
+        for (int r = 0; r < RPW; ++r) {
+            if (r >= nrows) break;
+            const int prow = inj ? LR + sg : row0 + r;
+#pragma unroll
+            for (int k = 0; k < T; ++k) {
+                float v = acc[r][k];
+                v += sycl::permute_group_by_xor(sgp, v, 8); v += sycl::permute_group_by_xor(sgp, v, 4);
+                v += sycl::permute_group_by_xor(sgp, v, 2); v += sycl::permute_group_by_xor(sgp, v, 1);
+                if (lane == 0) sc.part[((size_t) k * NKC + kc) * PR + prow] = v;
+            }
+        }
+    }
+    // 4. the last work-group of this row group finishes it: lo (or inject_out) and rs
+    sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::device);
+    item.barrier(sycl::access::fence_space::global_and_local);
+    if (t == 0) {
+        sycl::atomic_ref<unsigned, sycl::memory_order::acq_rel, sycl::memory_scope::device,
+                         sycl::access::address_space::global_space> cnt(sc.cnt[rg]);
+        *flag = cnt.fetch_add(1u) == (unsigned) (NKC - 1) ? 1 : 0;
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+    if (*flag == 0) return;
+    sycl::atomic_fence(sycl::memory_order::acquire, sycl::memory_scope::device);
+    float* rsS = red;   // [T][HC], reused
+    if (t < T * HC) {
+        const int k = t / HC, cc = t - k * HC;
+        float ss = 0.0f;
+#pragma unroll
+        for (int j = 0; j < CPS; ++j) ss += sc.ssg[((size_t) rg * NKC + cc * CPS + j) * TM + k];
+        const float r = sycl::rsqrt(ss / (float) N + m.eps);
+        rsS[k * HC + cc] = r;
+        if (rg == 0) m.rs[k * HC + cc] = r;
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+    const int rows = inj ? (has_inj ? HC : 0) : RPG, rbase = inj ? LR : rg * RPG;
+    for (int i = t; i < T * rows; i += DTH) {
+        const int k = i / rows, prow = rbase + (i - k * rows);
+        float sum = 0.0f;
+#pragma unroll
+        for (int cc = 0; cc < HC; ++cc) {
+            float p = 0.0f;
+#pragma unroll
+            for (int j = 0; j < CPS; ++j) p += sc.part[((size_t) k * NKC + cc * CPS + j) * PR + prow];
+            sum = sycl::fma(rsS[k * HC + cc], p, sum);
+        }
+        if (inj) {
+            m.inj[k * HC + prow - LR] = sum;
+        } else {
+            const float x = sum / (float) HC;
+            m.lo[k * LR + prow] = x / (1.0f + sycl::native::exp(-x));
+        }
+    }
+    if (t == 0) sc.cnt[rg] = 0u;   // every arrival of this launch is counted: ready for the next one
+}
+
+// The up step: rows i = c * N + d of w_up for COLS columns d per work-group (x 4 streams), 32-lane sub-groups, RB rows
+// at a time sharing the lo registers.  BF16: each row's dot, butterfly and epilogue exactly gr_up_multi_kernel's.
+template <int WT, int T, int COLS, int RB>
+__dpct_inline__ void night_up_kernel(NA m, float* lo /*[T][LR]*/, float* gsum /*[T][HC][COLS]*/) {
+    auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    const int t = (int) item.get_local_id(2), lane = t & 31, warp = t >> 5;
+    const int d0 = (int) item.get_group(2) * COLS;
+    for (int i = t; i < T * LR; i += THREADS) lo[i] = m.lo[i];
+    item.barrier(sycl::access::fence_space::local_space);
+    const int pk = lane < T ? lane : 0;
+    const float* const pR = m.R + (size_t) pk * D;
+    const float* const pWn = m.wn;
+    const float* const pRs = m.rs + pk * HC;
+    const bool pApply = m.apply != 0;
+    const float* const pBo = m.bo + (size_t) pk * N;
+    const float* const pIp = m.ip + pk * HC;
+    float* const pRout = m.R_out + (size_t) pk * D;
+    constexpr int ROWS = HC * COLS, RPWU = ROWS / WARPS;
+    static_assert(ROWS % WARPS == 0 && RPWU % RB == 0, "whole row blocks");
+    const bool lb = lane < LR / 8 - 32;   // lanes 0-7: the second chunk (columns 256..319)
+#pragma unroll 1
+    for (int rb = 0; rb < RPWU; rb += RB) {
+        sycl::uint4 wa[RB], wb[RB];
+        uint32_t qa0[RB], qa1[RB], qb0[RB], qb1[RB];
+        float da[RB], db[RB];
+        int ii[RB], cc[RB], dd[RB];
+#pragma unroll
+        for (int j = 0; j < RB; ++j) {
+            const int r = warp + (rb + j) * WARPS;
+            cc[j] = r / COLS; dd[j] = r - cc[j] * COLS; ii[j] = cc[j] * N + d0 + dd[j];
+            if (WT == 0) {
+                const sycl::uint4* w4 = reinterpret_cast<const sycl::uint4*>(m.wu + (size_t) ii[j] * LR);
+                wa[j] = w4[lane];
+                wb[j] = lb ? w4[32 + lane] : sycl::uint4(0, 0, 0, 0);
+            } else {
+                const uint8_t* row = m.qu + (size_t) ii[j] * (LR / 32) * Q8B;
+                const uint8_t* ba = row + (lane >> 2) * Q8B;            // columns 8 lane .. 8 lane + 7
+                const uint8_t* pa = ba + 2 + 8 * (lane & 3);
+                da[j] = half_to_f(ld16(ba));
+                qa0[j] = ld16(pa) | ld16(pa + 2) << 16; qa1[j] = ld16(pa + 4) | ld16(pa + 6) << 16;
+                if (lb) {
+                    const uint8_t* bb = row + (8 + (lane >> 2)) * Q8B;   // columns 256 + 8 lane ..
+                    const uint8_t* pb = bb + 2 + 8 * (lane & 3);
+                    db[j] = half_to_f(ld16(bb));
+                    qb0[j] = ld16(pb) | ld16(pb + 2) << 16; qb1[j] = ld16(pb + 4) | ld16(pb + 6) << 16;
+                } else {
+                    db[j] = 0.0f; qb0[j] = qb1[j] = 0u;
+                }
+            }
+        }
+        float rv[RB], wn[RB], rsc[RB], bo[RB], ip[RB];
+#pragma unroll
+        for (int j = 0; j < RB; ++j) {
+            rv[j] = wn[j] = rsc[j] = bo[j] = ip[j] = 0.0f;
+            if (lane < T) {
+                rv[j] = pR[ii[j]]; wn[j] = pWn[ii[j]]; rsc[j] = pRs[cc[j]];
+                if (pApply) { bo[j] = pBo[d0 + dd[j]]; ip[j] = pIp[cc[j]]; }
+            }
+        }
+        float mine[RB];
+#pragma unroll
+        for (int j = 0; j < RB; ++j) mine[j] = 0.0f;
+#pragma unroll
+        for (int k = 0; k < T; ++k) {
+            const sycl::float4* xa4 = reinterpret_cast<const sycl::float4*>(lo + k * LR + lane * 8);
+            const sycl::float4 xa0 = xa4[0], xa1 = xa4[1];
+            sycl::float4 xb0(0.0f), xb1(0.0f);
+            if (lb) {
+                const sycl::float4* xb4 = reinterpret_cast<const sycl::float4*>(lo + k * LR + (32 + lane) * 8);
+                xb0 = xb4[0]; xb1 = xb4[1];
+            }
+#pragma unroll
+            for (int j = 0; j < RB; ++j) {
+                float acc;
+                if (WT == 0) {
+                    acc = dot8b(wa[j], xa0, xa1);
+                    if (lb) acc += dot8b(wb[j], xb0, xb1);
+                } else {
+                    acc = dot8q(qa0[j], qa1[j], da[j], xa0, xa1);
+                    if (lb) acc += dot8q(qb0[j], qb1[j], db[j], xb0, xb1);
+                }
+                acc = warp_sum(acc);
+                if (lane == k) mine[j] = acc;
+            }
+        }
+        if (lane < T) {
+#pragma unroll
+            for (int j = 0; j < RB; ++j) {
+                float r = rv[j];
+                if (pApply) {
+                    r = sycl::fma(bo[j], 2.0f * sigmoidf_(ip[j] / (float) HC), r);
+                    pRout[ii[j]] = r;
+                }
+                const float x = r * wn[j] * rsc[j];
+                gsum[(lane * HC + cc[j]) * COLS + dd[j]] = x * sigmoidf_(mine[j]);
+            }
+        }
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+    for (int i = t; i < T * COLS; i += THREADS) {
+        const int k = i / COLS, col = i - k * COLS;
+        float s = 0.0f;
+#pragma unroll
+        for (int c = 0; c < HC; ++c) s += gsum[(k * HC + c) * COLS + col];
+        m.mixed[(size_t) k * N + d0 + col] = s / (float) HC;
+    }
+}
+
+Scratch scratch_of(sycl::queue* q) {
+    static std::mutex mu;
+    static std::unordered_map<sycl::queue*, Scratch> bufs;
+    std::lock_guard<std::mutex> lk(mu);
+    auto it = bufs.find(q);
+    if (it != bufs.end()) return it->second;
+    Scratch s;
+    constexpr int SLABS_MAX = 20;   // down2q at 32 columns per sub-group: 20 slabs of 512
+    const size_t np = (size_t) TM * SLABS_MAX * PR, nss = (size_t) (NRG_MAX + 1) * SLABS_MAX * TM, nc = NRG_MAX + 1;
+    s.part = sycl::malloc_device<float>(np + nss, *q);
+    s.ssg = s.part + np;
+    s.cnt = sycl::malloc_device<unsigned>(nc, *q);
+    // zeroed on a separate queue: a first call inside a graph capture must not record the fill
+    sycl::queue z(q->get_context(), q->get_device());
+    z.memset(s.cnt, 0, nc * sizeof(unsigned)).wait();
+    bufs[q] = s;
+    return s;
+}
+
+template <int WT, int T, int RPW>
+void launch_down(sycl::queue* st, const NA& m, Scratch sc) {
+    constexpr int NRG = LR / (DSG * RPW);
+    st->submit([&](sycl::handler& cgh) {
+        sycl::local_accessor<float, 1> xs(sycl::range<1>((size_t) T * KC), cgh);
+        sycl::local_accessor<float, 1> red(sycl::range<1>((size_t) DSG * TM), cgh);
+        sycl::local_accessor<int, 1> flag(sycl::range<1>(1), cgh);
+        cgh.parallel_for<dpct_kernel_name<class night_hc_down, dpct_kernel_scalar<WT>, dpct_kernel_scalar<T>,
+                                          dpct_kernel_scalar<RPW>>>(
+            sycl::nd_range<3>(sycl::range(1, 1, (NRG + 1) * NKC * DTH), sycl::range(1, 1, DTH)),
+            [=](sycl::nd_item<3>) [[sycl::reqd_sub_group_size(16)]] {
+                night_down_kernel<WT, T, RPW>(m, sc, xs.get_multi_ptr<sycl::access::decorated::no>().get(),
+                                              red.get_multi_ptr<sycl::access::decorated::no>().get(),
+                                              flag.get_multi_ptr<sycl::access::decorated::no>().get());
+            });
+    });
+}
+template <int WT, int T, int COLS, int RB>
+void launch_up(sycl::queue* st, const NA& m) {
+    st->submit([&](sycl::handler& cgh) {
+        sycl::local_accessor<float, 1> lo(sycl::range<1>((size_t) T * LR), cgh);
+        sycl::local_accessor<float, 1> gs(sycl::range<1>((size_t) T * HC * COLS), cgh);
+        cgh.parallel_for<dpct_kernel_name<class night_hc_up, dpct_kernel_scalar<WT>, dpct_kernel_scalar<T>,
+                                          dpct_kernel_scalar<COLS>, dpct_kernel_scalar<RB>>>(
+            sycl::nd_range<3>(sycl::range(1, 1, (N / COLS) * THREADS), sycl::range(1, 1, THREADS)),
+            [=](sycl::nd_item<3>) [[sycl::reqd_sub_group_size(32)]] {
+                night_up_kernel<WT, T, COLS, RB>(m, lo.get_multi_ptr<sycl::access::decorated::no>().get(),
+                                                 gs.get_multi_ptr<sycl::access::decorated::no>().get());
+            });
+    });
+}
