+// night-lab STRATA_NIGHT_MTP_SELECT=1: mtp_select's residual copy (hc * n_embd floats) over several work-groups as
+// float4 instead of one work-group's float loop (15 us on the B70 for 40 KB); work-group 0 then writes the token,
+// its probability and the mapped outputs exactly as the one-group kernel does. The same bytes everywhere.
+namespace {
+bool night_mtp_select_on() {
+    static const bool v = [] {
+        const char* e = std::getenv("STRATA_NIGHT_MTP_SELECT");
+        const bool on = e != nullptr && e[0] == '1';
+        if (on) std::fprintf(stderr, "strata: STRATA_NIGHT_MTP_SELECT=1: the drafter's row select copies over many work-groups\n");
+        return on;
+    }();
+    return v;
+}
+}  // namespace
+void night_mtp_select(const float* R_src, int64_t R_stride, const int32_t* ids, const int32_t* row_dev, float* R_dst,
+                      int32_t* tok_dst, int32_t* out, int j, void* stream, const float* probs, float* out_p) {
+    const bool v4 = R_stride % 4 == 0 && (reinterpret_cast<uintptr_t>(R_src) & 15u) == 0 &&
+                    (reinterpret_cast<uintptr_t>(R_dst) & 15u) == 0;
+    const int64_t units = v4 ? R_stride / 4 : R_stride;
+    const unsigned groups = (unsigned) std::max<int64_t>(1, std::min<int64_t>((units + 255) / 256, 64));
+    strata::q_of(stream)->parallel_for<dpct_kernel_name<class night_mtp_select_k>>(
+        sycl::nd_range<3>(sycl::range(1, 1, groups * 256), sycl::range(1, 1, 256)), [=](sycl::nd_item<3> it) {
+            const int row = *row_dev;
+            const int64_t g0 = (int64_t) it.get_global_id(2), gn = (int64_t) it.get_global_range(2);
+            if (v4) {
+                const sycl::float4* s4 = reinterpret_cast<const sycl::float4*>(R_src + (size_t) row * R_stride);
+                sycl::float4* d4 = reinterpret_cast<sycl::float4*>(R_dst);
+                for (int64_t i = g0; i < units; i += gn) d4[i] = s4[i];
+            } else {
+                for (int64_t i = g0; i < units; i += gn) R_dst[i] = R_src[(size_t) row * R_stride + i];
+            }
+            it.barrier(sycl::access::fence_space::local_space);
+            if (it.get_group(2) == 0 && it.get_local_id(2) == 0) {
+                const int32_t tok = ids[row];
+                *tok_dst = tok;
+                if (probs != nullptr && out_p != nullptr) ((volatile float*) out_p)[j] = probs[row];
+                sycl::atomic_fence(sycl::memory_order::acq_rel, sycl::memory_scope::system);
+                if (out != nullptr) ((volatile int32_t*) out)[j] = tok;
+            }
+        });
+    check("night_mtp_select");
+}
+
 void mtp_select(const float* R_src, int64_t R_stride, const int32_t* ids, const int32_t* row_dev, float* R_dst,
                 int32_t* tok_dst, int32_t* out, int j, void* stream, const float* probs, float* out_p) {
+    if (night_mtp_select_on()) {
+        night_mtp_select(R_src, R_stride, ids, row_dev, R_dst, tok_dst, out, j, stream, probs, out_p);
+        return;
+    }
     {
         auto exp_props = sycl::ext::oneapi::experimental::properties{
             sycl::ext::oneapi::experimental::use_root_sync};
