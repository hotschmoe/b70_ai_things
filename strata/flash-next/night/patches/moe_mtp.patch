+namespace {
+// night STRATA_NIGHT_MTP_HCQ8: native_dense.cpp's STRATA_HC_Q8 quantizer (ggml reference rounding, fp16 d = amax / 127)
+uint16_t night_half_bits(float x) {
+    uint32_t u;
+    std::memcpy(&u, &x, 4);
+    const uint32_t sign = (u >> 16) & 0x8000u;
+    int32_t e = (int32_t) ((u >> 23) & 0xffu) - 127 + 15;
+    uint32_t m = u & 0x7fffffu;
+    if (((u >> 23) & 0xffu) == 0xffu) return (uint16_t) (sign | 0x7c00u | (m ? 0x200u : 0u));
+    if (e <= 0) {
+        if (e < -10) return (uint16_t) sign;
+        m |= 0x800000u;
+        const int shift = 14 - e;
+        uint32_t h = m >> shift;
+        const uint32_t rem = m & ((1u << shift) - 1u), half = 1u << (shift - 1);
+        if (rem > half || (rem == half && (h & 1u))) ++h;
+        return (uint16_t) (sign | h);
+    }
+    if (e >= 31) return (uint16_t) (sign | 0x7c00u);
+    uint32_t h = ((uint32_t) e << 10) | (m >> 13);
+    const uint32_t rem = m & 0x1fffu;
+    if (rem > 0x1000u || (rem == 0x1000u && (h & 1u))) ++h;
+    return (uint16_t) (sign | h);
+}
+std::vector<uint8_t> night_q8_0_of(const float* x, uint64_t n) {
+    std::vector<uint8_t> out((size_t) (n / 32 * 34));
+    for (uint64_t b = 0; b < n / 32; ++b) {
+        float amax = 0.0f;
+        for (int j = 0; j < 32; ++j) amax = (std::max)(amax, std::fabs(x[b * 32 + j]));
+        const float d = amax / 127.0f, id = d != 0.0f ? 1.0f / d : 0.0f;
+        uint8_t* o = out.data() + b * 34;
+        const uint16_t hb = night_half_bits(d);
+        std::memcpy(o, &hb, 2);
+        for (int j = 0; j < 32; ++j) o[2 + j] = (uint8_t) (int8_t) std::lround(x[b * 32 + j] * id);
+    }
+    return out;
+}
+}  // namespace
+bool MtpDrafter::make_hc_q8(const std::vector<uint8_t>& blob, std::string& err) {
+    static const bool on = [] {
+        const char* v = std::getenv("STRATA_NIGHT_MTP_HCQ8");
+        const bool b = v != nullptr && v[0] == '1';
+        if (b) std::fprintf(stderr, "strata night: STRATA_NIGHT_MTP_HCQ8=1 (the drafter's HC down/up projections as Q8_0)\n");
+        return b;
+    }();
+    if (!on) return true;
+    static const bool night_split = [] { const char* v = std::getenv("STRATA_NIGHT_HC"); return v && std::strcmp(v, "q8") == 0; }();
+    uint64_t total = 0;
+    for (const auto& t : tensors_) {
+        if (t.kind != "bf16" || t.name.find("hyper_connection") == std::string::npos ||
+            (t.name.find("input_mix_weight_down") == std::string::npos && t.name.find("input_mix_weight_up") == std::string::npos))
+            continue;
+        const uint64_t rows = (uint64_t) t.rows, K = (uint64_t) t.cols, n = rows * K;
+        if (K % 32 != 0 || t.off + n * 2 > blob.size()) { err = "mtp (STRATA_NIGHT_MTP_HCQ8): bad shape for " + t.name; return false; }
+        const uint16_t* src = (const uint16_t*) (blob.data() + t.off);
+        std::vector<float> f((size_t) n);
+        for (uint64_t i = 0; i < n; ++i) { const uint32_t u = (uint32_t) src[i] << 16; std::memcpy(&f[i], &u, 4); }
+        std::vector<uint8_t> q8 = night_q8_0_of(f.data(), n);
+        if (night_split) {   // the night HC read's layout: int8 quants [rows][K], then fp16 scales [rows][K / 32]
+            const uint64_t nb = K / 32;
+            std::vector<uint8_t> split(q8.size());
+            uint8_t* qs = split.data();
+            uint8_t* ds = split.data() + rows * K;
+            for (uint64_t r = 0; r < rows; ++r)
+                for (uint64_t b = 0; b < nb; ++b) {
+                    const uint8_t* s = q8.data() + (r * nb + b) * 34;
+                    std::memcpy(ds + (r * nb + b) * 2, s, 2);
+                    std::memcpy(qs + r * K + b * 32, s + 2, 32);
+                }
+            q8.swap(split);
+        }
+        uint8_t* p = (uint8_t*) strata::malloc_device_guarded(q8.size(), dpct::get_in_order_queue());
+        if (p == nullptr) { err = "mtp (STRATA_NIGHT_MTP_HCQ8): allocation failed"; return false; }
+        dpct::get_in_order_queue().memcpy(p, q8.data(), q8.size()).wait();
+        hc_q8_.push_back({t.name, p});
+        total += q8.size();
+    }
+    std::fprintf(stderr, "strata night: MTP HC Q8: %zu projections, %.1f MiB\n", hc_q8_.size(), total / 1048576.0);
+    return true;
+}
+const uint8_t* MtpDrafter::hcq8(const char* name) const {
