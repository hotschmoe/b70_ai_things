+        std::printf("MTP HC read, 1 row, %s (%s): BF16 %.2f us, Q8_0 %.2f us per read (%d weight sets in a graph)\n",
+                    inj ? "with inject (attn/mlp)" : "final mixer", split ? "STRATA_NIGHT_HC=q8 split layout" : "plain Q8_0", t[0], t[1], NL);
