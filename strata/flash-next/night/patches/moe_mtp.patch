+// The drafter's single-row HC read: BF16 weights vs the Q8_0 copies (STRATA_NIGHT_HC=q8: the split layout)
+std::vector<uint8_t> hq8_of(const std::vector<uint16_t>& w, uint64_t rows, uint64_t K, bool split) {
+    const uint64_t n = rows * K, nb = K / 32;
+    std::vector<uint8_t> out((size_t) (n / 32 * 34));
+    for (uint64_t b = 0; b < n / 32; ++b) {
+        float x[32], amax = 0.f;
+        for (int j = 0; j < 32; ++j) { const uint32_t u = (uint32_t) w[b * 32 + j] << 16; std::memcpy(&x[j], &u, 4); amax = std::max(amax, std::fabs(x[j])); }
+        const float d = amax / 127.0f, id = d != 0.0f ? 1.0f / d : 0.0f;
+        const sycl::half h = (sycl::half) d;
+        std::memcpy(&out[b * 34], &h, 2);
+        for (int j = 0; j < 32; ++j) out[b * 34 + 2 + j] = (uint8_t) (int8_t) std::lround(x[j] * id);
+    }
+    if (!split) return out;
+    std::vector<uint8_t> s(out.size());
+    for (uint64_t r = 0; r < rows; ++r)
+        for (uint64_t b = 0; b < nb; ++b) {
+            std::memcpy(&s[rows * K + (r * nb + b) * 2], &out[(r * nb + b) * 34], 2);
+            std::memcpy(&s[r * K + b * 32], &out[(r * nb + b) * 34 + 2], 32);
+        }
+    return s;
+}
