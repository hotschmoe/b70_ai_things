+// R rows x E entries per lane; the loop walks block pointers: for LANES % ipb == 0 lane `sub` always takes part
+// iqs = step * (sub % ipb) of blocks sub / ipb, + LANES / ipb, ... - the k order of row_dot_lanes / row_dot_multi_iq.
+template <int TY, int LANES, int R, int E>
+__dpct_inline__ void nrows_dot(const uint8_t* const* rows, const block_q8_1* const* xs, int nb, int sub,
+                               float (&out)[R][E]) {
+    using M = NQ<TY>;
+    using F = Fmt<M::FT>;
+    static_assert(LANES % F::ipb == 0, "night: a lane's part index must be fixed");
+    constexpr int KSTEP = LANES / F::ipb, XB = F::qk / 32;
+    const int iqs = F::step * (sub % F::ipb);
+    const int kb0 = sub / F::ipb;
+    float s[R][E];
+#pragma unroll
+    for (int r = 0; r < R; ++r)
+#pragma unroll
+        for (int e = 0; e < E; ++e) s[r][e] = 0.f;
+    const uint8_t* wp[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) wp[r] = rows[r] + (size_t) kb0 * M::BS;
+    const block_q8_1* xp[E];
+#pragma unroll
+    for (int e = 0; e < E; ++e) xp[e] = xs[e] + (size_t) kb0 * XB;
+    for (int kbx = kb0; kbx < nb; kbx += KSTEP) {
+        int u[E][8];
+        float ds[E];
+#pragma unroll
+        for (int e = 0; e < E; ++e) { M::acts(xp[e], iqs, u[e], ds[e]); xp[e] += KSTEP * XB; }
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            MultiW m;
+            M::prep(wp[r], iqs, m);
+            wp[r] += KSTEP * M::BS;
+#pragma unroll
+            for (int e = 0; e < E; ++e) {
+                int s0 = 0, s1 = 0;
+#pragma unroll
+                for (int j = 0; j < M::NW / 2; ++j) s0 = ggml_cuda_dp4a(m.w[j], u[e][j], s0);
+#pragma unroll
+                for (int j = M::NW / 2; j < M::NW; ++j) s1 = ggml_cuda_dp4a(m.w[j], u[e][j], s1);
+                s[r][e] += M::finish(s0, s1, m, ds[e]);
+            }
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < R; ++r)
+#pragma unroll
+        for (int e = 0; e < E; ++e) out[r][e] = lanes_sum<LANES>(s[r][e]);
+}
