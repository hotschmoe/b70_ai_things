+    }();
+    static const std::string fmts = [] { const char* v = std::getenv("STRATA_NIGHT_IQ_FMTS"); return std::string(v ? v : "16,17,18,20,21,22,42"); }();
+    const bool on = g_night_iq_force >= 0 ? g_night_iq_force != 0 : env;
+    if (!on) return false;
+    if (fmts.empty()) return true;
+    const std::string t = std::to_string(ty);
+    size_t p = 0;
+    while (p <= fmts.size()) {
+        const size_t q = fmts.find(',', p);
+        if (fmts.substr(p, q == std::string::npos ? std::string::npos : q - p) == t) return true;
+        if (q == std::string::npos) break;
