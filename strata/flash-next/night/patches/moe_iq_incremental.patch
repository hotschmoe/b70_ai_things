+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const uint32_t q = ((uint32_t) (j < 2 ? qq.x() : qq.y()) >> (16 * (j & 1))) & 0xFFFF;
+            m.w[2 * j + 0] = (int) night::q2_spread4(q & 0xFF);
+            m.w[2 * j + 1] = (int) night::q2_spread4(q >> 8);
