+bool night_iq_on(int ty) {
+    static const bool env = [] {
+        const bool b = env_on("STRATA_NIGHT_IQ");
+        if (b) std::fprintf(stderr, "strata night: STRATA_NIGHT_IQ=1 (table sign masks / SWAR decodes in the expert kernels)\n");
