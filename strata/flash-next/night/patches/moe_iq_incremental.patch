+// ---- night lab STRATA_NIGHT_IQ=1 (default off): cheaper decodes for the grouped expert kernels (the ISA of the
+// current ones: 280-480 instructions per 32-weight part for 8 DP4As, ALU-bound).  Same integers out of every part,
+// the same finish (float order) as Multi<TY> / Fmt<TY>::dot, so the outputs are bitwise the current kernels'.
+//  - sign masks: one 16-byte load from a 2/4 KB table (kNightKs: ksigns + parity; kNightSb: a sign byte) instead of
+//    unpack_ksigns (popcount, 32-bit multiply) + 2 x swar_ne4 per 8 weights;
+//  - signed grid bytes as (g ^ m) + (m & 0x01010101): exact because every IQ grid byte is in 1..62 (checked), where
+//    swar_sub4 is the general form;
+//  - Q2_0: the 2-bit fields spread by shifts/masks and biased by (t + 0x7F7F7F7F) ^ 0x80808080 (= the
+//    byte_level_permute lookup {-1, 0, 1, 2}, whose dpct emulation was ~300 instructions per part);
+//  - IQ4_NL: the 16-entry codebook by a 4-level bit-slice select (15 BFNs per 4 weights) instead of 3 cmp + 3 sel
+//    per nibble;
+//  - the loop walks block pointers (LANES % ipb == 0: a lane's iqs is fixed) instead of 64-bit kbx * sizeof products;
+//  - IQ2_XXS gets a multi-entry form (it re-decoded every entry: no Multi<16>).
+#include "night_tables.inc"
+namespace night {
+__dpct_inline__ sycl::uint4 ks_mask(uint32_t code7) { return reinterpret_cast<const sycl::uint4*>(kNightKs)[code7 & 0x7F]; }
+__dpct_inline__ sycl::uint4 sb_mask(uint32_t byte) { return reinterpret_cast<const sycl::uint4*>(kNightSb)[byte & 0xFF]; }
+__dpct_inline__ int sgn(uint32_t g, uint32_t m, uint32_t m1) { return (int) ((g ^ m) + m1); }
+__dpct_inline__ float h2f(const sycl::half& h) {
+    return sycl::vec<sycl::half, 1>(h).convert<float, sycl::rounding_mode::automatic>()[0];
+}
+// Q2_0: 8 two-bit fields of b (bits 0-7) -> 4 bytes, field i in byte i
+__dpct_inline__ uint32_t q2_spread4(uint32_t b) {
+    uint32_t t = (b | (b << 12)) & 0x000F000Fu;
+    t = (t | (t << 6)) & 0x03030303u;
+    return (t + 0x7F7F7F7Fu) ^ 0x80808080u;   // c -> c - 1 per byte, c in 0..3 (no carry: c + 0x7F <= 0x82)
+}
+// IQ4_NL: four nibbles (one per byte, 0..15) -> four kvalues_iq4nl bytes, bit-slice select
+__dpct_inline__ uint32_t iq4nl_mux4(uint32_t q) {
+    constexpr int8_t K[16] = {-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113};
+    const uint32_t b0 = (q & 0x01010101u) * 0xFFu, b1 = ((q >> 1) & 0x01010101u) * 0xFFu;
+    const uint32_t b2 = ((q >> 2) & 0x01010101u) * 0xFFu, b3 = ((q >> 3) & 0x01010101u) * 0xFFu;
+    auto C = [&](int j) { return (uint32_t) (uint8_t) K[j] * 0x01010101u; };
+    auto sel = [](uint32_t a, uint32_t b, uint32_t m) { return (a & ~m) | (b & m); };
+    uint32_t r1[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) r1[i] = sel(C(2 * i), C(2 * i + 1), b0);
+    uint32_t r2[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) r2[i] = sel(r1[2 * i], r1[2 * i + 1], b1);
+    return sel(sel(r2[0], r2[1], b2), sel(r2[2], r2[3], b2), b3);
+}
+}  // namespace night
+
+template <int TY> struct NQ { static constexpr bool has = false; };
+template <> struct NQ<16> {   // iq2_xxs: as vec_dot_iq2_xxs_q8_1
+    static constexpr bool has = true; static constexpr int NW = 8, BS = sizeof(block_iq2_xxs), FT = 16;
+    __dpct_inline__ static void prep(const uint8_t* blk, int iqs, MultiW& m) {
+        const block_iq2_xxs* bq2 = (const block_iq2_xxs*) blk;
+        const sycl::int2 qq = load8_a2((const uint8_t*) bq2->qs + 4 * iqs);   // q2 | aux32
+        const uint32_t q2 = (uint32_t) qq.x(), aux32 = (uint32_t) qq.y();
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            const sycl::uint2 g = ((const sycl::uint2*) iq2xxs_grid)[(q2 >> (8 * k)) & 0xFF];
+            const sycl::uint4 s = night::ks_mask(aux32 >> (7 * k));
+            m.w[2 * k + 0] = night::sgn(g.x(), s.x(), s.z());
+            m.w[2 * k + 1] = night::sgn(g.y(), s.y(), s.w());
+        }
+        m.a = (int) (aux32 >> 27 | 1);
+        m.d = night::h2f(bq2->d);
+    }
+    __dpct_inline__ static void acts(const block_q8_1* y, int iqs, int* u, float& ds) { Multi<18>::acts(y, iqs, u, ds); }
+    __dpct_inline__ static float finish(int s0, int s1, const MultiW& m, float ds) {
+        const int sumi = (s0 + s1) * m.a / 8;
+        const float d = m.d * ds;
+        return d * sumi;
+    }
+};
+template <> struct NQ<17> {   // iq2_xs: as Multi<17>
+    static constexpr bool has = true; static constexpr int NW = 8, BS = sizeof(block_iq2_xs), FT = 17;
+    __dpct_inline__ static void prep(const uint8_t* blk, int iqs, MultiW& m) {
+        const block_iq2_xs* bq2 = (const block_iq2_xs*) blk;
+        const sycl::int2 qq = load8_a2((const uint8_t*) bq2->qs + 4 * iqs);
+        const uint32_t lo = (uint32_t) qq.x(), hi = (uint32_t) qq.y();
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            const uint32_t q = ((k < 2 ? lo : hi) >> (16 * (k & 1))) & 0xFFFF;
+            const sycl::uint2 g = ((const sycl::uint2*) iq2xs_grid)[q & 0x1FF];
+            const sycl::uint4 s = night::ks_mask(q >> 9);
+            m.w[2 * k + 0] = night::sgn(g.x(), s.x(), s.z());
+            m.w[2 * k + 1] = night::sgn(g.y(), s.y(), s.w());
+        }
+        m.a = bq2->scales[iqs / 2] & 0x0F;
+        m.b = bq2->scales[iqs / 2] >> 4;
+        m.d = night::h2f(bq2->d);
+    }
+    __dpct_inline__ static void acts(const block_q8_1* y, int iqs, int* u, float& ds) { Multi<17>::acts(y, iqs, u, ds); }
+    __dpct_inline__ static float finish(int s0, int s1, const MultiW& m, float ds) { return Multi<17>::finish(s0, s1, m, ds); }
+};
+template <> struct NQ<18> {   // iq3_xxs: as Multi<18>
