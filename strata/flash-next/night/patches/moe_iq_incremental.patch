+template <> struct NQ<22> {   // iq2_s: as Multi<22>
+    static constexpr bool has = true; static constexpr int NW = 8, BS = sizeof(block_iq2_s), FT = 22;
+    __dpct_inline__ static void prep(const uint8_t* blk, int iqs, MultiW& m) {
