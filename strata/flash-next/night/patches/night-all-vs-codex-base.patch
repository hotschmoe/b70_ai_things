+    }
+    // per-launch host cost of each kernel type (M = 32)
+    {
+        const int L = 400;
+        auto per = [&](const char* name, auto f) {
+            q->wait();
+            gate();
+            auto a0 = Clock::now();
+            for (int i = 0; i < L; ++i) f();
+            const double h = ms_since(a0) * 1000.0 / L;
+            q->wait();
+            auto b0 = Clock::now();
+            for (int i = 0; i < L; ++i) f();
+            q->wait();
+            const double w = ms_since(b0) * 1000.0 / L;
+            std::printf("  %-26s host %6.2f us/launch   back-to-back %7.2f us/launch\n", name, h, w);
+        };
+        const uint8_t* bd = blobs;
+        per("gather_rows16 M=32", [&] { strata::prefill::gather_rows16(X, src, Xs, 32, N, q); });
+        per("iq_dequant_expert_f16", [&] { strata::kernels::iq_dequant_expert_f16(gt, dt, bd, bd + up_off, bd + down_off, FF, N, dq_gu, dq_d, q); });
+        per("oneMKL f16 GU M=32", [&] { gemm.f16(Xs, dq_gu, GUf, 32, 1280, N); });
+        per("swiglu_interleaved M=32", [&] { strata::prefill::swiglu_interleaved(GUf, Hh, 32, q); });
+        per("oneMKL f16 down M=32", [&] { gemm.f16(Hh, dq_d, out_a, 32, N, 640); });
+        const uint8_t* ga[16]; const uint8_t* gb[16]; const uint8_t* gd[16]; int32_t gc[16];
+        for (int i = 0; i < 16; ++i) { const uint8_t* p = blobs + (size_t) (i % n_exp) * blob_bytes; ga[i] = p; gb[i] = p + up_off; gd[i] = p + down_off; gc[i] = 32; }
+        per("direct oneMKL GU M=32", [&] { mkl_f16(Xs, dq_gu, GUf, 32, 1280, N); });
+        per("direct oneMKL down M=32", [&] { mkl_f16(Hh, dq_d, out_a, 32, N, 640); });
+        {
+            const uint8_t* bl[16];
+            for (int i = 0; i < 16; ++i) bl[i] = blobs + (size_t) (i % n_exp) * blob_bytes;
+            per("iq_dequant_experts_f16 x16", [&] { strata::kernels::iq_dequant_experts_f16(gt, dt, 16, bl, up_off, down_off, FF, N, wgu0, wd0, q); });
+            const uint16_t* wg16[16]; const uint16_t* wd16[16]; int32_t c16[16];
+            for (int i = 0; i < 16; ++i) { wg16[i] = wgu[i]; wd16[i] = wd[i]; c16[i] = 32; }
+            per("xmx::grouped_f16 GU 16x32", [&] { strata::prefill::xmx::grouped_f16(Xs, wg16, c16, 16, GUf, 1280, (int) N, q); });
+            per("xmx::grouped_f16 down 16x32", [&] { strata::prefill::xmx::grouped_f16(Hh, wd16, c16, 16, out_a, (int) N, 640, q); });
+            BatchArgs& A = ba[0];
+            for (int i = 0; i < 16; ++i) {
+                A.ta[i] = oneapi::mkl::transpose::trans; A.tb[i] = oneapi::mkl::transpose::nontrans;
+                A.m[i] = 1280; A.n[i] = 32; A.k[i] = N; A.lda[i] = N; A.ldb[i] = N; A.ldc[i] = 1280; A.gs[i] = 1;
+                A.alpha[i] = 1.0f; A.beta[i] = 0.0f;
+                A.a[i] = (const sycl::half*) wgu[i]; A.b[i] = (const sycl::half*) (Xs + i * 32 * N); A.c[i] = GUf + i * 32 * 1280;
+            }
+            per("gemm_batch GU 16 groups x32", [&] {
+                oneapi::mkl::blas::column_major::gemm_batch(*q, A.ta, A.tb, A.m, A.n, A.k, A.alpha, A.a, A.lda, A.b, A.ldb,
+                                                            A.beta, A.c, A.ldc, (int64_t) 16, A.gs,
+                                                            oneapi::mkl::blas::compute_mode::unset); });
+        }
+        per("iq_xmx_grouped GU 16x32", [&] { strata::kernels::iq_xmx_grouped(gt, ga, gb, gc, 16, Xs, GUf, 1280, (int) N, q); });
+        per("iq_xmx_grouped down 16x32", [&] { strata::kernels::iq_xmx_grouped(dt, gd, nullptr, gc, 16, Hh, out_a, (int) N, 640, q); });
+    }
+    return 0;
+}
diff --git a/sycl/src/kernels/night_ep_sum_bench.cpp b/sycl/src/kernels/night_ep_sum_bench.cpp
new file mode 100644
index 00000000..7be1a179
--- /dev/null
+++ b/sycl/src/kernels/night_ep_sum_bench.cpp
@@ -0,0 +1,135 @@
+// night_ep_sum_bench (night lab 2026-10-16): STRATA_NIGHT_PREFILL_F16SUM's kernels against the FP32 reduce/finish on
+// ONE card (the "remote" sum region is local here, so the PCIe time is not measured: the bytes halve), and the
+// STRATA_NIGHT_PREFILL_EARLY doorbell kernels (signal on one queue, wait on another).
+//   night_ep_sum_bench [T=12288] [peer_frac=0.7] [outlier_scale=100]
+#include "strata/kernels/ep_kernels.hpp"
+#include "strata/sycl_queue.hpp"
+#include <sycl/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+using Clock = std::chrono::steady_clock;
+static double ms_since(Clock::time_point a) { return std::chrono::duration<double, std::milli>(Clock::now() - a).count(); }
+
+int main(int argc, char** argv) {
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    const int64_t T = argc > 1 ? std::atoll(argv[1]) : 12288;
+    const double peer_frac = argc > 2 ? std::atof(argv[2]) : 0.7;
+    const float outlier = argc > 3 ? (float) std::atof(argv[3]) : 100.0f;
+    const int64_t N = 2560;
+    const int K = 10;
+    sycl::queue* q = &dpct::get_in_order_queue();
+    std::mt19937 rng(7);
+    // grouped rows: local rows first, then peer rows; every (t, k) gets a distinct row
+    const int64_t R = T * K;
+    std::vector<int32_t> slot((size_t) R);
+    std::vector<char> is_peer((size_t) R);
+    int64_t n_peer = 0;
+    std::uniform_real_distribution<double> u01(0, 1);
+    for (int64_t i = 0; i < R; ++i) { is_peer[i] = u01(rng) < peer_frac; n_peer += is_peer[i]; }
+    const int64_t local_rows = R - n_peer;
+    {
+        std::vector<int64_t> perm_l, perm_p;
+        for (int64_t i = 0; i < local_rows; ++i) perm_l.push_back(i);
+        for (int64_t i = 0; i < n_peer; ++i) perm_p.push_back(local_rows + i);
+        std::shuffle(perm_l.begin(), perm_l.end(), rng);
+        std::shuffle(perm_p.begin(), perm_p.end(), rng);
+        int64_t a = 0, b = 0;
+        for (int64_t i = 0; i < R; ++i) slot[i] = (int32_t) (is_peer[i] ? perm_p[b++] : perm_l[a++]);
+    }
+    std::vector<float> w((size_t) R), gate((size_t) T);
+    for (int64_t t = 0; t < T; ++t) {
+        double s = 0; for (int k = 0; k < K; ++k) { w[t * K + k] = (float) u01(rng); s += w[t * K + k]; }
+        for (int k = 0; k < K; ++k) w[t * K + k] = (float) (w[t * K + k] / s);
+        gate[t] = (float) (u01(rng) * 4 - 2);
+    }
+    // expert rows: N(0, 0.05) with 0.1% outliers x outlier_scale (massive-activation style), and some tiny rows
+    std::normal_distribution<float> nd(0.f, 0.05f);
+    std::vector<float> rows((size_t) R * N), shared((size_t) T * N);
+    for (size_t i = 0; i < rows.size(); ++i) { rows[i] = nd(rng); if (u01(rng) < 1e-3) rows[i] *= outlier; }
+    for (int64_t r = 0; r < R; r += 997) for (int64_t i = 0; i < N; ++i) rows[(size_t) r * N + i] *= 1e-6f;
+    for (auto& x : shared) x = nd(rng);
+    auto dev = [&](auto& v) { using E = typename std::decay_t<decltype(v)>::value_type; E* p = sycl::malloc_device<E>(v.size(), *q); q->memcpy(p, v.data(), v.size() * sizeof(E)); return p; };
+    float* d_rows = dev(rows); float* d_w = dev(w); float* d_gate = dev(gate); float* d_shared = dev(shared);
+    int32_t* d_slot = dev(slot);
+    float* sum32 = sycl::malloc_device<float>((size_t) T * N, *q);
+    float* bo_a = sycl::malloc_device<float>((size_t) T * N, *q);
+    float* bo_b = sycl::malloc_device<float>((size_t) T * N, *q);
+    uint8_t* sumh = sycl::malloc_device<uint8_t>((size_t) T * N * 4, *q);
+    q->wait();
+    std::printf("T %lld rows %lld (peer %lld)\n", (long long) T, (long long) R, (long long) n_peer);
+    auto ref = [&](bool push) {
+        strata::kernels::ep_prefill_reduce(d_rows + (size_t) local_rows * N, d_slot, d_w, sum32, T, local_rows, N, K, q, push);
+        strata::kernels::ep_copy_uncached(bo_a, sum32, (size_t) T * N * 4, q);
+        strata::kernels::ep_prefill_finish(d_rows, d_slot, d_w, d_shared, d_gate, bo_a, T, local_rows, N, K, q);
+    };
+    auto mine = [&](bool push) {
+        strata::kernels::ep_prefill_reduce_h(d_rows + (size_t) local_rows * N, d_slot, d_w, (uint16_t*) sumh,
+                                             (float*) (sumh + (size_t) T * N * 2), T, local_rows, N, K, q, push);
+        strata::kernels::ep_prefill_finish_h(d_rows, d_slot, d_w, d_shared, d_gate, (const uint16_t*) sumh,
+                                             (const float*) (sumh + (size_t) T * N * 2), bo_b, T, local_rows, N, K, q);
+    };
+    auto tm = [&](auto f) { f(); q->wait(); double best = 1e30; for (int r = 0; r < 5; ++r) { auto a = Clock::now(); f(); q->wait(); best = std::min(best, ms_since(a)); } return best; };
+    const double t_red32 = tm([&] { strata::kernels::ep_prefill_reduce(d_rows + (size_t) local_rows * N, d_slot, d_w, sum32, T, local_rows, N, K, q, true); });
+    const double t_redh = tm([&] { strata::kernels::ep_prefill_reduce_h(d_rows + (size_t) local_rows * N, d_slot, d_w, (uint16_t*) sumh, (float*) (sumh + (size_t) T * N * 2), T, local_rows, N, K, q, true); });
+    const double t_fin32 = tm([&] { strata::kernels::ep_copy_uncached(bo_a, sum32, (size_t) T * N * 4, q); strata::kernels::ep_prefill_finish(d_rows, d_slot, d_w, d_shared, d_gate, bo_a, T, local_rows, N, K, q); });
+    const double t_finh = tm([&] { strata::kernels::ep_prefill_finish_h(d_rows, d_slot, d_w, d_shared, d_gate, (const uint16_t*) sumh, (const float*) (sumh + (size_t) T * N * 2), bo_b, T, local_rows, N, K, q); });
+    std::printf("push-mode reduce (64 groups, local target): FP32 %.3f ms (%.1f MB out) | FP16 %.3f ms (%.1f MB out)\n",
+                t_red32, T * N * 4 / 1e6, t_redh, (T * N * 2 + T * 4) / 1e6);
+    std::printf("card-0 side: copy_uncached + finish %.3f ms | finish_h %.3f ms\n", t_fin32, t_finh);
+    ref(true); mine(true); q->wait();
+    std::vector<float> a((size_t) T * N), b((size_t) T * N), s32((size_t) T * N);
+    q->memcpy(a.data(), bo_a, a.size() * 4); q->memcpy(b.data(), bo_b, b.size() * 4); q->memcpy(s32.data(), sum32, s32.size() * 4).wait();
+    // error of the peer sum itself and of the layer output
+    std::vector<uint16_t> hh((size_t) T * N); std::vector<float> sc((size_t) T);
+    q->memcpy(hh.data(), sumh, hh.size() * 2); q->memcpy(sc.data(), sumh + (size_t) T * N * 2, T * 4).wait();
+    double max_rel_sum = 0, mean_rel_sum = 0, max_abs_out = 0, max_out = 0, rms_d = 0, rms_o = 0; size_t nz = 0, nonfin = 0;
+    for (int64_t t = 0; t < T; ++t)
+        for (int64_t i = 0; i < N; ++i) {
+            const size_t j = (size_t) t * N + i;
+            const float hv = (float) sycl::bit_cast<sycl::half>(hh[j]) * sc[t];
+            if (!std::isfinite(hv) || !std::isfinite(b[j])) { ++nonfin; continue; }
+            if (s32[j] != 0.0f) { const double r = std::fabs((hv - s32[j]) / s32[j]); max_rel_sum = std::max(max_rel_sum, r); mean_rel_sum += r; ++nz; }
+            const double d = std::fabs((double) a[j] - b[j]);
+            max_abs_out = std::max(max_abs_out, d); max_out = std::max(max_out, (double) std::fabs(a[j]));
+            rms_d += d * d; rms_o += (double) a[j] * a[j];
+        }
+    std::printf("peer sum FP16xscale vs FP32: max rel %.3e, mean rel %.3e (2^-11 = %.3e); layer output: max abs %.3e "
+                "(max |out| %.3e), rms err / rms out %.3e; non-finite %zu\n",
+                max_rel_sum, mean_rel_sum / std::max<size_t>(nz, 1), std::ldexp(1.0, -11), max_abs_out, max_out,
+                std::sqrt(rms_d / std::max(rms_o, 1e-30)), nonfin);
+    // doorbell on ONE card: a cross-queue spin deadlocks on one compute engine, so this checks the semantics only:
+    // ep_push_signal copies bit-exactly and raises the flag to the value (counter back to 0); ep_wait_value returns at
+    // once on a flag already at/after the value and gives up with err at the bound otherwise.
+    {
+        uint32_t* flag = sycl::malloc_device<uint32_t>(1, *q);
+        uint32_t* done = sycl::malloc_device<uint32_t>(1, *q);
+        uint32_t* err = sycl::malloc_host<uint32_t>(1, *q);
+        uint8_t* dst = sycl::malloc_device<uint8_t>((size_t) T * N * 2, *q);
+        q->memset(flag, 0, 4); q->memset(done, 0, 4); q->memset(dst, 0, (size_t) T * N * 2); q->wait(); *err = 0;
+        const double tp = tm([&] { strata::kernels::ep_push_signal(dst, d_rows, T * N / 8, done, flag, 3u, q); });
+        std::vector<uint8_t> hd((size_t) T * N * 2);
+        uint32_t hf = 0, hdn = 0;
+        q->memcpy(hd.data(), dst, hd.size()); q->memcpy(&hf, flag, 4); q->memcpy(&hdn, done, 4).wait();
+        const bool same = std::memcmp(hd.data(), rows.data(), hd.size()) == 0;
+        std::printf("ep_push_signal (local target): %.3f ms for %.1f MB, copy %s, flag %u (want 3), counter %u (want 0)\n",
+                    tp, hd.size() / 1e6, same ? "bit-exact" : "WRONG", hf, hdn);
+        auto a0 = Clock::now();
+        strata::kernels::ep_wait_value(flag, 2u, 50000000u, err, 1u, q);
+        strata::kernels::ep_wait_value(flag, 3u, 50000000u, err, 2u, q);
+        q->wait();
+        std::printf("ep_wait_value on flag 3 for 2 and 3: %.3f ms, err %u (want 0)\n", ms_since(a0), *err);
+        a0 = Clock::now();
+        strata::kernels::ep_wait_value(flag, 4u, 200000u, err, 3u, q);   // never signalled: must give up with err = 3
+        q->wait();
+        std::printf("ep_wait_value bound: err %u (want 3) after %.1f ms (200000 spins)\n", *err, ms_since(a0));
+    }
+    return 0;
+}
diff --git a/sycl/src/kernels/night_grouped_bench.cpp b/sycl/src/kernels/night_grouped_bench.cpp
new file mode 100644
index 00000000..a1f890a3
--- /dev/null
+++ b/sycl/src/kernels/night_grouped_bench.cpp
@@ -0,0 +1,322 @@
+// night_grouped_bench (night lab 2026-10-16): night_grouped_f16 (grouped decode + joint_matrix expert GEMM, one launch)
+// against the engine's path per expert (iq_dequant_gu_f16 / iq_dequant_f16 + oneMKL FP16 GEMM), on ONE card.
+//   night_grouped_bench gu|down ty n_exp M [M ...]        (fixed M rows per expert)
+//   night_grouped_bench mix gt dt T n_exp median sigma max_rows   (lognormal mix, experts <= max_rows only, GU + down)
+#include "strata/kernels/iq_kernels.hpp"
+#include "strata/kernels/night_grouped.hpp"
+#include "strata/prefill/gemm.hpp"
+#include "strata/prefill/kernels.hpp"
+#include "strata/sycl_queue.hpp"
+#include <sycl/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <string>
+#include <vector>
+
+using Clock = std::chrono::steady_clock;
+static double ms_since(Clock::time_point a) { return std::chrono::duration<double, std::milli>(Clock::now() - a).count(); }
+static uint16_t f2h(float f) { return sycl::bit_cast<uint16_t>(sycl::half(f)); }
+namespace sk = strata::kernels;
+
+struct Ctx {
+    sycl::queue* q;   // in order, profiling
+    uint32_t* sink;
+    uint32_t busy_iters = 1u << 20;
+    sycl::event busy() {
+        uint32_t* s = sink; const uint32_t n = busy_iters;
+        return q->single_task<class ng_busy>([=] { uint32_t x = 1; for (uint32_t i = 0; i < n; ++i) x = x * 1664525u + 1013904223u; *s = x; });
+    }
+    sycl::event marker() { return q->single_task<class ng_marker>([] {}); }
+    void calibrate() {
+        for (int t = 0; t < 12; ++t) {
+            q->wait(); auto a = Clock::now(); busy(); q->wait(); const double ms = ms_since(a);
+            if (ms > 20) break;
+            busy_iters = (uint32_t) std::min<double>(4.0e9, busy_iters * std::max(2.0, 30.0 / std::max(ms, 0.01)));
+        }
+    }
+    // best of reps: host enqueue ms (queued behind the busy kernel) and GPU ms (profiling: from the busy kernel's
+    // end to a marker kernel's start)
+    template <class F> void time(F f, int reps, double& host, double& gpu) {
+        f(); q->wait();
+        host = gpu = 1e30;
+        for (int r = 0; r < reps; ++r) {
+            q->wait();
+            sycl::event e0 = busy();
+            auto b = Clock::now();
+            f();
+            const double h = ms_since(b);
+            sycl::event e1 = marker();
+            q->wait();
+            const double g = (double) (e1.get_profiling_info<sycl::info::event_profiling::command_start>() -
+                                       e0.get_profiling_info<sycl::info::event_profiling::command_end>()) * 1e-6;
+            host = std::min(host, h); gpu = std::min(gpu, g);
+        }
+    }
+};
+
+static std::vector<uint8_t> rand_mat(std::mt19937& rng, int ty, int64_t rows, int64_t K) {
+    const size_t rb = sk::iq_row_bytes(ty, K);
+    const int blk = ty == 20 ? 32 : ty == 42 ? 64 : 256;
+    const size_t bb = sk::iq_row_bytes(ty, blk);
+    std::vector<uint8_t> b(rb * rows);
+    for (auto& x : b) x = (uint8_t) rng();
+    for (size_t o = 0; o + 1 < b.size(); o += bb) { b[o] = 0x00; b[o + 1] = 0x2C; }   // d = 0.0625
+    return b;
+}
+
+int main(int argc, char** argv) {
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    if (argc < 3) { std::printf("usage: see source\n"); return 2; }
+    const std::string mode = argv[1];
+    sycl::queue* q = new sycl::queue(dpct::get_in_order_queue().get_context(), dpct::get_in_order_queue().get_device(),
+                                     {sycl::property::queue::in_order(), sycl::property::queue::enable_profiling()});
+    Ctx cx{q, sycl::malloc_device<uint32_t>(1, *q)};
+    cx.calibrate();
+    std::mt19937 rng(11);
+    const int64_t NE = 2560, FF = 640;
+    strata::prefill::Gemm gemm;
+    std::string err;
+    if (!gemm.init(q, 1 << 20, err)) { std::printf("gemm init: %s\n", err.c_str()); return 2; }
+    std::normal_distribution<float> nd(0.f, 1.f);
+
+    // one projection over a list of experts with their row counts; returns nothing, prints a line
+    auto run = [&](bool gu, int ty, const std::vector<int32_t>& cnt, const char* tag) {
+        const int n = (int) cnt.size();
+        const int64_t N = gu ? 2 * FF : NE, K = gu ? NE : FF;
+        const size_t mat = sk::iq_row_bytes(ty, K) * (gu ? FF : NE);
+        const size_t up_off = gu ? mat : 0, blob = gu ? 2 * mat : mat;
+        std::vector<int64_t> off(n + 1, 0);
+        for (int i = 0; i < n; ++i) off[i + 1] = off[i] + cnt[i];
+        const int64_t rows = off[n];
+        uint8_t* W = sycl::malloc_device<uint8_t>(blob * n, *q);
+        for (int i = 0; i < n; ++i) {
+            auto g = rand_mat(rng, ty, gu ? FF : NE, K);
+            q->memcpy(W + (size_t) i * blob, g.data(), mat);
+            if (gu) { auto u = rand_mat(rng, ty, FF, K); q->memcpy(W + (size_t) i * blob + up_off, u.data(), mat); }
+            q->wait();
+        }
+        std::vector<uint16_t> hx((size_t) (rows + 64) * K);
+        for (auto& x : hx) x = f2h(nd(rng) * 0.25f);
+        uint16_t* X = sycl::malloc_device<uint16_t>(hx.size(), *q);
+        q->memcpy(X, hx.data(), hx.size() * 2);
+        uint16_t* dq = sycl::malloc_device<uint16_t>((size_t) N * K, *q);
+        float* yr = sycl::malloc_device<float>((size_t) rows * N, *q);
+        float* yn = sycl::malloc_device<float>((size_t) rows * N, *q);
+        q->wait();
+        auto ref = [&]() {
+            for (int i = 0; i < n; ++i) {
+                const uint8_t* b = W + (size_t) i * blob;
+                if (gu) sk::iq_dequant_gu_f16(ty, b, b + up_off, FF, NE, dq, q);
+                else sk::iq_dequant_f16(ty, b, NE * FF, dq, q);
+                gemm.f16(X + off[i] * K, dq, yr + off[i] * N, cnt[i], N, K);
+            }
+        };
+        // entries: each expert cut into chunks of <= 8 * mt rows; mt from the expert's own count
+        static const int mt_max = [] { const char* e = std::getenv("NIGHTG_MTMAX"); return e ? std::atoi(e) : 8; }();
+        auto pick_mt = [](int c) { return c <= 16 ? 2 : c <= 32 ? 4 : (c <= 64 || mt_max < 16) ? 8 : 16; };
+        std::vector<sk::NightGroupedEntry> ents[4];
+        for (int i = 0; i < n; ++i) {
+            const int mt = pick_mt(cnt[i]);
+            const int cap = sk::night_grouped_rows(mt);
+            for (int r = 0; r < cnt[i]; r += cap)
+                ents[mt == 2 ? 0 : mt == 4 ? 1 : mt == 8 ? 2 : 3].push_back({W + (size_t) i * blob, off[i] + r, std::min(cap, cnt[i] - r), 0});
+        }
+        sk::NightGroupedEntry* ed[4];
+        for (int t = 0; t < 4; ++t) {
+            ed[t] = sycl::malloc_device<sk::NightGroupedEntry>(std::max<size_t>(1, ents[t].size()), *q);
+            if (!ents[t].empty()) q->memcpy(ed[t], ents[t].data(), ents[t].size() * sizeof(sk::NightGroupedEntry));
+        }
+        q->wait();
+        bool ok = true;
+        auto mine = [&]() {
+            const int mts[4] = {2, 4, 8, 16};
+            for (int t = 0; t < 4; ++t)
+                if (!ents[t].empty())
+                    ok &= sk::night_grouped_f16(ty, gu, ed[t], (int) ents[t].size(), mts[t], X, yn, (int) N, (int) K, up_off, q);
+        };
+        double hr, gr, hm, gm;
+        cx.time(ref, 3, hr, gr);
+        cx.time(mine, 3, hm, gm);
+        if (!ok) { std::printf("%s: night_grouped_f16 refused type %d\n", tag, ty); return; }
+        std::vector<float> a((size_t) rows * N), b((size_t) rows * N);
+        q->memcpy(a.data(), yr, a.size() * 4); q->memcpy(b.data(), yn, b.size() * 4).wait();
+        double mx = 0, em = 0, s2 = 0, d2 = 0; size_t nf = 0;
+        for (size_t i = 0; i < a.size(); ++i) {
+            if (!std::isfinite(b[i])) { ++nf; continue; }
+            const double d = std::fabs((double) a[i] - b[i]);
+            em = std::max(em, d); mx = std::max(mx, (double) std::fabs(a[i])); s2 += (double) a[i] * a[i]; d2 += d * d;
+        }
+        const double flop = 2.0 * rows * N * K;
+        std::printf("%-6s %-4s ty %2d experts %3d rows %6lld | ref host %7.3f gpu %7.3f ms | grouped host %6.3f gpu %7.3f ms "
+                    "(%5.2fx, %5.1f TFLOPS) | max abs %.2e / max %.2e, rms rel %.2e%s\n",
+                    tag, gu ? "GU" : "down", ty, n, (long long) rows, hr, gr, hm, gm, gr / gm, flop / gm * 1e-9, em, mx,
+                    std::sqrt(d2 / std::max(s2, 1e-30)), nf ? " NONFINITE" : "");
+        sycl::free(W, *q); sycl::free(X, *q); sycl::free(dq, *q); sycl::free(yr, *q); sycl::free(yn, *q);
+        for (auto* p : ed) sycl::free(p, *q);
+    };
+
+    // pipe: the engine's card-1 layer as STRATA_NIGHT_PREFILL_GROUPED runs it (prefill.cpp): rows small-first, ONE
+    // FP16 gather into the FP32 rows region (alias), large experts per expert from the highest offset (dequant + oneMKL,
+    // in place), then batches of small experts (<= T rows) from the last batch down: grouped gate/up -> GUf, one
+    // swiglu -> Hh, grouped down -> rows in place.  Compared with every expert on the reference path (no alias).
+    //   night_grouped_bench pipe gt dt T n_exp median sigma G
+    if (mode == "pipe") {
+        const int gt = std::atoi(argv[2]), dt = std::atoi(argv[3]);
+        const int64_t T = std::atoll(argv[4]);
+        const int n = std::atoi(argv[5]);
+        const double med = std::atof(argv[6]), sig = std::atof(argv[7]);
+        const int G = std::atoi(argv[8]);
+        std::lognormal_distribution<double> ld(std::log(med), sig);
+        std::vector<int32_t> cnt(n);
+        for (auto& c : cnt) c = (int) std::clamp<double>(std::round(ld(rng)), 1.0, (double) T);
+        std::vector<int> order;   // small first (id order), then large
+        for (int e = 0; e < n; ++e) if (cnt[e] <= G) order.push_back(e);
+        const size_t ng_n = order.size();
+        for (int e = 0; e < n; ++e) if (cnt[e] > G) order.push_back(e);
+        std::vector<int64_t> off(n);
+        int64_t R = 0;
+        for (int e : order) { off[e] = R; R += cnt[e]; }
+        const size_t gmat = sk::iq_row_bytes(gt, NE) * FF, dmat = sk::iq_row_bytes(dt, FF) * NE;
+        const size_t up_off = gmat, down_off = 2 * gmat, blob = (down_off + dmat + 255) & ~(size_t) 255;
+        uint8_t* W = sycl::malloc_device<uint8_t>(blob * n, *q);
+        for (int e = 0; e < n; ++e) {
+            auto g = rand_mat(rng, gt, FF, NE), u = rand_mat(rng, gt, FF, NE), d = rand_mat(rng, dt, NE, FF);
+            q->memcpy(W + e * blob, g.data(), gmat); q->memcpy(W + e * blob + up_off, u.data(), gmat);
+            q->memcpy(W + e * blob + down_off, d.data(), dmat); q->wait();
+        }
+        std::vector<uint16_t> hx((size_t) R * NE);
+        for (auto& x : hx) x = f2h(nd(rng) * 0.25f);
+        uint16_t* Xg = sycl::malloc_device<uint16_t>(hx.size(), *q);          // the gathered rows (stand-in for the gather)
+        q->memcpy(Xg, hx.data(), hx.size() * 2);
+        float* rows = sycl::malloc_device<float>((size_t) R * NE, *q);        // alias region (FP32 rows; FP16 inputs first)
+        float* ref = sycl::malloc_device<float>((size_t) R * NE, *q);
+        uint16_t* dqg = sycl::malloc_device<uint16_t>((size_t) 1280 * NE, *q);
+        uint16_t* dqd = sycl::malloc_device<uint16_t>((size_t) NE * 640, *q);
+        float* GUf = sycl::malloc_device<float>((size_t) T * 1280, *q);
+        uint16_t* Hh = sycl::malloc_device<uint16_t>((size_t) T * 640, *q);
+        auto* ent = sycl::malloc_device<sk::NightGroupedEntry>(2 * 512 * 16, *q);
+        q->wait();
+        auto one = [&](int e, const uint16_t* x, float* y) {   // the engine's per-expert path
+            const uint8_t* bd = W + e * blob;
+            sk::iq_dequant_gu_f16(gt, bd, bd + up_off, FF, NE, dqg, q);
+            sk::iq_dequant_f16(dt, bd + down_off, NE * FF, dqd, q);
+            gemm.f16(x, dqg, GUf, cnt[e], 1280, NE);
+            strata::prefill::swiglu_interleaved(GUf, Hh, cnt[e], q);
+            gemm.f16(Hh, dqd, y, cnt[e], NE, 640);
+        };
+        // reference: every expert, inputs from Xg, outputs to ref
+        for (int e = 0; e < n; ++e) one(e, Xg + off[e] * NE, ref + off[e] * NE);
+        q->wait();
+        std::vector<sk::NightGroupedEntry> host;
+        auto engine = [&]() {
+            uint16_t* alias_x = reinterpret_cast<uint16_t*>(rows);
+            q->memcpy(alias_x, Xg, (size_t) R * NE * 2);   // the one gather
+            for (size_t j = order.size(); j-- > ng_n;) { const int e = order[j]; one(e, alias_x + off[e] * NE, rows + off[e] * NE); }
+            struct Batch { int64_t a, rows; size_t gu[4][2]; };
+            std::vector<Batch> batches;
+            host.clear();
+            std::vector<sk::NightGroupedEntry> dn;
+            size_t j = 0;
+            while (j < ng_n) {
+                Batch b{};
+                b.a = off[order[j]];
+                size_t j1 = j; int64_t br = 0;
+                while (j1 < ng_n && br + cnt[order[j1]] <= T) br += cnt[order[j1++]];
+                b.rows = br;
+                for (int t = 0; t < 4; ++t) {
+                    const int cap = sk::night_grouped_rows(2 << t);
+                    b.gu[t][0] = host.size();
+                    for (size_t i = j; i < j1; ++i) {
+                        const int e = order[i]; const int c = cnt[e];
+                        if ((c <= 16 ? 0 : c <= 32 ? 1 : c <= 64 ? 2 : 3) != t) continue;
+                        const uint8_t* bd = W + e * blob;
+                        for (int r0 = 0; r0 < c; r0 += cap) {
+                            host.push_back({bd, off[e] - b.a + r0, std::min(cap, c - r0), 0});
+                            dn.push_back({bd + down_off, off[e] - b.a + r0, std::min(cap, c - r0), 0});
+                        }
+                    }
+                    b.gu[t][1] = host.size();
+                }
+                batches.push_back(b);
+                j = j1;
+            }
+            const size_t ne_gu = host.size();
+            host.insert(host.end(), dn.begin(), dn.end());
+            q->memcpy(ent, host.data(), host.size() * sizeof(sk::NightGroupedEntry));
+            for (size_t bi = batches.size(); bi-- > 0;) {
+                const Batch& b = batches[bi];
+                for (int t = 0; t < 4; ++t) {
+                    const int c = (int) (b.gu[t][1] - b.gu[t][0]);
+                    if (c > 0) sk::night_grouped_f16(gt, true, ent + b.gu[t][0], c, 2 << t, alias_x + b.a * NE, GUf, 1280, (int) NE, up_off, q);
+                }
+                strata::prefill::swiglu_interleaved(GUf, Hh, b.rows, q);
+                for (int t = 0; t < 4; ++t) {
+                    const int c = (int) (b.gu[t][1] - b.gu[t][0]);
+                    if (c > 0) sk::night_grouped_f16(dt, false, ent + ne_gu + b.gu[t][0], c, 2 << t, Hh, rows + b.a * NE, (int) NE, 640, 0, q);
+                }
+            }
+            return batches.size();
+        };
+        double hb, gb;
+        size_t nb = 0;
+        cx.time([&] { nb = engine(); }, 3, hb, gb);
+        // reference timing: the same layer all per expert (with the gather copy)
+        double hr, gr;
+        cx.time([&] {
+            uint16_t* alias_x = reinterpret_cast<uint16_t*>(rows + (size_t) 0);
+            (void) alias_x;
+            for (size_t jj = order.size(); jj-- > 0;) { const int e = order[jj]; one(e, Xg + off[e] * NE, ref + off[e] * NE); }
+        }, 3, hr, gr);
+        cx.time([&] { nb = engine(); }, 1, hb, gb);   // leave the engine's result in rows
+        std::vector<float> a((size_t) R * NE), b((size_t) R * NE);
+        q->memcpy(a.data(), ref, a.size() * 4); q->memcpy(b.data(), rows, b.size() * 4).wait();
+        double mxs = 0, ems = 0, s2 = 0, d2 = 0; size_t diff_large = 0, nf = 0;
+        for (int e = 0; e < n; ++e)
+            for (int64_t i = off[e] * NE; i < (off[e] + cnt[e]) * NE; ++i) {
+                if (!std::isfinite(b[i])) { ++nf; continue; }
+                const double d = std::fabs((double) a[i] - b[i]);
+                if (cnt[e] > G) diff_large += a[i] != b[i];
+                else { ems = std::max(ems, d); mxs = std::max(mxs, (double) std::fabs(a[i])); s2 += (double) a[i] * a[i]; d2 += d * d; }
+            }
+        std::printf("pipe gt %d dt %d T %lld: %d experts (%zu <= %d rows), %lld rows, %zu batches | per-expert path host %.2f gpu %.2f ms | "
+                    "engine path host %.2f gpu %.2f ms | large experts: %zu values differ (want 0); small: max abs %.2e / max %.2e, "
+                    "rms rel %.2e; non-finite %zu\n", gt, dt, (long long) T, n, ng_n, G, (long long) R, nb, hr, gr, hb, gb,
+                    diff_large, ems, mxs, std::sqrt(d2 / std::max(s2, 1e-30)), nf);
+        return 0;
+    }
+    if (mode == "gu" || mode == "down") {
+        const int ty = std::atoi(argv[2]);
+        const int n = std::atoi(argv[3]);
+        for (int i = 4; i < argc; ++i) {
+            const int M = std::atoi(argv[i]);
+            std::vector<int32_t> cnt(n, M);
+            run(mode == "gu", ty, cnt, ("M=" + std::to_string(M)).c_str());
+        }
+    } else if (mode == "mix") {
+        const int gt = std::atoi(argv[2]), dt = std::atoi(argv[3]);
+        const int64_t T = std::atoll(argv[4]);
+        const int n = std::atoi(argv[5]);
+        const double med = std::atof(argv[6]), sig = std::atof(argv[7]);
+        const int maxr = std::atoi(argv[8]);
+        std::lognormal_distribution<double> ld(std::log(med), sig);
+        std::vector<int32_t> cnt;
+        int64_t all = 0;
+        for (int i = 0; i < n; ++i) {
+            const int c = (int) std::clamp<double>(std::round(ld(rng)), 1.0, (double) T);
+            all += c;
+            if (c <= maxr) cnt.push_back(c);
+        }
+        std::printf("mix: %d of %d experts have <= %d rows (%lld of %lld rows)\n", (int) cnt.size(), n, maxr,
+                    (long long) std::accumulate(cnt.begin(), cnt.end(), 0LL), (long long) all);
+        run(true, gt, cnt, "mix");
+        run(false, dt, cnt, "mix");
+    }
+    return 0;
+}
diff --git a/sycl/src/kernels/night_mmvq_bench.cpp b/sycl/src/kernels/night_mmvq_bench.cpp
new file mode 100644
index 00000000..d0cf10e3
--- /dev/null
+++ b/sycl/src/kernels/night_mmvq_bench.cpp
@@ -0,0 +1,151 @@
+// sycl/src/kernels/night_mmvq_bench.cpp - STRATA_NIGHT_MMVQ A/B through the public native_mmvq / native_mmvq_head API:
+// the original dispatch (night off) against the night KREG kernels (night on) at the decode shapes and window widths,
+// random valid weights, native_quantize_q8_1 activations, NMAT distinct weight copies per graph (>= ~600 MB streamed
+// per replay, so L2 never holds a matrix), in-order queue graph replay. Prints us/call, GB/s of weights, the speedup
+// and the max abs / max rel error of night against the original on matrix 0.
+//     night_mmvq_bench [types=14,13,12] [ncols=1,2,3,4,6] [shape=all|name]
+#define DPCT_PROFILING_ENABLED
+#include <sycl/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include "strata/kernels/native_mmvq.hpp"
+#include "strata/kernels/native_head_mmvq.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace strata::kernels { void native_mmvq_set_night(int on); }
+namespace k = strata::kernels;
+namespace sx = sycl::ext::oneapi::experimental;
+
+namespace {
+uint64_t rs = 0x9E3779B97F4A7C15ull;
+inline uint64_t xr() { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs; }
+int block_bytes(int t) { return t == 12 ? 144 : t == 13 ? 176 : t == 14 ? 210 : t == 23 ? 136 : t == 20 ? 18 : t == 21 ? 110 : 34; }
+const char* fname(int t) { return t == 12 ? "Q4_K" : t == 13 ? "Q5_K" : t == 14 ? "Q6_K" : t == 23 ? "IQ4_XS" : t == 20 ? "IQ4_NL" : t == 21 ? "IQ3_S" : "Q8_0"; }
+void fill_pool(int t, std::vector<uint8_t>& h) {   // random bytes, finite small fp16 scales (~2^-10) at the format's offsets
+    uint64_t* p = (uint64_t*) h.data();
+    for (size_t i = 0; i < h.size() / 8; ++i) p[i] = xr();
+    const size_t bs = block_bytes(t), nb = h.size() / bs;
+    for (size_t b = 0; b < nb; ++b) {
+        uint8_t* o = &h[b * bs];
+        const uint16_t d = (uint16_t) (0x1400 | (xr() & 0x3ff)), m = (uint16_t) (0x1400 | (xr() & 0x3ff));
+        std::memcpy(o + (t == 14 ? 208 : 0), &d, 2);
+        if (t == 12 || t == 13) std::memcpy(o + 2, &m, 2);
+    }
+}
+std::vector<int> parse_list(const char* s) {
+    std::vector<int> v; std::string t(s); size_t p = 0;
+    while (p < t.size()) { size_t e = t.find(',', p); if (e == std::string::npos) e = t.size(); v.push_back(std::atoi(t.substr(p, e - p).c_str())); p = e + 1; }
+    return v;
+}
+double time_graph(sycl::queue& q, int nmat, const std::function<void(int)>& launch, int reps) {
+    sx::command_graph g(q.get_context(), q.get_device());
+    g.begin_recording(q);
+    for (int m = 0; m < nmat; ++m) launch(m);
+    g.end_recording(q);
+    auto ge = g.finalize();
+    for (int i = 0; i < 2; ++i) q.ext_oneapi_graph(ge);
+    q.wait();
+    std::vector<double> us;
+    for (int i = 0; i < reps; ++i) {
+        sycl::event e0 = q.ext_oneapi_submit_barrier();
+        q.ext_oneapi_graph(ge);
+        sycl::event e1 = q.ext_oneapi_submit_barrier();
+        e1.wait();
+        us.push_back(double(e1.get_profiling_info<sycl::info::event_profiling::command_end>() -
+                            e0.get_profiling_info<sycl::info::event_profiling::command_start>()) / 1e3 / nmat);
+    }
+    std::sort(us.begin(), us.end());
+    return us[us.size() / 2];
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    const std::vector<int> types = parse_list(argc > 1 ? argv[1] : "14,13,12");
+    const std::vector<int> ncl = parse_list(argc > 2 ? argv[2] : "1,2,3,4,6");
+    const std::string ssel = argc > 3 ? argv[3] : "all";
+    const size_t POOL = (size_t) 640 << 20;
+    sycl::queue q(sycl::gpu_selector_v, {sycl::property::queue::in_order(), sycl::property::queue::enable_profiling()});
+    struct Shape { int n_in, n_out; const char* name; };
+    const Shape shapes[] = {{2560, 10240, "qkv"}, {2560, 6144, "gate"}, {6144, 2560, "out"}, {2560, 12288, "attn_q"},
+                            {2560, 512, "kv"}, {2560, 640, "sh_gu"}, {2560, 248320, "head"}, {640, 2560, "sh_down"}};
+    uint8_t* dpool = (uint8_t*) sycl::malloc_device(POOL + 4096, q);
+    std::vector<uint8_t> hpool(POOL);
+    const int maxc = 16, maxout = 248320;
+    float* y = sycl::malloc_device<float>((size_t) maxc * maxout, q);
+    float* y2 = sycl::malloc_device<float>((size_t) maxc * maxout, q);
+    std::vector<float> hx((size_t) maxc * 6144);
+    for (auto& v : hx) {
+        const double u1 = (xr() >> 11) * (1.0 / 9007199254740992.0) + 1e-12, u2 = (xr() >> 11) * (1.0 / 9007199254740992.0);
+        v = (float) (std::sqrt(-2 * std::log(u1)) * std::cos(6.283185307179586 * u2));
+    }
+    float* dx = sycl::malloc_device<float>(hx.size(), q);
+    q.memcpy(dx, hx.data(), hx.size() * 4).wait();
+    void* xq = sycl::malloc_device((size_t) maxc * (6144 / 32) * 36 + 256, q);
+    std::printf("night_mmvq_bench: original dispatch vs STRATA_NIGHT_MMVQ (KREG); us/call median, GB/s of weights\n");
+    for (const int t : types) {
+        fill_pool(t, hpool);
+        q.memcpy(dpool, hpool.data(), POOL).wait();
+        for (const Shape& sh : shapes) {
+            if (ssel != "all" && ssel != sh.name) continue;
+            const bool head = std::string(sh.name) == "head";
+            if (head && t != 13) continue;
+            if ((t == 20) != (std::string(sh.name) == "sh_down")) continue;   // IQ4_NL: the shared-expert down only
+            const size_t wb = k::native_mmvq_weight_bytes(t, sh.n_in, sh.n_out);
+            const size_t slot = (wb + 255) & ~(size_t) 255;
+            const int ndist = (int) std::min<size_t>(128, POOL / slot), nmat = std::max(ndist, 16);
+            for (const int nc : ncl) {
+                for (int c0 = 0; c0 < nc; c0 += 8)   // the quantizer takes <= 8 columns per call
+                    k::native_quantize_q8_1(dx + (size_t) c0 * sh.n_in, (uint8_t*) xq + (size_t) c0 * (sh.n_in / 32) * 36, sh.n_in,
+                                            std::min(8, nc - c0), &q);
+                q.wait();
+                // level 0 = original, 1 = STRATA_NIGHT_MMVQ, 2 = + STRATA_NIGHT_MMVQ2. Above 8 columns levels 0/1 are two
+                // calls of 8 + (nc - 8) columns (what a caller has to do without level 2).
+                auto call = [&](const uint8_t* w, float* out, int level) {
+                    auto one = [&](const uint8_t* xx, float* oo, int c) {
+                        if (head) k::native_mmvq_head(t, w, xx, oo, sh.n_in, sh.n_out, c, &q);
+                        else k::native_mmvq(t, w, xx, oo, sh.n_in, sh.n_out, c, &q);
+                    };
+                    if (nc <= 8 || level == 2) one((const uint8_t*) xq, out, nc);
+                    else { one((const uint8_t*) xq, out, 8); one((const uint8_t*) xq + (size_t) 8 * (sh.n_in / 32) * 36, out + (size_t) 8 * sh.n_out, nc - 8); }
+                };
+                const size_t ny = (size_t) nc * sh.n_out;
+                std::vector<float> res[3];
+                double us[3];
+                for (int lv = 0; lv < 3; ++lv) {
+                    k::native_mmvq_set_night(lv);
+                    res[lv].resize(ny);
+                    q.memset(y2, 0, ny * 4).wait();
+                    call(dpool, y2, lv); q.wait();
+                    q.memcpy(res[lv].data(), y2, ny * 4).wait();
+                    us[lv] = time_graph(q, nmat, [&](int m) { call(dpool + (size_t) (m % ndist) * slot, y, lv); }, wb > (100u << 20) ? 7 : 11);
+                }
+                k::native_mmvq_set_night(-1);
+                const std::vector<float>& ref = res[0];
+                double rmax = 0; size_t bad = 0;
+                for (size_t i = 0; i < ny; ++i) rmax = std::max(rmax, (double) std::fabs(ref[i]));
+                double mabs[3] = {0, 0, 0}, mrel[3] = {0, 0, 0};
+                for (int lv = 1; lv < 3; ++lv)
+                    for (size_t i = 0; i < ny; ++i) {
+                        const double e = std::fabs((double) res[lv][i] - ref[i]);
+                        if (!(e <= 1e30)) ++bad;
+                        mabs[lv] = std::max(mabs[lv], e);
+                        if (std::fabs(ref[i]) > 1e-3 * rmax) mrel[lv] = std::max(mrel[lv], e / std::fabs(ref[i]));
+                    }
+                std::printf("%-6s %-6s %5d x %6d nc %2d  orig %8.2f  lv1 %8.2f  lv2 %8.2f us (%4.1f%% of 608)  lv2/lv1 x%.2f  orig/lv2 x%.2f  "
+                            "err lv1 %.1e/%.1e lv2 %.1e/%.1e (abs/rel, max|y| %.1e)%s\n",
+                            fname(t), sh.name, sh.n_in, sh.n_out, nc, us[0], us[1], us[2], wb / us[2] / 1e3 / 6.08,
+                            us[1] / us[2], us[0] / us[2], mabs[1], mrel[1], mabs[2], mrel[2], rmax, bad ? " NONFINITE" : "");
+                std::fflush(stdout);
+            }
+        }
+    }
+    sycl::free(dpool, q); sycl::free(y, q); sycl::free(y2, q); sycl::free(dx, q); sycl::free(xq, q);
+    return 0;
+}
diff --git a/sycl/src/kernels/night_shexp_bench.cpp b/sycl/src/kernels/night_shexp_bench.cpp
new file mode 100644
index 00000000..f7acd8f4
--- /dev/null
+++ b/sycl/src/kernels/night_shexp_bench.cpp
@@ -0,0 +1,155 @@
+// sycl/src/kernels/night_shexp_bench.cpp - STRATA_NIGHT_SHEXP A/B: shared_expert_multi (native bf16 gate path, x_q8_1
+// ready as in the verifier) with the original launches vs the fused night path, for the (gate, up, down) type triples
+// of the Flash-Next pack, NL distinct layers per graph (> L2), in-order queue graph replay; us per layer call and the
+// max abs / bitwise differences of `out`.
+//     night_shexp_bench [ncols=1,4,6,8] [mmvq_level=2]
+#define DPCT_PROFILING_ENABLED
+#include <sycl/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include "strata/kernels/native_mmvq.hpp"
+#include "strata/kernels/shared_expert.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "strata/kernels/bf16_gemv.hpp"
+namespace strata::kernels {
+void native_mmvq_set_night(int on); void night_shexp_set(int on);
+bool night_shexp_gu_swiglu_q8(int gate_type, const void* wg, int up_type, const void* wu, const void* x_q8_1, float* h,
+                              void* q8, int n_embd, int n_ff, int ncols, void* stream, const float* xf, const uint16_t* wrow,
+                              float* graw);
+bool night_shexp_down_scale(int down_type, const void* wd, const void* q8, const float* graw, float* out, int n_ff, int n_embd,
+                            int ncols, void* stream);
+}
+namespace k = strata::kernels;
+namespace sx = sycl::ext::oneapi::experimental;
+
+namespace {
+uint64_t rs = 0x9E3779B97F4A7C15ull;
+inline uint64_t xr() { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs; }
+size_t bsz(int t) { return t == 12 ? 144 : t == 13 ? 176 : t == 14 ? 210 : t == 23 ? 136 : t == 21 ? 110 : t == 20 ? 18 : t == 42 ? 18 : 34; }
+void fill(int t, uint8_t* h, size_t n) {
+    uint64_t* p = (uint64_t*) h;
+    for (size_t i = 0; i < n / 8; ++i) p[i] = xr();
+    const size_t bs = bsz(t);
+    for (size_t o = 0; o + bs <= n; o += bs) {
+        const uint16_t d = (uint16_t) (0x1400 | (xr() & 0x3ff)), m = (uint16_t) (0x1400 | (xr() & 0x3ff));
+        std::memcpy(h + o + (t == 14 ? 208 : 0), &d, 2);
+        if (t == 12 || t == 13) std::memcpy(h + o + 2, &m, 2);
+    }
+}
+std::vector<int> parse_list(const char* s) {
+    std::vector<int> v; std::string t(s); size_t p = 0;
+    while (p < t.size()) { size_t e = t.find(',', p); if (e == std::string::npos) e = t.size(); v.push_back(std::atoi(t.substr(p, e - p).c_str())); p = e + 1; }
+    return v;
+}
+double time_graph(sycl::queue& q, int n, const std::function<void(int)>& f, int reps) {
+    sx::command_graph g(q.get_context(), q.get_device());
+    g.begin_recording(q);
+    for (int i = 0; i < n; ++i) f(i);
+    g.end_recording(q);
+    auto ge = g.finalize();
+    for (int i = 0; i < 2; ++i) q.ext_oneapi_graph(ge);
+    q.wait();
+    std::vector<double> us;
+    for (int i = 0; i < reps; ++i) {
+        sycl::event e0 = q.ext_oneapi_submit_barrier();
+        q.ext_oneapi_graph(ge);
+        sycl::event e1 = q.ext_oneapi_submit_barrier();
+        e1.wait();
+        us.push_back(double(e1.get_profiling_info<sycl::info::event_profiling::command_end>() -
+                            e0.get_profiling_info<sycl::info::event_profiling::command_start>()) / 1e3 / n);
+    }
+    std::sort(us.begin(), us.end());
+    return us[us.size() / 2];
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    const std::vector<int> ncl = parse_list(argc > 1 ? argv[1] : "1,4,6,8");
+    const int level = argc > 2 ? std::atoi(argv[2]) : 2;
+    sycl::queue q(sycl::gpu_selector_v, {sycl::property::queue::in_order(), sycl::property::queue::enable_profiling()});
+    const int N = 2560, FF = 640, NL = 48;
+    struct Combo { int g, u, d, layers; };
+    const Combo combos[] = {{23, 21, 20, 8}, {21, 21, 20, 7}, {12, 21, 20, 8}, {23, 23, 20, 6}, {21, 23, 20, 3}, {23, 12, 20, 2},
+                            {23, 14, 20, 2}, {12, 12, 20, 2}, {21, 21, 42, 2}, {23, 14, 42, 1}};
+    k::shared_expert_set_native_bf16(true);
+    k::native_mmvq_set_night(level);
+    std::printf("night_shexp_bench: %d layers per graph, mmvq level %d; us per shared-expert call: orig (6 launches) vs night\n", NL, level);
+    float* x = sycl::malloc_device<float>((size_t) 8 * N, q);
+    std::vector<float> hx((size_t) 8 * N);
+    for (auto& v : hx) v = (float) ((double) (xr() >> 11) / 9007199254740992.0 * 2.0 - 1.0);
+    q.memcpy(x, hx.data(), hx.size() * 4).wait();
+    void* xq = sycl::malloc_device(k::native_q8_1_bytes(N, 8) + 256, q);
+    float *gate = sycl::malloc_device<float>((size_t) 8 * FF, q), *up = sycl::malloc_device<float>((size_t) 8 * FF, q);
+    void* q8 = sycl::malloc_device(k::native_q8_1_bytes(FF, 8) + 256, q);
+    float *g = sycl::malloc_device<float>(64, q), *out = sycl::malloc_device<float>((size_t) 8 * N, q), *out2 = sycl::malloc_device<float>((size_t) 8 * N, q);
+    uint16_t* gi = sycl::malloc_device<uint16_t>((size_t) NL * N, q);
+    {
+        std::vector<uint16_t> h((size_t) NL * N);
+        for (auto& v : h) { const float f = (float) ((double) (xr() >> 11) / 9007199254740992.0 - 0.5) * 0.05f; uint32_t b; std::memcpy(&b, &f, 4); v = (uint16_t) (b >> 16); }
+        q.memcpy(gi, h.data(), h.size() * 2).wait();
+    }
+    for (const Combo& c : combos) {
+        const size_t gb = k::native_mmvq_weight_bytes(c.g, N, FF), ub = k::native_mmvq_weight_bytes(c.u, N, FF), db = k::native_mmvq_weight_bytes(c.d, FF, N);
+        const size_t gs = (gb + 255) & ~(size_t) 255, us_ = (ub + 255) & ~(size_t) 255, ds = (db + 255) & ~(size_t) 255;
+        uint8_t *wg = (uint8_t*) sycl::malloc_device(gs * NL, q), *wu = (uint8_t*) sycl::malloc_device(us_ * NL, q), *wd = (uint8_t*) sycl::malloc_device(ds * NL, q);
+        std::vector<uint8_t> h(std::max(gs, std::max(us_, ds)) * NL);
+        fill(c.g, h.data(), gs * NL); q.memcpy(wg, h.data(), gs * NL).wait();
+        fill(c.u, h.data(), us_ * NL); q.memcpy(wu, h.data(), us_ * NL).wait();
+        fill(c.d, h.data(), ds * NL); q.memcpy(wd, h.data(), ds * NL).wait();
+        for (const int nc : ncl) {
+            k::native_quantize_q8_1(x, xq, N, nc, &q);
+            q.wait();
+            auto call = [&](int l, float* o) {
+                k::NativeSharedWeights nw{};
+                nw.gate_type = c.g; nw.gate_data = wg + (size_t) l * gs; nw.up_type = c.u; nw.up_data = wu + (size_t) l * us_;
+                nw.down_type = c.d; nw.down_data = wd + (size_t) l * ds; nw.q8_1 = q8;
+                k::shared_expert_multi(nc, x, nullptr, nw, gi + (size_t) l * N, gate, up, g, o, N, FF, &q, xq, 0);
+            };
+            double t[2]; std::vector<float> r[2];
+            for (int nt = 0; nt < 2; ++nt) {
+                k::night_shexp_set(nt);
+                r[nt].resize((size_t) nc * N);
+                float* o = nt ? out2 : out;
+                q.memset(o, 0, (size_t) nc * N * 4).wait();
+                call(0, o); q.wait();
+                q.memcpy(r[nt].data(), o, (size_t) nc * N * 4).wait();
+                t[nt] = time_graph(q, NL, [&](int l) { call(l, o); }, 9);
+            }
+            k::night_shexp_set(-1);
+            if (std::getenv("SHEXP_PROFILE")) {   // per-launch breakdown, NL layers per graph
+                auto T = [&](const char* nm, const std::function<void(int)>& f) { std::printf("    %-22s %7.2f us\n", nm, time_graph(q, NL, f, 9)); };
+                T("orig gate mmvq", [&](int l) { k::native_mmvq(c.g, wg + (size_t) l * gs, xq, gate, N, FF, nc, &q); });
+                T("orig up mmvq", [&](int l) { k::native_mmvq(c.u, wu + (size_t) l * us_, xq, up, N, FF, nc, &q); });
+                T("orig swiglu+q8", [&](int) { k::native_swiglu_quantize_q8_1(gate, up, q8, FF, nc, &q); });
+                T("orig down mmvq", [&](int l) { k::native_mmvq(c.d, wd + (size_t) l * ds, q8, out, FF, N, nc, &q); });
+                T("bf16 gate row", [&](int l) { if (nc > 1) k::bf16_gemv_fp32_mmvf_multi(x, N, gi + (size_t) l * N, g, 1, N, 1, nc, &q);
+                                                 else k::bf16_gemv_fp32_mmvf(x, gi + (size_t) l * N, g, N, 1, &q); });
+                T("night gate+up+sw+q8", [&](int l) { k::night_shexp_gu_swiglu_q8(c.g, wg + (size_t) l * gs, c.u, wu + (size_t) l * us_, xq, gate, q8, N, FF, nc, &q,
+                                                                                 x, gi + (size_t) l * N, g); });
+                T("night down+scale", [&](int l) { k::night_shexp_down_scale(c.d, wd + (size_t) l * ds, q8, g, out, FF, N, nc, &q); });
+            }
+            double mabs = 0, rmax = 0; size_t neq = 0, bad = 0;
+            for (size_t i = 0; i < r[0].size(); ++i) {
+                rmax = std::max(rmax, (double) std::fabs(r[0][i]));
+                const double e = std::fabs((double) r[1][i] - r[0][i]);
+                if (!(e <= 1e30)) ++bad;
+                mabs = std::max(mabs, e);
+                if (std::memcmp(&r[0][i], &r[1][i], 4) != 0) ++neq;
+            }
+            std::printf("gate %2d up %2d down %2d (x%d layers) nc %d  orig %7.2f us  night %7.2f us  x%.2f  maxabs %.2e of %.2e  "
+                        "bits differ %zu/%zu%s\n", c.g, c.u, c.d, c.layers, nc, t[0], t[1], t[0] / t[1], mabs, rmax, neq, r[0].size(),
+                        bad ? " NONFINITE" : "");
+            std::fflush(stdout);
+        }
+        sycl::free(wg, q); sycl::free(wu, q); sycl::free(wd, q);
+    }
+    return 0;
+}
diff --git a/sycl/src/kernels/qsa_pattn_bench.cpp b/sycl/src/kernels/qsa_pattn_bench.cpp
new file mode 100644
index 00000000..4c7e86b2
--- /dev/null
+++ b/sycl/src/kernels/qsa_pattn_bench.cpp
@@ -0,0 +1,232 @@
+// src/kernels/qsa_pattn_bench.cpp - night-lab STRATA_NIGHT_PATTN_XMX: the prompt path's QSA attention for one prefill
+// chunk of one layer, current kernels (the prefill fallback loop: the S93 value pipeline for full-width 32-query
+// batches, else qsa_decode_attn_batch) against the union-tile XMX kernel (qsa_prompt_attn_union), plus the selection
+// union sizes per query tile.
+//
+// Realistic shapes: 24 q heads, 2 KV heads, head_dim 256, INT8 K/V (fp16 64-value scales), page size 4, identity page
+// table (resident pools); indexer 4 x 128, pooled keys random, indexer queries an AR(1) sequence over positions
+// (--rho: neighbouring positions' selections overlap as in a real prompt; calibrate against INTEL.md's 80K numbers),
+// selections by the real block-scores + top-k kernels at the serving capacity (max_blocks 50002), 256 queries per call
+// as the prefill does.  Or --sel FILE: a STRATA_DUMP_SEL dump (int32 T, cap, T*cap ids, T widths) replaces them.
+//
+//   qsa_pattn_bench --p0 12288 --T 12288 [--rho 0.97] [--reps 3] [--sel dump.bin]
+#define DPCT_PROFILING_ENABLED
+#include <sycl/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include "strata/kernels/qsa.hpp"
+#include "strata/kernels/qsa_decode_attn.hpp"
+#include "strata/kernels/qsa_prefill_attn.hpp"
+#include "strata/kernels/qsa_prompt_attn_union.hpp"
+#include "strata/kernels/qsa_prompt_attn_xmx.hpp"
+#include "strata/kernels/qsa_select.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace k = strata::kernels;
+
+namespace {
+inline uint32_t hsh(uint32_t x) {
+    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+    return x;
+}
+double now_ms() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+template <typename T>
+T* dalloc(sycl::queue& q, size_t n) {
+    T* p = sycl::malloc_device<T>(n + 64, q);
+    if (!p) { std::fprintf(stderr, "malloc_device failed (%zu)\n", n); std::exit(2); }
+    q.memset(p, 0, (n + 64) * sizeof(T)).wait();
+    return p;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    int64_t p0 = 12288, T = 12288;
+    double rho = 0.97;
+    int reps = 3;
+    std::string sel_path;
+    bool no_old = false;
+    for (int i = 1; i < argc; ++i) {
+        if (!std::strcmp(argv[i], "--p0") && i + 1 < argc) p0 = std::atoll(argv[++i]);
+        else if (!std::strcmp(argv[i], "--T") && i + 1 < argc) T = std::atoll(argv[++i]);
+        else if (!std::strcmp(argv[i], "--rho") && i + 1 < argc) rho = std::atof(argv[++i]);
+        else if (!std::strcmp(argv[i], "--reps") && i + 1 < argc) reps = std::atoi(argv[++i]);
+        else if (!std::strcmp(argv[i], "--sel") && i + 1 < argc) sel_path = argv[++i];
+        else if (!std::strcmp(argv[i], "--no-old")) no_old = true;
+    }
+    sycl::queue q{sycl::gpu_selector_v, {sycl::property::queue::in_order()}};
+    const k::QsaShapes s = k::qsa_real_shapes();
+    const int64_t HD = s.head_dim, NH = s.n_head, NKV = s.n_head_kv, ZV = NH * HD, ID = s.idx_dim, IQ = s.idx_n_head;
+    const int64_t cap = k::qsa_selection_width(k::kTopkMaxCells, s);
+    const int64_t max_blocks = 200000 / s.idx_block + 2;
+    const int64_t cells = ((p0 + T + 63) / 64) * 64, pages = cells / s.page_size;
+    std::printf("device %s | chunk p0=%lld T=%lld (context %lld..%lld) cap %lld rho %.3f\n",
+                q.get_device().get_info<sycl::info::device::name>().c_str(), (long long) p0, (long long) T,
+                (long long) p0 + 1, (long long) (p0 + T), (long long) cap, rho);
+
+    // ---- KV pools (INT8, identity pages), random codes and scales
+    const size_t rows = (size_t) pages * NKV * s.page_size;
+    int8_t* k_q = dalloc<int8_t>(q, rows * HD);
+    int8_t* v_q = dalloc<int8_t>(q, rows * HD);
+    uint16_t* k_s = dalloc<uint16_t>(q, rows * (HD / 64));
+    uint16_t* v_s = dalloc<uint16_t>(q, rows * (HD / 64));
+    int32_t* pt = dalloc<int32_t>(q, (size_t) pages);
+    q.parallel_for(sycl::range<1>(rows * HD), [=](sycl::id<1> i) {
+        k_q[i] = (int8_t) ((int) (hsh((uint32_t) i[0] * 2u + 1u) % 255u) - 127);
+        v_q[i] = (int8_t) ((int) (hsh((uint32_t) i[0] * 2u + 2u) % 255u) - 127);
+    });
+    q.parallel_for(sycl::range<1>(rows * (HD / 64)), [=](sycl::id<1> i) {
+        k_s[i] = sycl::bit_cast<uint16_t>(sycl::half(0.002f + (float) (hsh((uint32_t) i[0] ^ 0xabcdu) % 1000u) * 2e-5f));
+        v_s[i] = sycl::bit_cast<uint16_t>(sycl::half(0.002f + (float) (hsh((uint32_t) i[0] ^ 0x1234u) % 1000u) * 2e-5f));
+    });
+    q.parallel_for(sycl::range<1>((size_t) pages), [=](sycl::id<1> i) { pt[i] = (int32_t) i[0]; });
+    k::QsaAttnPools pools;
+    pools.k_q = k_q; pools.v_q = v_q; pools.k_scale = k_s; pools.v_scale = v_s; pools.page_table = pt;
+
+    // ---- steps and selections
+    std::vector<int32_t> h_steps((size_t) T * k::kStepCount);
+    for (int64_t t = 0; t < T; ++t) k::qsa_step_fill(h_steps.data() + t * k::kStepCount, p0 + t, s);
+    int32_t* steps = dalloc<int32_t>(q, h_steps.size());
+    q.memcpy(steps, h_steps.data(), h_steps.size() * 4).wait();
+    int32_t* sel = dalloc<int32_t>(q, (size_t) T * cap);
+    std::vector<int32_t> h_sel((size_t) T * cap);
+    if (!sel_path.empty()) {
+        FILE* f = std::fopen(sel_path.c_str(), "rb");
+        int32_t hdr[2] = {0, 0};
+        if (!f || std::fread(hdr, 4, 2, f) != 2 || hdr[0] != T || hdr[1] != cap) { std::fprintf(stderr, "bad --sel file (want T=%lld cap=%lld)\n", (long long) T, (long long) cap); return 2; }
+        if (std::fread(h_sel.data(), 4, h_sel.size(), f) != h_sel.size()) { std::fprintf(stderr, "short --sel file\n"); return 2; }
+        std::fclose(f);
+        q.memcpy(sel, h_sel.data(), h_sel.size() * 4).wait();
+    } else {
+        const int64_t nblk = cells / s.idx_block + 2;
+        std::mt19937 rng(7);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        std::vector<float> h_pooled((size_t) nblk * ID), h_dead((size_t) ID), h_qi((size_t) T * IQ * ID);
+        for (auto& v : h_pooled) v = nd(rng);
+        for (auto& v : h_dead) v = nd(rng);
+        std::vector<float> cur((size_t) IQ * ID);
+        for (auto& v : cur) v = nd(rng);
+        const float a = (float) rho, b = (float) std::sqrt(std::max(0.0, 1.0 - rho * rho));
+        for (int64_t t = 0; t < T; ++t) {
+            for (auto& v : cur) v = a * v + b * nd(rng);
+            std::copy(cur.begin(), cur.end(), h_qi.begin() + t * IQ * ID);
+        }
+        float* pooled = dalloc<float>(q, h_pooled.size());
+        float* dead = dalloc<float>(q, h_dead.size());
+        float* qidx = dalloc<float>(q, h_qi.size());
+        float* scores = dalloc<float>(q, (size_t) 256 * max_blocks);
+        q.memcpy(pooled, h_pooled.data(), h_pooled.size() * 4);
+        q.memcpy(dead, h_dead.data(), h_dead.size() * 4);
+        q.memcpy(qidx, h_qi.data(), h_qi.size() * 4).wait();
+        for (int64_t t0 = 0; t0 < T; t0 += 256) {
+            const int64_t nb = std::min<int64_t>(256, T - t0);
+            const int64_t active = (int64_t) h_steps[(size_t) ((t0 + nb - 1) * k::kStepCount + k::kStepNBid)] + 1;
+            k::qsa_block_scores(pooled, dead, qidx + t0 * IQ * ID, steps + t0 * k::kStepCount, nb, max_blocks, s, scores, &q, active);
+            k::qsa_block_topk(scores, steps + t0 * k::kStepCount, nb, max_blocks, cap, s, sel + t0 * cap, &q, active);
+        }
+        q.wait();
+        q.memcpy(h_sel.data(), sel, h_sel.size() * 4).wait();
+        sycl::free(pooled, q); sycl::free(dead, q); sycl::free(qidx, q); sycl::free(scores, q);
+    }
+    // union statistics per query tile
+    for (int tq : {4, 8, 16}) {
+        double su = 0, sw = 0;
+        std::vector<int32_t> u;
+        for (int64_t t0 = 0; t0 + tq <= T; t0 += tq) {
+            u.clear();
+            for (int64_t t = t0; t < t0 + tq; ++t) {
+                const int64_t w = h_steps[(size_t) (t * k::kStepCount + k::kStepWidth)];
+                sw += (double) w;
+                u.insert(u.end(), h_sel.begin() + t * cap, h_sel.begin() + t * cap + w);
+            }
+            std::sort(u.begin(), u.end());
+            su += (double) (std::unique(u.begin(), u.end()) - u.begin());
+        }
+        std::printf("union of %2d-query tiles: %.2fx one query's cells (%.1f%% of the per-query reads)\n", tq,
+                    su / (sw / tq), 100.0 * su / sw);
+    }
+
+    // ---- q (T x 24 x 256), random ~N(0,1)-ish
+    float* qv = dalloc<float>(q, (size_t) T * ZV);
+    q.parallel_for(sycl::range<1>((size_t) T * ZV), [=](sycl::id<1> i) {
+        const uint32_t h1 = hsh((uint32_t) i[0] * 3u + 7u), h2 = hsh((uint32_t) i[0] * 5u + 11u);
+        qv[i] = ((float) (h1 & 0xffffu) / 65536.0f + (float) (h2 & 0xffffu) / 65536.0f - 1.0f) * 2.4f;
+    }).wait();
+    float* out_a = dalloc<float>(q, (size_t) T * ZV);
+    float* out_b = dalloc<float>(q, (size_t) T * ZV);
+    const int64_t attn_batch = 32;
+    float* scratch = dalloc<float>(q, (size_t) attn_batch * k::qsa_decode_attn_scratch_floats(cap, s));
+
+    auto run_old = [&] {
+        for (int64_t t0 = 0; t0 < T; t0 += attn_batch) {
+            const int64_t nb = std::min(attn_batch, T - t0);
+            const bool value_domain = nb == 32 && cap == 2051 &&
+                                      h_steps[(size_t) (t0 * k::kStepCount + k::kStepWidth)] == cap;
+            if (value_domain)
+                k::qsa_prefill_attn_value_batch(qv + t0 * ZV, pools, sel + t0 * cap, steps + t0 * k::kStepCount, cap, s,
+                                                scratch, out_a + t0 * ZV, nb, &q);
+            else
+                k::qsa_decode_attn_batch(qv + t0 * ZV, pools, sel + t0 * cap, steps + t0 * k::kStepCount, cap, s, scratch,
+                                         out_a + t0 * ZV, nb, &q);
+        }
+    };
+    auto run_new = [&] {
+        if (!k::qsa_prompt_attn_union(qv, pools, sel, steps, cap, s, out_b, T, &q)) { std::fprintf(stderr, "union kernel refused\n"); std::exit(3); }
+    };
+    auto timeit = [&](auto&& f) {
+        f(); q.wait();
+        double best = 1e30;
+        for (int r = 0; r < reps; ++r) { const double t0 = now_ms(); f(); q.wait(); best = std::min(best, now_ms() - t0); }
+        return best;
+    };
+    double t_old = 0;
+    if (!no_old) t_old = timeit(run_old);
+    const double t_new = timeit(run_new);
+    double t_x = -1;
+    if (std::getenv("STRATA_PROMPT_ATTN_XMX")) {
+        float* out_c = out_b;   // overwritten after the comparison below
+        (void) out_c;
+    }
+    std::printf("RESULT p0=%lld T=%lld old_ms=%.2f union_xmx_ms=%.2f speedup=%.2fx (us/query old %.2f new %.2f)\n",
+                (long long) p0, (long long) T, t_old, t_new, t_old > 0 ? t_old / t_new : 0.0, 1e3 * t_old / T,
+                1e3 * t_new / T);
+    if (!no_old) {
+        std::vector<float> a((size_t) T * ZV), b((size_t) T * ZV);
+        q.memcpy(a.data(), out_a, a.size() * 4);
+        q.memcpy(b.data(), out_b, b.size() * 4).wait();
+        double mabs = 0, mref = 0, sabs = 0, mrel_row = 0;
+        size_t nan = 0, worst = 0;
+        for (int64_t r = 0; r < T * NH; ++r) {
+            double rmax = 0, rdiff = 0;
+            for (int64_t d = 0; d < HD; ++d) {
+                const size_t i = (size_t) r * HD + d;
+                if (!std::isfinite(b[i])) { ++nan; continue; }
+                const double df = std::fabs((double) a[i] - (double) b[i]);
+                rmax = std::max(rmax, std::fabs((double) a[i]));
+                rdiff = std::max(rdiff, df);
+                sabs += df;
+                if (df > mabs) { mabs = df; worst = i; }
+            }
+            mref = std::max(mref, rmax);
+            if (rmax > 0) mrel_row = std::max(mrel_row, rdiff / rmax);
+        }
+        std::printf("ACCURACY union vs current: max abs %.3e (at %zu: %.6f vs %.6f), mean abs %.3e, max |ref| %.3e, "
+                    "max per-row rel (max diff / max |ref| of the row) %.3e, non-finite %zu\n",
+                    mabs, worst, a[worst], b[worst], sabs / (double) a.size(), mref, mrel_row, nan);
+    }
+    if (std::getenv("STRATA_PROMPT_ATTN_XMX")) {
+        auto run_x = [&] { k::qsa_prompt_attn_xmx(qv, pools, sel, steps, cap, s, out_b, T, &q); };
+        t_x = timeit(run_x);
+        std::printf("RESULT p0=%lld T=%lld xmx_v2_ms=%.2f\n", (long long) p0, (long long) T, t_x);
+    }
+    return 0;
+}
diff --git a/sycl/src/kernels/qsa_verify_batch_parity.cpp b/sycl/src/kernels/qsa_verify_batch_parity.cpp
new file mode 100644
index 00000000..a6df27c7
--- /dev/null
+++ b/sycl/src/kernels/qsa_verify_batch_parity.cpp
@@ -0,0 +1,540 @@
+// src/kernels/qsa_verify_batch_parity.cpp - night-lab (STRATA_NIGHT_ATTN_BATCH): a verify window's QSA select +
+// attention + K/V / indexer appends, row by row (the batch-window path of verify.cpp) against the per-slot calls and
+// the one-launch-per-window form, bitwise, and their graph-replay time per layer.
+//
+// Realistic shapes: 24 q heads, 2 KV heads, head_dim 256, INT8 K/V (64-value fp16 scales), page size 4 through a
+// random page permutation, indexer 4 x 128 with random pooled keys (random top-k selections), the serving capacity
+// (200000 cells: max_blocks 50002, the wide top-k kernel). 12 attention layers with their own pools (no L2 reuse
+// across layers). Shapes: C2 = 2 slots x 3 rows, C1 = 1 slot x 4 rows, C2d1 = 2 slots x 2 rows; contexts from argv.
+// Also the MTP drafter call (1 row, 32K window = 512 chunks).
+//
+//   qsa_verify_batch_parity [--ctx 1024,16384,65536] [--ref FILE] [--reps N]
+// --ref: the first run (no night env) writes one FNV-1a hash per output; later runs (STRATA_NIGHT_ATTN_VPIPE=1,
+// STRATA_NIGHT_ATTN_MERGE_ACTIVE=1) compare against it.  In-process, the batched paths are compared byte for byte
+// against the row-by-row path.
+#define DPCT_PROFILING_ENABLED
+#include <sycl/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include "strata/kernels/kv_q8.hpp"
+#include "strata/kernels/native_qsa_indexer.hpp"
+#include "strata/kernels/qsa.hpp"
+#include "strata/kernels/qsa_decode_attn.hpp"
+#include "strata/kernels/qsa_select.hpp"
+#include "strata/kernels/rope_scaling.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <numeric>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace k = strata::kernels;
+namespace sx = sycl::ext::oneapi::experimental;
+
+namespace {
+int g_fail = 0;
+constexpr int L = 12;            // attention layers
+constexpr int64_t kMaxCells = 200000;
+
+inline uint32_t hsh(uint32_t x) {
+    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+    return x;
+}
+void fill_i8(sycl::queue& q, int8_t* p, size_t n, uint32_t seed) {
+    const uint32_t s0 = hsh(seed * 0x9e3779b9u + 1);
+    q.parallel_for(sycl::range<1>(n), [=](sycl::id<1> i) {
+        const uint32_t h = hsh((uint32_t) i[0] ^ s0) ^ hsh((uint32_t) (i[0] >> 32) + s0);
+        p[i] = (int8_t) ((int) (h % 255u) - 127);
+    });
+}
+void fill_scale(sycl::queue& q, uint16_t* p, size_t n, uint32_t seed) {
+    const uint32_t s0 = hsh(seed * 0x9e3779b9u + 7);
+    q.parallel_for(sycl::range<1>(n), [=](sycl::id<1> i) {
+        const uint32_t h = hsh((uint32_t) i[0] ^ s0);
+        const float v = 0.002f + (float) (h % 1000u) * 2e-5f;
+        p[i] = sycl::bit_cast<uint16_t>(sycl::half(v));
+    });
+}
+void fill_f32(sycl::queue& q, float* p, size_t n, uint32_t seed, float amp) {
+    const uint32_t s0 = hsh(seed * 0x9e3779b9u + 13);
+    q.parallel_for(sycl::range<1>(n), [=](sycl::id<1> i) {
+        const uint32_t h = hsh((uint32_t) i[0] ^ s0);
+        p[i] = ((float) (h & 0xffffffu) / 16777216.0f * 2.0f - 1.0f) * amp;
+    });
+}
+template <typename T>
+T* dalloc(sycl::queue& q, size_t n) {
+    T* p = sycl::malloc_device<T>(n + 64, q);
+    if (!p) { std::fprintf(stderr, "malloc_device failed (%zu)\n", n); std::exit(2); }
+    q.memset(p, 0, (n + 64) * sizeof(T)).wait();
+    return p;
+}
+template <typename T>
+std::vector<T> fetch(sycl::queue& q, const T* d, size_t n) {
+    std::vector<T> h(n);
+    q.memcpy(h.data(), d, n * sizeof(T)).wait();
+    return h;
+}
+uint64_t fnv(const void* p, size_t n, uint64_t h = 1469598103934665603ull) {
+    const uint8_t* b = (const uint8_t*) p;
+    for (size_t i = 0; i < n; ++i) { h ^= b[i]; h *= 1099511628211ull; }
+    return h;
+}
+double now_us() {
+    return std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+struct SlotLayer {   // one slot's QSA state of ONE layer
+    int8_t *k_q = nullptr, *v_q = nullptr;
+    uint16_t *k_s = nullptr, *v_s = nullptr;
+    int32_t* pt = nullptr;
+    float *pooled = nullptr, *dead = nullptr, *tail = nullptr;
+    int32_t* bpos = nullptr;
+    int64_t cells = 0, pages = 0;
+    k::QsaAttnPools pools() const {
+        k::QsaAttnPools p;
+        p.k_q = k_q; p.v_q = v_q; p.k_scale = k_s; p.v_scale = v_s; p.page_table = pt;
+        return p;
+    }
+    k::QsaIndexerBuffers ib() const { return k::QsaIndexerBuffers{tail, dead, pooled, bpos}; }
+};
+
+struct Shape {
+    const char* name;
+    int slots, per;   // rows = slots * per, contiguous per slot
+};
+
+struct Ctx {
+    sycl::queue& q;
+    k::QsaShapes s;
+    int64_t ctx;
+    int64_t cap, max_blocks;
+    int rows_max = 8;
+    std::vector<SlotLayer> sl;   // [L][2]
+    // window buffers (shared by the layers, as the verifier's are)
+    float *qcur, *qidx, *scores, *scratch, *attn, *idx_raw, *kcur, *vcur, *gamma;
+    int32_t *sel, *steps;
+    int64_t scratch_floats;
+    SlotLayer& at(int l, int slot) { return sl[(size_t) l * 2 + slot]; }
+};
+
+void make_ctx(Ctx& c) {
+    sycl::queue& q = c.q;
+    const k::QsaShapes& s = c.s;
+    const int64_t HD = s.head_dim, NKV = s.n_head_kv, G = HD / k::KV_Q8_GROUP;
+    c.cap = k::qsa_selection_width(k::kTopkMaxCells, s);
+    c.max_blocks = kMaxCells / s.idx_block + 2;
+    c.scratch_floats = (int64_t) k::qsa_decode_attn_scratch_floats(c.cap, s);
+    c.sl.resize((size_t) L * 2);
+    std::mt19937 rng(1234u + (uint32_t) c.ctx);
+    for (int l = 0; l < L; ++l)
+        for (int j = 0; j < 2; ++j) {
+            SlotLayer& x = c.at(l, j);
+            x.cells = ((c.ctx + 64 + 3) / 4) * 4;
+            x.pages = x.cells / s.page_size;
+            const size_t rows = (size_t) x.pages * NKV * s.page_size;
+            x.k_q = dalloc<int8_t>(q, rows * HD);
+            x.v_q = dalloc<int8_t>(q, rows * HD);
+            x.k_s = dalloc<uint16_t>(q, rows * G);
+            x.v_s = dalloc<uint16_t>(q, rows * G);
+            const uint32_t seed = (uint32_t) (l * 2 + j + 1) * 101u + (uint32_t) c.ctx;
+            fill_i8(q, x.k_q, rows * HD, seed);
+            fill_i8(q, x.v_q, rows * HD, seed + 1);
+            fill_scale(q, x.k_s, rows * G, seed + 2);
+            fill_scale(q, x.v_s, rows * G, seed + 3);
+            std::vector<int32_t> perm((size_t) x.pages);
+            std::iota(perm.begin(), perm.end(), 0);
+            std::shuffle(perm.begin(), perm.end(), rng);
+            x.pt = dalloc<int32_t>(q, (size_t) x.pages);
+            q.memcpy(x.pt, perm.data(), perm.size() * 4).wait();
+            const size_t prow = (size_t) (x.cells / s.idx_block + 2);
+            x.pooled = dalloc<float>(q, prow * s.idx_dim);
+            x.dead = dalloc<float>(q, (size_t) s.idx_dim);
+            x.tail = dalloc<float>(q, (size_t) (s.idx_block - 1) * s.idx_dim);
+            x.bpos = dalloc<int32_t>(q, 1);
+            fill_f32(q, x.pooled, prow * s.idx_dim, seed + 4, 1.0f);
+            fill_f32(q, x.dead, (size_t) s.idx_dim, seed + 5, 1.0f);
+            fill_f32(q, x.tail, (size_t) (s.idx_block - 1) * s.idx_dim, seed + 6, 1.0f);
+        }
+    const int R = c.rows_max;
+    c.qcur = dalloc<float>(q, (size_t) R * s.n_head * HD);
+    c.qidx = dalloc<float>(q, (size_t) R * s.idx_n_head * s.idx_dim);
+    c.scores = dalloc<float>(q, (size_t) R * c.max_blocks);
+    c.scratch = dalloc<float>(q, (size_t) R * c.scratch_floats);
+    c.attn = dalloc<float>(q, (size_t) L * R * s.n_head * HD);
+    c.sel = dalloc<int32_t>(q, (size_t) L * R * c.cap);
+    c.steps = dalloc<int32_t>(q, (size_t) R * k::kStepCount);
+    c.idx_raw = dalloc<float>(q, (size_t) R * s.idx_dim);
+    c.kcur = dalloc<float>(q, (size_t) R * NKV * HD);
+    c.vcur = dalloc<float>(q, (size_t) R * NKV * HD);
+    c.gamma = dalloc<float>(q, (size_t) s.idx_dim);
+    fill_f32(q, c.qcur, (size_t) R * s.n_head * HD, 77, 1.0f);
+    fill_f32(q, c.qidx, (size_t) R * s.idx_n_head * s.idx_dim, 78, 1.0f);
+    fill_f32(q, c.idx_raw, (size_t) R * s.idx_dim, 79, 1.0f);
+    fill_f32(q, c.kcur, (size_t) R * NKV * HD, 80, 2.0f);
+    fill_f32(q, c.vcur, (size_t) R * NKV * HD, 81, 2.0f);
+    std::vector<float> gam((size_t) s.idx_dim);
+    for (size_t i = 0; i < gam.size(); ++i) gam[i] = 0.75f + 0.5f * (float) ((i * 37) % 64) / 64.0f;
+    q.memcpy(c.gamma, gam.data(), gam.size() * 4).wait();
+}
+void free_ctx(Ctx& c) {
+    sycl::queue& q = c.q;
+    for (auto& x : c.sl) {
+        sycl::free(x.k_q, q); sycl::free(x.v_q, q); sycl::free(x.k_s, q); sycl::free(x.v_s, q); sycl::free(x.pt, q);
+        sycl::free(x.pooled, q); sycl::free(x.dead, q); sycl::free(x.tail, q); sycl::free(x.bpos, q);
+    }
+    for (void* p : {(void*) c.qcur, (void*) c.qidx, (void*) c.scores, (void*) c.scratch, (void*) c.attn, (void*) c.sel,
+                    (void*) c.steps, (void*) c.idx_raw, (void*) c.kcur, (void*) c.vcur, (void*) c.gamma})
+        sycl::free(p, q);
+    c.sl.clear();
+}
+
+// positions of a shape's rows: slot j's window starts at ctx - 8 j (slot B a little shorter)
+void set_steps(Ctx& c, const Shape& sh) {
+    std::vector<int32_t> h((size_t) sh.slots * sh.per * k::kStepCount);
+    for (int j = 0; j < sh.slots; ++j)
+        for (int r = 0; r < sh.per; ++r) {
+            const int64_t pos = c.ctx - 8 * j + r;
+            k::qsa_step_fill(h.data() + (size_t) (j * sh.per + r) * k::kStepCount, pos, c.s);
+        }
+    c.q.memcpy(c.steps, h.data(), h.size() * 4).wait();
+}
+
+enum Path { kRow = 0, kSlot = 1, kOne = 2 };
+const char* path_name[3] = {"row", "slot", "one"};
+
+// one layer's select + attention for the window, as verify.cpp's batch branch issues it
+void attn_layer(Ctx& c, const Shape& sh, int l, Path p, int mask = 7) {   // mask: 1 scores, 2 top-k, 4 attention
+    const k::QsaShapes& s = c.s;
+    void* st = &c.q;
+    const int64_t NH = s.n_head, HD = s.head_dim, IQ = s.idx_n_head, ID = s.idx_dim;
+    const int n = sh.slots * sh.per;
+    float* attn_l = c.attn + (size_t) l * c.rows_max * NH * HD;
+    int32_t* sel_l = c.sel + (size_t) l * c.rows_max * c.cap;
+    if (p == kRow) {
+        for (int t = 0; t < n; ++t) {
+            const SlotLayer& x = c.at(l, t / sh.per);
+            if (mask & 1)
+            k::qsa_block_scores(x.pooled, x.dead, c.qidx + t * IQ * ID, c.steps + t * k::kStepCount, 1, c.max_blocks, s,
+                                c.scores + (size_t) t * c.max_blocks, st);
+            if (mask & 2)
+            k::qsa_block_topk(c.scores + (size_t) t * c.max_blocks, c.steps + t * k::kStepCount, 1, c.max_blocks, c.cap,
+                              s, sel_l + (size_t) t * c.cap, st);
+            if (mask & 4)
+            k::qsa_decode_attn_batch(c.qcur + t * NH * HD, x.pools(), sel_l + (size_t) t * c.cap,
+                                     c.steps + t * k::kStepCount, c.cap, s, c.scratch + (size_t) t * c.scratch_floats,
+                                     attn_l + t * NH * HD, 1, st);
+        }
+        return;
+    }
+    for (int j = 0; j < sh.slots; ++j) {
+        const int f = j * sh.per;
+        const SlotLayer& x = c.at(l, j);
+        if (mask & 1)
+        k::qsa_block_scores(x.pooled, x.dead, c.qidx + f * IQ * ID, c.steps + f * k::kStepCount, sh.per, c.max_blocks,
+                            s, c.scores + (size_t) f * c.max_blocks, st);
+        if (p == kSlot && (mask & 2))
+            k::qsa_block_topk(c.scores + (size_t) f * c.max_blocks, c.steps + f * k::kStepCount, sh.per, c.max_blocks,
+                              c.cap, s, sel_l + (size_t) f * c.cap, st);
+    }
+    if (p == kOne) {
+        if (mask & 2) k::qsa_block_topk(c.scores, c.steps, n, c.max_blocks, c.cap, s, sel_l, st);
+        if (!(mask & 4)) return;
+        k::QsaAttnPools pp[k::kQsaAttnMaxPools];
+        int rows[k::kQsaAttnMaxPools];
+        for (int j = 0; j < sh.slots; ++j) { pp[j] = c.at(l, j).pools(); rows[j] = sh.per; }
+        k::qsa_decode_attn_multi(c.qcur, pp, rows, sh.slots, sel_l, c.steps, c.cap, s, c.scratch, attn_l, st);
+        return;
+    }
+    if (!(mask & 4)) return;
+    for (int j = 0; j < sh.slots; ++j) {
+        const int f = j * sh.per;
+        k::qsa_decode_attn_batch(c.qcur + f * NH * HD, c.at(l, j).pools(), sel_l + (size_t) f * c.cap,
+                                 c.steps + f * k::kStepCount, c.cap, s, c.scratch + (size_t) f * c.scratch_floats,
+                                 attn_l + f * NH * HD, sh.per, st);
+    }
+}
+
+// one layer's K/V append and indexer append: row by row, or per slot
+void prep_layer(Ctx& c, const Shape& sh, int l, bool per_slot) {
+    const k::QsaShapes& s = c.s;
+    void* st = &c.q;
+    const int64_t NKV = s.n_head_kv, HD = s.head_dim, ID = s.idx_dim;
+    const float eps = 1e-6f;
+    if (!per_slot) {
+        for (int t = 0; t < sh.slots * sh.per; ++t) {
+            const SlotLayer& x = c.at(l, t / sh.per);
+            k::kv_append_q8_step(x.k_q, x.v_q, x.k_s, x.v_s, x.pt, c.steps + t * k::kStepCount, c.kcur + t * NKV * HD,
+                                 c.vcur + t * NKV * HD, s, st, nullptr);
+        }
+        for (int t = 0; t < sh.slots * sh.per; ++t) {
+            const SlotLayer& x = c.at(l, t / sh.per);
+            k::native_qsa_indexer_append(c.idx_raw + t * ID, c.steps + t * k::kStepCount + k::kStepPos, 0, c.gamma, eps,
+                                         x.ib(), s, x.cells, k::rope_scaling(), st);
+        }
+        return;
+    }
+    for (int j = 0; j < sh.slots; ++j) {
+        const int f = j * sh.per;
+        const SlotLayer& x = c.at(l, j);
+        k::kv_append_q8_steps(x.k_q, x.v_q, x.k_s, x.v_s, x.pt, c.steps + f * k::kStepCount, k::kStepCount,
+                              c.kcur + f * NKV * HD, c.vcur + f * NKV * HD, (int) (NKV * HD), sh.per, s, st, nullptr);
+    }
+    for (int j = 0; j < sh.slots; ++j) {
+        const int f = j * sh.per;
+        const SlotLayer& x = c.at(l, j);
+        k::native_qsa_indexer_append_steps(c.idx_raw + f * ID, c.steps + f * k::kStepCount + k::kStepPos, k::kStepCount,
+                                           sh.per, 0, c.gamma, eps, x.ib(), s, x.cells, k::rope_scaling(), st);
+    }
+}
+
+template <class F>
+double time_graph(sycl::queue& q, int reps, F&& body) {
+    sx::command_graph g{q.get_context(), q.get_device()};
+    g.begin_recording(q);
+    body();
+    g.end_recording();
+    auto ex = g.finalize();
+    for (int i = 0; i < 3; ++i) q.ext_oneapi_graph(ex);
+    q.wait();
+    std::vector<double> v;
+    for (int b = 0; b < 7; ++b) {
+        const double t0 = now_us();
+        for (int r = 0; r < reps; ++r) q.ext_oneapi_graph(ex);
+        q.wait();
+        v.push_back((now_us() - t0) / reps);
+    }
+    std::sort(v.begin(), v.end());
+    return v[v.size() / 2];
+}
+
+std::map<std::string, uint64_t> g_ref, g_out;
+bool g_have_ref = false;
+void record(const std::string& key, uint64_t h) {
+    g_out[key] = h;
+    if (g_have_ref) {
+        auto it = g_ref.find(key);
+        if (it == g_ref.end()) std::printf("  ref %-34s missing\n", key.c_str());
+        else if (it->second != h) { std::printf("  ref %-34s DIFF (%016llx vs %016llx)\n", key.c_str(), (unsigned long long) h, (unsigned long long) it->second); ++g_fail; }
+    }
+}
+
+void compare_f32(const char* what, const std::vector<float>& a, const std::vector<float>& b) {
+    double mabs = 0, mrel = 0;
+    size_t nd = 0;
+    for (size_t i = 0; i < a.size(); ++i) {
+        if (std::memcmp(&a[i], &b[i], 4) != 0) {
+            ++nd;
+            const double d = std::fabs((double) a[i] - (double) b[i]);
+            mabs = std::max(mabs, d);
+            mrel = std::max(mrel, d / std::max(1e-30, std::fabs((double) a[i])));
+        }
+    }
+    if (nd) { std::printf("  %-40s %zu of %zu floats differ, max abs %.3g max rel %.3g\n", what, nd, a.size(), mabs, mrel); ++g_fail; }
+    else std::printf("  %-40s bitwise (%zu floats)\n", what, a.size());
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    std::vector<int64_t> ctxs = {1024, 16384, 65536};
+    std::string ref_path;
+    int reps = 20;
+    for (int i = 1; i < argc; ++i) {
+        if (!std::strcmp(argv[i], "--ctx") && i + 1 < argc) {
+            ctxs.clear();
+            std::string a = argv[++i];
+            size_t p = 0;
+            while (p < a.size()) { size_t e = a.find(',', p); if (e == std::string::npos) e = a.size(); ctxs.push_back(std::atoll(a.substr(p, e - p).c_str())); p = e + 1; }
+        } else if (!std::strcmp(argv[i], "--ref") && i + 1 < argc) ref_path = argv[++i];
+        else if (!std::strcmp(argv[i], "--reps") && i + 1 < argc) reps = std::atoi(argv[++i]);
+    }
+    if (!ref_path.empty()) {
+        if (FILE* f = std::fopen(ref_path.c_str(), "r")) {
+            char key[128]; unsigned long long h;
+            while (std::fscanf(f, "%127s %llx", key, &h) == 2) g_ref[key] = h;
+            std::fclose(f);
+            g_have_ref = !g_ref.empty();
+        }
+    }
+    sycl::queue q{sycl::gpu_selector_v, {sycl::property::queue::in_order()}};
+    std::printf("device: %s  ref: %s  env VPIPE=%d MERGE_ACTIVE=%d\n",
+                q.get_device().get_info<sycl::info::device::name>().c_str(),
+                g_have_ref ? "compare" : (ref_path.empty() ? "none" : "write"), k::qsa_night_vpipe() ? 1 : 0,
+                k::qsa_night_merge_active() ? 1 : 0);
+    const Shape shapes[] = {{"C2_2x3", 2, 3}, {"C1_1x4", 1, 4}, {"C2d1_2x2", 2, 2}};
+    for (int64_t ctx : ctxs) {
+        Ctx c{q, k::qsa_real_shapes(), ctx, 0, 0};
+        make_ctx(c);
+        q.wait();
+        std::printf("\n=== context %lld (cap %lld, max_blocks %lld, 12 layers) ===\n", (long long) ctx, (long long) c.cap,
+                    (long long) c.max_blocks);
+        for (const Shape& sh : shapes) {
+            const int n = sh.slots * sh.per;
+            set_steps(c, sh);
+            const size_t attn_n = (size_t) L * c.rows_max * c.s.n_head * c.s.head_dim, sel_n = (size_t) L * c.rows_max * c.cap;
+            std::vector<float> a_ref;
+            std::vector<int32_t> s_ref;
+            double t_us[3] = {0, 0, 0};
+            for (int p = 0; p < 3; ++p) {
+                if (p == kSlot && sh.slots == 1) {}   // C1: slot == one launch per kernel already (still run it)
+                q.memset(c.attn, 0, attn_n * 4).wait();
+                q.memset(c.sel, 0, sel_n * 4).wait();
+                for (int l = 0; l < L; ++l) attn_layer(c, sh, l, (Path) p);
+                q.wait();
+                auto a = fetch(q, c.attn, attn_n);
+                auto sv = fetch(q, c.sel, sel_n);
+                char key[96];
+                std::snprintf(key, sizeof key, "attn_%lld_%s", (long long) ctx, sh.name);
+                record(std::string(key) + "_" + path_name[p], fnv(a.data(), a.size() * 4, fnv(sv.data(), sv.size() * 4)));
+                if (p == kRow) { a_ref = a; s_ref = sv; }
+                else {
+                    char w[96];
+                    std::snprintf(w, sizeof w, "%s %s vs row: attn", sh.name, path_name[p]);
+                    compare_f32(w, a_ref, a);
+                    if (std::memcmp(s_ref.data(), sv.data(), sv.size() * 4) != 0) { std::printf("  %s %s vs row: selection DIFFERS\n", sh.name, path_name[p]); ++g_fail; }
+                }
+                t_us[p] = time_graph(q, reps, [&] { for (int l = 0; l < L; ++l) attn_layer(c, sh, l, (Path) p); }) / L;
+            }
+            {   // component split (graph replay, 12 layers): scores / top-k / chunk+merge per path
+                double comp[3][3];
+                for (int p = 0; p < 3; ++p)
+                    for (int m = 0; m < 3; ++m)
+                        comp[p][m] = time_graph(q, reps, [&] { for (int l = 0; l < L; ++l) attn_layer(c, sh, l, (Path) p, 1 << m); }) / L;
+                std::printf("  %-9s split us/layer (scores/topk/attn): row %.1f/%.1f/%.1f  slot %.1f/%.1f/%.1f  one %.1f/%.1f/%.1f\n",
+                            sh.name, comp[0][0], comp[0][1], comp[0][2], comp[1][0], comp[1][1], comp[1][2], comp[2][0],
+                            comp[2][1], comp[2][2]);
+            }
+            // the K/V + indexer appends: parity from one saved state, then time
+            std::vector<std::vector<float>> tail0, pooled0;
+            for (int j = 0; j < sh.slots; ++j) {
+                const SlotLayer& x = c.at(0, j);
+                tail0.push_back(fetch(q, x.tail, (size_t) (c.s.idx_block - 1) * c.s.idx_dim));
+                pooled0.push_back(fetch(q, x.pooled, (size_t) (x.cells / c.s.idx_block + 2) * c.s.idx_dim));
+            }
+            auto snap = [&](int j) {
+                const SlotLayer& x = c.at(0, j);
+                const size_t rows = (size_t) x.pages * c.s.n_head_kv * c.s.page_size;
+                std::vector<uint8_t> out;
+                auto push = [&](const void* d, size_t bytes) { std::vector<uint8_t> h(bytes); q.memcpy(h.data(), d, bytes).wait(); out.insert(out.end(), h.begin(), h.end()); };
+                push(x.k_q, rows * c.s.head_dim); push(x.v_q, rows * c.s.head_dim);
+                push(x.k_s, rows * 8); push(x.v_s, rows * 8);
+                push(x.tail, (size_t) (c.s.idx_block - 1) * c.s.idx_dim * 4);
+                push(x.pooled, (size_t) (x.cells / c.s.idx_block + 2) * c.s.idx_dim * 4);
+                push(x.dead, (size_t) c.s.idx_dim * 4); push(x.bpos, 4);
+                return out;
+            };
+            auto restore = [&]() {
+                for (int j = 0; j < sh.slots; ++j) {
+                    const SlotLayer& x = c.at(0, j);
+                    q.memcpy(x.tail, tail0[(size_t) j].data(), tail0[(size_t) j].size() * 4).wait();
+                    q.memcpy(x.pooled, pooled0[(size_t) j].data(), pooled0[(size_t) j].size() * 4).wait();
+                    q.memset(x.bpos, 0, 4).wait();
+                }
+            };
+            double tp[2] = {0, 0};
+            std::vector<std::vector<uint8_t>> st_row;
+            for (int ps = 0; ps < 2; ++ps) {
+                restore();
+                prep_layer(c, sh, 0, ps == 1);
+                q.wait();
+                for (int j = 0; j < sh.slots; ++j) {
+                    auto sn = snap(j);
+                    if (ps == 0) st_row.push_back(sn);
+                    else if (sn != st_row[(size_t) j]) { std::printf("  %s prep slot %d: per-slot state DIFFERS from per-row\n", sh.name, j); ++g_fail; }
+                    char key[96];
+                    std::snprintf(key, sizeof key, "prep_%lld_%s_s%d_%s", (long long) ctx, sh.name, j, ps ? "slot" : "row");
+                    record(key, fnv(sn.data(), sn.size()));
+                }
+                tp[ps] = time_graph(q, reps, [&] { for (int l = 0; l < L; ++l) prep_layer(c, sh, l, ps == 1); }) / L;
+            }
+            restore();
+            std::printf("  %-9s rows %d | attn us/layer: row %7.1f  slot %7.1f  one %7.1f | prep us/layer: row %5.1f slot %5.1f | launches/layer row %d slot %d one %d\n",
+                        sh.name, n, t_us[0], t_us[1], t_us[2], tp[0], tp[1], 4 * n, 4 * sh.slots, sh.slots + 3);
+            std::printf("  RESULT ctx=%lld shape=%s rows=%d attn_row=%.2f attn_slot=%.2f attn_one=%.2f prep_row=%.2f prep_slot=%.2f\n",
+                        (long long) ctx, sh.name, n, t_us[0], t_us[1], t_us[2], tp[0], tp[1]);
+        }
+        // the block scores alone for 5..8 queries of one slot (the verify shapes above reach 4 per slot)
+        for (int nq = 5; nq <= 8; ++nq) {
+            const Shape sh{"S1", 1, nq};
+            set_steps(c, sh);
+            q.memset(c.scores, 0, (size_t) c.rows_max * c.max_blocks * 4).wait();
+            const SlotLayer& x = c.at(0, 0);
+            k::qsa_block_scores(x.pooled, x.dead, c.qidx, c.steps, nq, c.max_blocks, c.s, c.scores, &q);
+            q.wait();
+            auto sc = fetch(q, c.scores, (size_t) nq * c.max_blocks);
+            char key[64];
+            std::snprintf(key, sizeof key, "scores%d_%lld", nq, (long long) ctx);
+            record(key, fnv(sc.data(), sc.size() * 4));
+        }
+        // the top-k alone on tie-heavy scores (8 distinct values): 6 queries, the C2 rows' steps
+        {
+            const Shape sh{"C2_2x3", 2, 3};
+            set_steps(c, sh);
+            const uint32_t s0 = 0x51ed27u + (uint32_t) ctx;
+            float* sc = c.scores;
+            q.parallel_for(sycl::range<1>((size_t) 6 * c.max_blocks), [=](sycl::id<1> i) {
+                sc[i] = (float) (hsh((uint32_t) i[0] ^ s0) % 8u) * 0.25f;
+            }).wait();
+            k::qsa_block_topk(c.scores, c.steps, 6, c.max_blocks, c.cap, c.s, c.sel, &q);
+            q.wait();
+            auto ids = fetch(q, c.sel, (size_t) 6 * c.cap);
+            char key[64];
+            std::snprintf(key, sizeof key, "topk_ties_%lld", (long long) ctx);
+            record(key, fnv(ids.data(), ids.size() * 4));
+            const double t1 = time_graph(q, reps, [&] { for (int l = 0; l < L; ++l) k::qsa_block_topk(c.scores, c.steps, 1, c.max_blocks, c.cap, c.s, c.sel, &q); }) / L;
+            const double t6 = time_graph(q, reps, [&] { for (int l = 0; l < L; ++l) k::qsa_block_topk(c.scores, c.steps, 6, c.max_blocks, c.cap, c.s, c.sel, &q); }) / L;
+            std::printf("  top-k (ties) us/launch: 1 query %.1f, 6 queries %.1f\n", t1, t6);
+            std::printf("  RESULT ctx=%lld topk1=%.2f topk6=%.2f\n", (long long) ctx, t1, t6);
+        }
+        // the MTP drafter's call: 1 row, 32K window = 512 chunks, ids = the window's cells
+        {
+            const int64_t capm = 32768;
+            const int64_t sfl = (int64_t) k::qsa_decode_attn_scratch_floats(capm, c.s);
+            float* scr = dalloc<float>(q, (size_t) sfl);
+            int32_t* idm = dalloc<int32_t>(q, (size_t) capm * 4);
+            int32_t* stm = dalloc<int32_t>(q, (size_t) k::kStepCount * 4);
+            float* outm = dalloc<float>(q, (size_t) 4 * c.s.n_head * c.s.head_dim);
+            const int64_t nkv = ctx + 1, W = std::min<int64_t>(nkv, capm);
+            std::vector<int32_t> hid((size_t) capm * 4, 0), hst((size_t) k::kStepCount * 4);
+            for (int u = 0; u < 4; ++u) {
+                for (int64_t i = 0; i < W; ++i) hid[(size_t) (u * capm + i)] = (int32_t) (nkv - W + i);
+                int32_t* sp = hst.data() + u * k::kStepCount;
+                sp[k::kStepPos] = (int32_t) (nkv - 1); sp[k::kStepNKv] = (int32_t) nkv;
+                sp[k::kStepNBid] = (int32_t) (nkv / c.s.idx_block); sp[k::kStepWidth] = (int32_t) W;
+            }
+            q.memcpy(idm, hid.data(), hid.size() * 4).wait();
+            q.memcpy(stm, hst.data(), hst.size() * 4).wait();
+            auto body = [&] {
+                for (int u = 0; u < 4; ++u)   // four replays' worth (C2: 2 depths x 2 owners), each on its own layer pools
+                    k::qsa_decode_attn_batch(c.qcur, c.at(u, 0).pools(), idm + (size_t) u * capm, stm + u * k::kStepCount,
+                                             capm, c.s, scr, outm + (size_t) u * c.s.n_head * c.s.head_dim, 1, &q);
+            };
+            body();
+            q.wait();
+            auto om = fetch(q, outm, (size_t) 4 * c.s.n_head * c.s.head_dim);
+            char key[64];
+            std::snprintf(key, sizeof key, "mtp_%lld", (long long) ctx);
+            record(key, fnv(om.data(), om.size() * 4));
+            const double tm = time_graph(q, reps, body) / 4;
+            std::printf("  MTP 1 row, 512 chunks, window %lld: %.1f us/call\n", (long long) W, tm);
+            std::printf("  RESULT ctx=%lld mtp_call=%.2f\n", (long long) ctx, tm);
+            sycl::free(scr, q); sycl::free(idm, q); sycl::free(stm, q); sycl::free(outm, q);
+        }
+        free_ctx(c);
+    }
+    if (!ref_path.empty() && !g_have_ref) {
+        if (FILE* f = std::fopen(ref_path.c_str(), "w")) {
+            for (auto& kv : g_out) std::fprintf(f, "%s %016llx\n", kv.first.c_str(), (unsigned long long) kv.second);
+            std::fclose(f);
+            std::printf("\nwrote %zu reference hashes to %s\n", g_out.size(), ref_path.c_str());
+        }
+    }
+    std::printf("\n%s (%d failures)\n", g_fail ? "FAIL" : "PASS", g_fail);
+    return g_fail ? 1 : 0;
+}
