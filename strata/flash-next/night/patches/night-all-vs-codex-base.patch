+std::vector<int> sizes_of(std::initializer_list<std::pair<int, int>> v) {   // {count, size} pairs
+    std::vector<int> s;
+    for (auto [c, m] : v) for (int i = 0; i < c; ++i) s.push_back(m);
+    return s;
