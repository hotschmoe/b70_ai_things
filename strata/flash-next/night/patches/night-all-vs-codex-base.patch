+        const bool e = v != nullptr && v[0] == '1' && v[1] == '\0';
+        if (e) std::fprintf(stderr, "strata night: STRATA_NIGHT_PATTN_XMX=1 (prompt QSA attention, 8-query union tiles on XMX, FP16 products)\n");
+        return e;
