+        auto* d_ctl = sycl::malloc_device<uint32_t>(64, q);   // done, flag, ctr
+        q.memset(d_ctl, 0, 256).wait();
+        uint32_t *done = d_ctl, *flag = d_ctl + 16, *ctr = d_ctl + 32;
