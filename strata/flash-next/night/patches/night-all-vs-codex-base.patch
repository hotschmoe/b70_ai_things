+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            sumi = STRATA_DP4A(a.u[j * 2], r.qx[j], sumi);
+            sumi = STRATA_DP4A(a.u[j * 2 + 1], r.qy[j], sumi);
