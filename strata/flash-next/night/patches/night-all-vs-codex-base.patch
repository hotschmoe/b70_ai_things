 double ms_since(Clock::time_point t) { return std::chrono::duration<double, std::milli>(Clock::now() - t).count(); }
 
+// Night lab 2026-10-16 (all default off; each latched once and announced on stderr when on).
+// STRATA_NIGHT_PREFILL_EARLY=1 (expert parallel, IPC path): the host waits only for the router's ids and weights, not
+//   for the whole queue; the activation push, a doorbell to card 1 and the shared expert are queued after that point,
+//   and card 1's first kernel spins on the doorbell instead of relying on the host's full drain.  Same kernels, same
+//   inputs: bitwise the same outputs.
+// STRATA_NIGHT_PREFILL_F16SUM=1 (with STRATA_EP_PREFILL_REDUCE=1): card 1's per-token peer sums cross PCIe as FP16
+//   with a per-token power-of-two scale (half the bytes); card 0's finish reads them directly.  Changes numerics
+//   (relative error <= 2^-11 per value of the peer sum).
+inline bool night_env(const char* name, const char* what) {
+    const char* e = std::getenv(name);
+    const bool on = e && e[0] == '1';
+    if (on) std::fprintf(stderr, "strata prefill: %s=1: %s (night lab)\n", name, what);
+    return on;
+}
+inline bool night_early() {
+    static const bool v = night_env("STRATA_NIGHT_PREFILL_EARLY",
+                                    "card 1 starts on a doorbell after the activation push; the shared expert runs after the host's routing wait");
+    return v;
+}
+// STRATA_NIGHT_PREFILL_GROUPED=1 (expert parallel, card 1, implies STRATA_EP_PREFILL_GATHER_ALIAS's one gather): card 1's
+//   experts with <= STRATA_NIGHT_PREFILL_GROUPED_MAX rows (default 64) go first in its row order and run through
+//   night_grouped_f16 (IQ decode + joint_matrix in one launch per projection and row-tile size), a single SwiGLU per
+//   batch; the larger ones keep dequant + oneMKL.  FP32 accumulation order changes (rounding level).
+// STRATA_NIGHT_PREFILL_HALVES=1 (expert parallel, IPC, STRATA_EP_PREFILL_REDUCE=1): see layer_step in run_impl.
+inline bool night_halves() {
+    static const bool v = night_env("STRATA_NIGHT_PREFILL_HALVES",
+                                    "each chunk runs as two halves interleaved per layer (the two cards overlap)");
+    return v;
+}
+inline bool night_grouped() {
+    static const bool v = night_env("STRATA_NIGHT_PREFILL_GROUPED",
+                                    "card 1's small experts run through one grouped decode + XMX launch per projection");
+    return v;
+}
+// STRATA_NIGHT_PREFILL_GROUPED_CARDS: 3 both (default), 1 card 1 only, 2 card 0 only (narrowing)
+inline int night_grouped_cards() {
+    static const int v = [] { const char* e = std::getenv("STRATA_NIGHT_PREFILL_GROUPED_CARDS"); return e ? std::atoi(e) : 3; }();
+    return v;
+}
+// STRATA_NIGHT_PREFILL_GROUPED_CHECK=1 (debug, slow: host syncs): every layer, the grouped small experts are computed
+// again on the per-expert reference path and compared; one stderr line per layer and card
+inline bool night_grouped_check() {
+    static const bool v = [] {
