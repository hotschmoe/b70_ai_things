+    int32_t* ulist = nullptr;
+    int32_t* ucount = nullptr;
+    sycl::half* gstage = nullptr;
+    int64_t cap = 0;
+};
+std::vector<Scratch>& scratches() { static std::vector<Scratch> v; return v; }
