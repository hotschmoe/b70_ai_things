+    T* p = sycl::malloc_device<T>(n + 64, q);
+    if (!p) { std::fprintf(stderr, "malloc_device failed (%zu)\n", n); std::exit(2); }
+    q.memset(p, 0, (n + 64) * sizeof(T)).wait();
+    return p;
+}
