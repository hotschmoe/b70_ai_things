+    const AttnMultiPools mpv = mp;
+    st->parallel_for<attn_chunk_multi_night<M, VP>>(
+        sycl::nd_range<3>(groups * sycl::range<3>(1, 1, THREADS), sycl::range<3>(1, 1, THREADS)), exp_props,
