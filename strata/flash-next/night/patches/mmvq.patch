+// ---------------------------------------------------------------- night: STRATA_NIGHT_MMVQ=1 (KREG), default OFF
+//
+// K split across the work-group, activations in registers. Lane l of a group owns 32 weights of every row (8 lanes per
+// 256-block, block l / 8, position group g = l % 8: the wide kernels' per-lane split) and loads its NCOLS activation
+// pieces ONCE (plus, for Q4_K/Q5_K, the min term's activation sums). The group then streams tiles of R rows: R
+// independent weight loads per lane, R x NCOLS dots, a transposed sub-group butterfly (each SIMD16 lane ends with
+// R*NCOLS/16 finished sums) and a double-buffered SLM sum across the sub-groups (one SLM-only barrier per tile).
+// The wide kernels re-read every column's activations per row (6 columns: ~10x the weight bytes in L1 loads, issued
+// one at a time through one register block) and are issue-bound at 4-6 columns. Summation order differs from the
+// wide kernels (FP32 rounding-level differences, not bitwise). Q4_K/Q5_K need a 16-byte aligned matrix (as WideQ4K).
+constexpr int NIGHT_SG = 16;
+inline bool night_mmvq() {
+    static const bool v = [] {
+        const char* e = std::getenv("STRATA_NIGHT_MMVQ");
+        const bool on = e && e[0] == '1';
+        if (on) std::fprintf(stderr, "strata night mmvq: enabled=1 KREG Q4_K/Q5_K/Q6_K/IQ4_XS ncols 1-8 (head included)\n");
+        return on;
+    }();
+    return v;
+}
+// STRATA_NIGHT_MMVQ2=1 (implies STRATA_NIGHT_MMVQ=1): round 2 - software-pipelined persistent KREG at 5-12 columns,
+// ncols 9-16 (direct up to 12 where measured, else two calls of <= 8 columns), IQ3_S / IQ4_NL / Q8_0 where added.
+inline bool night_mmvq2() {
+    static const bool v = [] {
+        const char* e = std::getenv("STRATA_NIGHT_MMVQ2");
+        const bool on = e && e[0] == '1';
+        if (on) std::fprintf(stderr, "strata night mmvq2: enabled=1 pipelined KREG nc5-12, ncols 9-16, IQ3_S, IQ4_NL (implies STRATA_NIGHT_MMVQ=1)\n");
+        return on;
+    }();
+    return v;
+}
+int g_night_mmvq_override = -1;   // bench toggle (native_mmvq_set_night): -1 = the env latches, 0 off, 1 round 1, 2 round 1+2
+inline int night_level() {
+    if (g_night_mmvq_override >= 0) return g_night_mmvq_override;
+    return night_mmvq2() ? 2 : night_mmvq() ? 1 : 0;
+}
+inline bool night_mmvq_on() { return night_level() >= 1; }
+inline bool night_mmvq2_on() { return night_level() >= 2; }
+// night A/B: STRATA_NIGHT_MMVQ2_MASK bit0 pipelined/9-16 col KREG, bit1 IQ3_S, bit2 IQ4_NL (default all)
+inline int night_mmvq2_mask() {
+    static const int m = [] { const char* e = std::getenv("STRATA_NIGHT_MMVQ2_MASK"); return e ? std::atoi(e) : 7; }();
+    return m;
+}
+
+template <int O, int N, int P>
+__dpct_inline__ void night_tsum(float (&v)[P], const sycl::sub_group& sg, int lane) {
+    if constexpr (O > 0) {
+        constexpr int H = N / 2;
+        const bool up = (lane & O) != 0;
+#pragma unroll
+        for (int i = 0; i < H; ++i) {
+            const float lo = v[i], hi = v[i + H];   // values: a ?: of two array lvalues selects ADDRESSES and
+            const float send = up ? lo : hi;        // sends v[] to private (global) memory
+            const float keep = up ? hi : lo;
+            v[i] = keep + sycl::permute_group_by_xor(sg, send, O);
+        }
+        night_tsum<O / 2, H, P>(v, sg, lane);
+    }
+}
