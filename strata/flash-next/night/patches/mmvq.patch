+        for (auto& v : h) { const float f = urand() * 0.05f; uint32_t b; std::memcpy(&b, &f, 4); v = (uint16_t) (b >> 16); }
+        q.memcpy(wp, h.data(), POOL).wait();
+    }
+    float* x = sycl::malloc_device<float>((size_t) 8 * 2560, q);
+    {
+        std::vector<float> h((size_t) 8 * 2560);
