[Unit]
Description=hotschmoe-dd API-key frontdoor 0.0.0.0:18080 -> 127.0.0.1:18124

[Service]
Type=simple
WorkingDirectory=/mnt/vm_8tb/github/b70_ai_things
Environment=FRONTDOOR_HOST=0.0.0.0
Environment=FRONTDOOR_PORT=18080
Environment=FRONTDOOR_BACKEND_URL=http://127.0.0.1:18124
Environment=FRONTDOOR_API_KEY_FILE=/mnt/vm_8tb/b70/secrets/dd_api_key
ExecStart=/usr/bin/python3 /mnt/vm_8tb/github/b70_ai_things/vllm/fp8/openai_key_frontdoor.py
Restart=always
RestartSec=5
StandardOutput=append:/mnt/vm_8tb/b70/logs/hotschmoe-dd/frontdoor.log
StandardError=append:/mnt/vm_8tb/b70/logs/hotschmoe-dd/frontdoor.log

[Install]
WantedBy=default.target
