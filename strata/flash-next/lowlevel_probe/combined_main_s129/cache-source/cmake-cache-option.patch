--- a/sycl/CMakeLists.txt
+++ b/sycl/CMakeLists.txt
@@ -45,8 +45,13 @@
 if(STRATA_SYCL_AOT)
   list(APPEND _sycl_flags -fsycl-targets=spir64_gen)
   # the divide/sqrt rounding option (below) must reach ocloc here: an AOT build has no spir64 backend to take it
+  set(STRATA_SYCL_AOT_CACHE_DIR "" CACHE PATH "Optional pre-existing ocloc offline cache directory")
+  set(_sycl_cache_flags "")
+  if(STRATA_SYCL_AOT_CACHE_DIR)
+    set(_sycl_cache_flags " -allow_caching -cache_dir ${STRATA_SYCL_AOT_CACHE_DIR}")
+  endif()
   set(_sycl_link -fsycl -fsycl-targets=spir64_gen -Xsycl-target-backend=spir64_gen
-      "-device ${STRATA_SYCL_AOT} -options -cl-fp32-correctly-rounded-divide-sqrt")
+      "-device ${STRATA_SYCL_AOT} -options -cl-fp32-correctly-rounded-divide-sqrt${_sycl_cache_flags}")
 else()
   set(_sycl_link -fsycl)
 endif()
