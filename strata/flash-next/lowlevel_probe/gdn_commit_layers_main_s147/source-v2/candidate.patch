+        });
+    q->parallel_for<class gdn_state_commit_layers_s147>(
+        sycl::nd_range<3>(sycl::range<3>(36, 4, 48) * sycl::range<3>(1, RG, 32), sycl::range<3>(1, RG, 32)),
+        [=](sycl::nd_item<3> item) {
+            const int64_t l = item.get_group(0);
