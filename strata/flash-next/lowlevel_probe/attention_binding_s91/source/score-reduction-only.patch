+// S91 private score-only reduce-scatter: same XOR16/8/4/2/1 pair tree per head.
+__dpct_inline__ float score_reduce12(const float (&part)[16], int lane) {
+    const auto sg = sycl::ext::oneapi::this_work_item::get_sub_group();
+    float r8[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const bool hi = (lane & 16) != 0;
+        r8[i] = (hi ? part[i + 8] : part[i]) + dpct::experimental::permute_sub_group_by_xor(
+            0xffffffffu, sg, hi ? part[i] : part[i + 8], 16);
+    }
+    float r4[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const bool hi = (lane & 8) != 0;
+        r4[i] = (hi ? r8[i + 4] : r8[i]) + dpct::experimental::permute_sub_group_by_xor(
+            0xffffffffu, sg, hi ? r8[i] : r8[i + 4], 8);
+    }
+    float r2[2];
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        const bool hi = (lane & 4) != 0;
+        r2[i] = (hi ? r4[i + 2] : r4[i]) + dpct::experimental::permute_sub_group_by_xor(
+            0xffffffffu, sg, hi ? r4[i] : r4[i + 2], 4);
+    }
+    const bool hi2 = (lane & 2) != 0;
+    const float r1 = (hi2 ? r2[1] : r2[0]) + dpct::experimental::permute_sub_group_by_xor(
+        0xffffffffu, sg, hi2 ? r2[0] : r2[1], 2);
+    return r1 + dpct::experimental::permute_sub_group_by_xor(0xffffffffu, sg, r1, 1);
+}
+__dpct_inline__ int score_head_of_lane(int lane) {
+    return ((lane >> 4) & 1) * 8 + ((lane >> 3) & 1) * 4 +
+           ((lane >> 2) & 1) * 2 + ((lane >> 1) & 1);
 }
 
