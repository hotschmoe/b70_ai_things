# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=b70-sglang-xpu:20260826-bede6bc-2d10888-torch213-umd2622
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

ARG VLLM_XPU_KERNELS_COMMIT=2dd55f380df753a10a88fcd9e96192561066e713
ARG VLLM_XPU_KERNELS_TREE=2416da2ad02ff58717edb864fa839442a15ca3d2
ARG VLLM_XPU_KERNELS_PATCHED_TREE
ARG BUILD_JOBS=8

LABEL org.opencontainers.image.title="B70 SGLang XPU native INT8 arm"
LABEL b70.parent.image="sha256:8678399dce536377f67760868b166744eb149ff9146e344476bb124e0c5933cd"
LABEL b70.vllm-xpu-kernels.commit="${VLLM_XPU_KERNELS_COMMIT}"
LABEL b70.vllm-xpu-kernels.tree="${VLLM_XPU_KERNELS_TREE}"
LABEL b70.vllm-xpu-kernels.patched-tree="${VLLM_XPU_KERNELS_PATCHED_TREE}"
LABEL b70.vllm-xpu-kernels.profile="xpu-specific-plus-int8-w8a16"

COPY --from=vllm-xpu-kernels . /src/vllm-xpu-kernels

RUN test "$(git -C /src/vllm-xpu-kernels rev-parse HEAD)" = \
        "${VLLM_XPU_KERNELS_COMMIT}" && \
    test "$(git -C /src/vllm-xpu-kernels rev-parse HEAD^{tree})" = \
        "${VLLM_XPU_KERNELS_TREE}" && \
    test "$(git -C /src/vllm-xpu-kernels write-tree)" = \
        "${VLLM_XPU_KERNELS_PATCHED_TREE}" && \
    git -C /src/vllm-xpu-kernels diff --cached --check

# Build only the extension that owns the native XPU INT8 quantizer and oneDNN
# W8A8 GEMM. Every unrelated extension family is disabled for this arm.
RUN python -m pip install --no-cache-dir setuptools==79.0.1 && \
    set +u && \
    source /opt/intel/oneapi/setvars.sh --force && \
    set -u && \
    MAX_JOBS="${BUILD_JOBS}" \
    CMAKE_BUILD_PARALLEL_LEVEL="${BUILD_JOBS}" \
    VLLM_VERSION_OVERRIDE=0.0.0+b70.2dd55f3.w8a16 \
    BUILD_SYCL_TLA_KERNELS=OFF \
    VLLM_XPU_ENABLE_XE2=OFF \
    VLLM_XPU_ENABLE_XE_DEFAULT=OFF \
    BASIC_KERNELS_ENABLED=OFF \
    FA2_KERNELS_ENABLED=OFF \
    MOE_KERNELS_ENABLED=OFF \
    GDN_KERNELS_ENABLED=OFF \
    MQA_LOGITS_KERNELS_ENABLED=OFF \
    XPU_SPECIFIC_KERNELS_ENABLED=ON \
    XPUMEM_ALLOCATOR_ENABLED=OFF \
    python -m pip wheel --no-build-isolation --no-deps \
        --wheel-dir /opt/wheels /src/vllm-xpu-kernels && \
    python -m pip install --no-cache-dir --no-deps \
        /opt/wheels/vllm_xpu_kernels-0.0.0+b70.2dd55f3.w8a16-*.whl

RUN python - <<'PY'
import importlib
import importlib.metadata
import torch

importlib.import_module("vllm_xpu_kernels._xpu_C")

expected = {
    "int8_gemm_w8a8": (
        "_xpu_C::int8_gemm_w8a8(Tensor A, Tensor A_scale, Tensor B, "
        "Tensor B_scale, ScalarType? out_dtype, Tensor? bias) -> Tensor"
    ),
    "int8_gemm_w8a16": (
        "_xpu_C::int8_gemm_w8a16(Tensor A, Tensor B, Tensor B_scale, "
        "Tensor? bias) -> Tensor"
    ),
    "per_token_quant_int8_xpu": (
        "_xpu_C::per_token_quant_int8_xpu(Tensor x) -> (Tensor, Tensor)"
    ),
}
for op, schema in expected.items():
    actual = str(torch._C._dispatch_find_schema_or_throw(f"_xpu_C::{op}", "").schema())
    if actual != schema:
        raise RuntimeError(f"unexpected {op} schema: {actual}")
    print(actual)

print("vllm-xpu-kernels", importlib.metadata.version("vllm-xpu-kernels"))
PY

RUN python -m pip check && \
    sha256sum /opt/wheels/vllm_xpu_kernels-*.whl \
        > /opt/b70-build-manifest/vllm-xpu-kernels-wheel-sha256.txt
