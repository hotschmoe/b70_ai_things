--- /dev/null
+++ b/kernels/ops/memory/ptr_table.py
@@ -0,0 +1,6 @@
+"""Build XPU device-pointer tables without signed integer unpack overflow."""
+import torch
+
+
+def make_ptr_table(rows, device):
+    return torch.tensor(rows, dtype=torch.uint64, device=device).view(torch.int64)
